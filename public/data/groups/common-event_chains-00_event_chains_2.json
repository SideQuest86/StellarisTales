fx/event_pictures/fleet_evil.dds","sprite":"GFX_evt_fleet_evil","sha256":"181712172bc63128316e64eb6cde831b56edfa94ac505f6a157f1ce16aee542e"},"pictureKeys":["GFX_evt_fleet_evil"],"hidden":false,"trigger":"","script":"clouds_1_chain = {\n\tpicture = GFX_evt_fleet_evil\n\ticon = \"gfx/interface/icons/situation_log/situation_log_tick.dds\"\n\tcounter = {\n\t\tstardust_sifted = {\n\t\t\tmax = 1\n\t\t}\n\t}\n}"},{"id":"event_chains:ransomeer_chain","eventId":"ransomeer_chain","kind":"event_chains","group":"common-event_chains-00_event_chains_2","source":"common/event_chains/00_event_chains_2.txt","line":127,"lineSpace":"original","inlineSources":[],"titles":[{"key":"ransomeer_chain_title","zh":"星际绑架者","en":"The Ransomeers","sources":{"zh":"localisation/simp_chinese/events_2_l_simp_chinese.yml","en":"localisation/english/events_2_l_english.yml"},"condition":""}],"descriptions":[{"key":"ransomeer_chain_desc","zh":"一群自称为“星际绑架者”的海盗关押了[Root.GetSpeciesAdj]私人运输飞船的船员。\n\n我们想在海盗们提出条件之前就救出他们。","en":"A band of pirates calling themselves the \"Ransomeers\" have kidnapped the crew of a [Root.GetSpeciesAdj] private transport vessel.\n\nWe intend to free them before the pirates can make any demands.","sources":{"zh":"localisation/simp_chinese/events_2_l_simp_chinese.yml","en":"localisation/english/events_2_l_english.yml"},"condition":""}],"sections":[],"options":[],"links":[],"picture":{"url":"art/63443e0eb8c0cdaa06bc.webp","source":"gfx/event_pictures/space_station.dds","sprite":"GFX_evt_space_station","sha256":"63443e0eb8c0cdaa06bc129c3d0059e59ca90a4e63f33fe0ccf87131ab5fece0"},"pictureKeys":["GFX_evt_space_station"],"hidden":false,"trigger":"","script":"ransomeer_chain = {\n\tpicture = GFX_evt_space_station\n\ticon = \"gfx/interface/icons/situation_log/situation_log_quest.dds\"\n\tcounter = {\n\t\tcaptive_crew_rescued = {\n\t\t\tmax = 1\n\t\t}\n\t}\n\tsituation_log_category = anomalies\n}"},{"id":"event_chains:mineral_planet_chain","eventId":"mineral_planet_chain","kind":"event_chains","group":"common-event_chains-00_event_chains_2","source":"common/event_chains/00_event_chains_2.txt","line":138,"lineSpace":"original","inlineSources":[],"titles":[{"key":"mineral_planet_chain_title","zh":"高价值矿产目标","en":"High-Value Mining Targets","sources":{"zh":"localisation/simp_chinese/events_2_l_simp_chinese.yml","en":"localisation/english/events_2_l_english.yml"},"condition":""}],"descriptions":[{"key":"mineral_planet_chain_desc","zh":"使用古代采矿无人机的评估系统中的技术，我们定位了一些矿产资源丰富的天体。","en":"Using techniques derived from the Ancient Mining Drones' assessment systems, we have pin-pointed a handful of stellar bodies that are likely to be particularly rich in minerals.","sources":{"zh":"localisation/simp_chinese/events_2_l_simp_chinese.yml","en":"localisation/english/events_2_l_english.yml"},"condition":""}],"sections":[],"options":[],"links":[],"picture":{"url":"art/24f9fed594311a2f11f2.webp","source":"gfx/event_pictures/mining_station.dds","sprite":"GFX_evt_mining_station","sha256":"24f9fed594311a2f11f24461596f861197f8b3772542ff93208b88b14f44a9fc"},"pictureKeys":["GFX_evt_mining_station"],"hidden":false,"trigger":"","script":"mineral_planet_chain = {\n\tpicture = GFX_evt_mining_station\n\ticon = \"gfx/interface/icons/situation_log/situation_log_quest.dds\"\n\tcounter = {\n\t\tsystems_visited = {\n\t\t\tmax = 5\n\t\t}\n\t}\n}"},{"id":"event_chains:cloud_chain","eventId":"cloud_chain","kind":"event_chains","group":"common-event_chains-00_event_chains_2","source":"common/event_chains/00_event_chains_2.txt","line":148,"lineSpace":"original","inlineSources":[],"titles":[{"key":"cloud_chain_title","zh":"流云","en":"Drifting Clouds","sources":{"zh":"localisation/simp_chinese/events_2_l_simp_chinese.yml","en":"localisation/english/events_2_l_english.yml"},"condition":""}],"descriptions":[{"key":"cloud_chain_desc","zh":"所有的虚空之云在量子层面上都是相连的；这些散发能源的个体样本很可能就是一个单独的亚空间实体的多个表示形式。\n\n对一个虚空之云进行了仔细研究之后，我们找到了其他可能富含这些云的星系。","en":"All Void Clouds are entangled with one another on the quantum level; it is possible that the energies animating the individual specimens are nothing but multiple instances of a singular sub-space entity.\n\nThrough careful study of one Void Cloud, we have been able to locate a number of systems that are likely to house other Clouds.","sources":{"zh":"localisation/simp_chinese/events_2_l_simp_chinese.yml","en":"localisation/english/events_2_l_english.yml"},"condition":""}],"sections":[],"options":[],"links":[],"picture":{"url":"art/8f074413f235d7238af7.webp","source":"gfx/event_pictures/black_hole.dds","sprite":"GFX_evt_black_hole","sha256":"8f074413f235d7238af75f02ee471b0816327048e0404ae7909662f5a726537c"},"pictureKeys":["GFX_evt_black_hole"],"hidden":false,"trigger":"","script":"cloud_chain = {\n\tpicture = GFX_evt_black_hole\n\ticon = \"gfx/interface/icons/situation_log/situation_log_quest.dds\"\n\tcounter = {\n\t\tclouds_watched = {\n\t\t\tmax = 5\n\t\t}\n\t}\n}"},{"id":"event_chains:holy_war","eventId":"holy_war","kind":"event_chains","group":"common-event_chains-00_event_chains_2","source":"common/event_chains/00_event_chains_2.txt","line":158,"lineSpace":"original","inlineSources":[],"titles":[{"key":"holy_war_title","zh":"圣战","en":"Holy War","sources":{"zh":"localisation/simp_chinese/pop_factions_l_simp_chinese.yml","en":"localisation/english/pop_factions_l_english.yml"},"condition":""}],"descriptions":[{"key":"holy_war_desc","zh":"领导太空时代的十字军对抗[parameter:heathens.GetName]。","en":"Lead a crusade against the [parameter:heathens.GetName].","sources":{"zh":"localisation/simp_chinese/pop_factions_l_simp_chinese.yml","en":"localisation/english/pop_factions_l_english.yml"},"condition":""}],"sections":[],"options":[],"links":[],"picture":{"url":"art/2173e01a411ccd36e66e.webp","source":"gfx/event_pictures/federation_fleet.dds","sprite":"GFX_evt_federation_fleet","sha256":"2173e01a411ccd36e66e32a3adabc53dccb8afa8abaca6f7e1eb4902b4c4b396"},"pictureKeys":["GFX_evt_federation_fleet"],"hidden":false,"trigger":"","script":"holy_war = {\n\tpicture = GFX_evt_federation_fleet\n\ticon = \"gfx/interface/icons/situation_log/situation_log_main_quest.dds\"\n\tcounter = {\n\t\tprofane_planets_seized = {\n\t\t\tmax = 1\n\t\t}\n\t}\n}"},{"id":"event_chains:wrecked_fleet_chain","eventId":"wrecked_fleet_chain","kind":"event_chains","group":"common-event_chains-00_event_chains_2","source":"common/event_chains/00_event_chains_2.txt","line":168,"lineSpace":"original","inlineSources":[],"titles":[{"key":"wrecked_fleet_chain_title","zh":"漂流的战场","en":"Drifting Battlefield","sources":{"zh":"localisation/simp_chinese/events_2_l_simp_chinese.yml","en":"localisation/english/events_2_l_english.yml"},"condition":""}],"descriptions":[{"key":"wrecked_fleet_chain_desc","zh":"千年之前，某舰队里的成员背弃了盟约，将枪口对准了彼此。在知己知彼的情况下，盟友的飞船顷刻之间就被消灭了，只留下了失去压力的飞船外壳。\n\n我们收集了足够的信息，可以对这些舰队残骸在宇宙中缓慢漂移的过程进行建模。","en":"Millennia ago, treachery saw a fleet of allied ships turn on each other. With swift strikes to critical systems and known weak points in the hull designs, the formerly allied crews were wiped out with ruthless efficiency, supposedly leaving the depressurized hulks of the ships largely intact.\n\nWe have gleaned enough information to model this ship graveyard's slow drift through the cosmos.","sources":{"zh":"localisation/simp_chinese/events_2_l_simp_chinese.yml","en":"localisation/english/events_2_l_english.yml"},"condition":""}],"sections":[],"options":[],"links":[],"picture":{"url":"art/2173e01a411ccd36e66e.webp","source":"gfx/event_pictures/federation_fleet.dds","sprite":"GFX_evt_federation_fleet","sha256":"2173e01a411ccd36e66e32a3adabc53dccb8afa8abaca6f7e1eb4902b4c4b396"},"pictureKeys":["GFX_evt_federation_fleet"],"hidden":false,"trigger":"","script":"wrecked_fleet_chain = {\n\tpicture = GFX_evt_federation_fleet\n\ticon = \"gfx/interface/icons/situation_log/situation_log_quest.dds\"\n\tcounter = {\n\t\tbattlefield_located = {\n\t\t\tmax = 1\n\t\t}\n\t}\n\tsituation_log_category = anomalies\n}"}]