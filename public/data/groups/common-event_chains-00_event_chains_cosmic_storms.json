[{"id":"event_chains:cs_inetian_chain","eventId":"cs_inetian_chain","kind":"event_chains","group":"common-event_chains-00_event_chains_cosmic_storms","source":"common/event_chains/00_event_chains_cosmic_storms.txt","line":7,"lineSpace":"original","inlineSources":[],"titles":[{"key":"cs_inetian_chain_title","zh":"先驱者——因内特贸易体","en":"Precursors - The Inetian Traders","sources":{"zh":"localisation/simp_chinese/cosmic_storms_l_simp_chinese.yml","en":"localisation/english/cosmic_storms_l_english.yml"},"condition":""}],"descriptions":[{"key":"cs_inetian_chain_desc","zh":"我们发现了一座远古庇护所的残骸，它属于一个兴盛于数百万年前的不存在于我们任何记录中的文明，仿佛就像被精心地从历史中抹除了一般。如果进行调查，也许就能搞明白个中缘由。","en":"We have found the remnants of an ancient shelter, belonging to an civilization that thrived millions of years ago - a civilization that appears nowhere else in our records, as if it was meticulously scrubbed from history. If we investigate, we might be able to find out why.","sources":{"zh":"localisation/simp_chinese/cosmic_storms_l_simp_chinese.yml","en":"localisation/english/cosmic_storms_l_english.yml"},"condition":""}],"sections":[],"options":[],"links":[],"picture":{"url":"art/f4deb2451c167a23c33a.webp","source":"gfx/event_pictures/cosmic_storms_broadcast_hacking.dds","sprite":"GFX_evt_cosmic_storms_broadcast_hacking","sha256":"f4deb2451c167a23c33a1a060f0a09563031422fa40269230ce59256494775d5"},"pictureKeys":["GFX_evt_cosmic_storms_broadcast_hacking"],"hidden":false,"trigger":"","script":"cs_inetian_chain = {\n\ticon = \"gfx/interface/icons/situation_log/situation_log_quest.dds\"\n\tpicture = GFX_evt_cosmic_storms_broadcast_hacking\n\tsituation_log_category = precursors\n}"},{"id":"event_chains:cs_adAkkaria_chain","eventId":"cs_adAkkaria_chain","kind":"event_chains","group":"common-event_chains-00_event_chains_cosmic_storms","source":"common/event_chains/00_event_chains_cosmic_storms.txt","line":13,"lineSpace":"original","inlineSources":[],"titles":[{"key":"cs_adAkkaria_chain_title","zh":"先驱者——阿达卡利亚","en":"Precursors - The adAkkaria","sources":{"zh":"localisation/simp_chinese/cosmic_storms_l_simp_chinese.yml","en":"localisation/english/cosmic_storms_l_english.yml"},"condition":""}],"descriptions":[{"key":"cs_adAkkaria_chain_desc","zh":"我们需要跟随一条线索去揭开关于这个怪异古老文明的终极命运的秘密，无论这条线索通向何方。","en":"To understand the fate of this strange and ancient civilization, we must follow a string of clues. Wherever they may lead.","sources":{"zh":"localisation/simp_chinese/cosmic_storms_l_simp_chinese.yml","en":"localisation/english/cosmic_storms_l_english.yml"},"condition":""}],"sections":[],"options":[],"links":[],"picture":{"url":"art/f4deb2451c167a23c33a.webp","source":"gfx/event_pictures/cosmic_storms_broadcast_hacking.dds","sprite":"GFX_evt_cosmic_storms_broadcast_hacking","sha256":"f4deb2451c167a23c33a1a060f0a09563031422fa40269230ce59256494775d5"},"pictureKeys":["GFX_evt_cosmic_storms_broadcast_hacking"],"hidden":false,"trigger":"","script":"cs_adAkkaria_chain = {\n\ticon = \"gfx/interface/icons/situation_log/situation_log_quest.dds\"\n\tpicture = GFX_evt_cosmic_storms_broadcast_hacking\n\tsituation_log_category = precursors\n}"},{"id":"event_chains:cs_stormfever_chain","eventId":"cs_stormfever_chain","kind":"event_chains","group":"common-event_chains-00_event_chains_cosmic_storms","source":"common/event_chains/00_event_chains_cosmic_storms.txt","line":21,"lineSpace":"original","inlineSources":[],"titles":[{"key":"cs_stormfever_chain_title","zh":"风暴狂热","en":"Storm Fever","sources":{"zh":"localisation/simp_chinese/cosmic_storms_l_simp_chinese.yml","en":"localisation/english/cosmic_storms_l_english.yml"},"condition":""}],"descriptions":[{"key":"cs_stormfever_chain_desc","zh":"为了再创新高，感受欢愉以及挑战我们的极限，我们现在开始一系列试炼。欢乐时间到！","en":"To reach new heights, to know joy and to test our limits, we now embark on a series of trials. Let the fun begin!","sources":{"zh":"localisation/simp_chinese/cosmic_storms_l_simp_chinese.yml","en":"localisation/english/cosmic_storms_l_english.yml"},"condition":""}],"sections"