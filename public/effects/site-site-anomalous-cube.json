rce":"events/strange_worlds_events.txt:3395"}]]},"action.94":{"choices":[[{"kind":"if","label":{"zh":"如果：持有「稀有水晶」超过 0","en":"If: holds \"Rare Crystals\" more than 0"},"effects":[{"kind":"tooltip","label":{"zh":"稀有水晶\n这些水晶拥有独特的属性，非常适合用来凝聚和集中激光束，同时也是制作大部分高级电子器材的关键材料。部分文化也视之为装饰物。","en":"Rare Crystals\nThese crystals have properties that make them extremely effective at focusing laser beams, and they are also a critical component in most advanced electronics. In addition, many cultures treasure them as decorations and adornments."},"key":"action.92.rare_crystals.tooltip","gameText":true,"target":{"zh":"事件来源方","en":"the event source"},"hidden":true,"source":"events/on_action_events_1.txt:8302"}],"when":{"zh":"持有「稀有水晶」超过 0","en":"holds \"Rare Crystals\" more than 0","detail":["has_resource > {...}"]},"conditional":true,"target":{"zh":"事件来源方","en":"the event source"},"hidden":true,"source":"events/on_action_events_1.txt:8300"},{"kind":"if","label":{"zh":"如果：持有「异星天然气」超过 0","en":"If: holds \"Exotic Gases\" more than 0"},"effects":[{"kind":"tooltip","label":{"zh":"异星天然气\n罕见的异星天然气拥有各种用途，主要是用来为高级能量武器和能量力场提供能源。部分也用作舰船燃料或消遣性毒品。","en":"Exotic Gases\nRare and exotic gases with a variety of different uses, particularly in the operation of advanced energy-based weaponry and force fields. Some of the gases can also be used as starship fuel or even as recreational drugs."},"key":"action.92.exotic_gases.tooltip","gameText":true,"target":{"zh":"事件来源方","en":"the event source"},"hidden":true,"source":"events/on_action_events_1.txt:8306"}],"when":{"zh":"持有「异星天然气」超过 0","en":"holds \"Exotic Gases\" more than 0","detail":["has_resource > {...}"]},"conditional":true,"target":{"zh":"事件来源方","en":"the event source"},"hidden":true,"source":"events/on_action_events_1.txt:8304"},{"kind":"if","label":{"zh":"如果：持有「易爆微粒」超过 0","en":"If: holds \"Volatile Motes\" more than 0"},"effects":[{"kind":"tooltip","label":{"zh":"易爆微粒\n这些超自然粒子蕴含有惊人的能量，可以被精炼为能源或者用作燃料和炸药。","en":"Volatile Motes\nThese preternatural particles contain a tremendous amount of energy which could be exploited in energy production, as fuel or even as explosives."},"key":"action.92.volatile_motes.tooltip","gameText":true,"target":{"zh":"事件来源方","en":"the event source"},"hidden":true,"source":"events/on_action_events_1.txt:8310"}],"when":{"zh":"持有「易爆微粒」超过 0","en":"holds \"Volatile Motes\" more than 0","detail":["has_resource > {...}"]},"conditional":true,"target":{"zh":"事件来源方","en":"the event source"},"hidden":true,"source":"events/on_action_events_1.txt:8308"},{"kind":"if","label":{"zh":"如果：持有「泽珞」超过 0","en":"If: holds \"Zro\" more than 0"},"effects":[{"kind":"tooltip","label":{"zh":"泽珞\n一种在异星粒子中存在的极其稀有的气溶胶，随着陨石撞击被一起发现。不过其真正的来源依然是个未解之谜。若拥有灵能天赋的[GetIndividualNamePlural]将泽珞[GetIngestedLoc]后，它会是一种能极大的提高灵能力量（并可能导致成瘾）的[GetDrugLoc]。","en":"Zro\nAn extremely rare aerosol of exotic particles. It has been deposited on a number of worlds through meteor impacts, but its true origin is a mystery. If [GetIngestedLoc] by psionically-gifted [GetIndividualNamePlural], zro acts as a very potent (and addictive) [GetDrugLoc] that enhances psionic abilities."},"key":"action.92.zro.tooltip","gameText":true,"target":{"zh":"事件来源方","en":"the event source"},"hidden":true,"source":"events/on_action_events_1.txt:8314"}],"when":{"zh":"持有「泽珞」超过 0","en":"holds \"Zro\" more than 0","detail":["has_resource > {...}"]},"conditional":true,"target":{"zh":"事件来源方","en":"the event source"},"hidden":true,"source":"events/on_action_events_1.txt:8312"},{"kind":"if","label":{"zh":"如果：持有「暗物质」超过 0","en":"If: holds \"Dark Matter\" more than 0"},"effects":[{"kind":"tooltip","label":{"zh":"暗物质\n这种神秘物质具有许多似乎可以打破所谓自然法则的性质。该物质仅在黑洞周围或部分星云附近才能达到可供开采的浓度。","en":"Dark Matter\nThis exotic substance has many properties that seemingly defy several natural laws. Harvestable concentrations can only be found near Black Holes or in certain nebulas."},"key":"action.92.dark_matter.tooltip","gameText":true,"target":{"zh":"事件来源方","en":"the event source"},"hidden":true,"source":"events/on_action_events_1.txt:8318"}],"when":{"zh":"持有「暗物质」超过 0","en":"holds \"Dark Matter\" more than 0","detail":["has_resource > {...}"]},"conditional":true,"target":{"zh":"事件来源方","en":"the event source"},"hidden":true,"source":"events/on_action_events_1.txt:8316"},{"kind":"if","label":{"zh":"如果：持有「活体金属」超过 0","en":"If: holds \"Living Metal\" more than 0"},"effects":[{"kind":"tooltip","label":{"zh":"活体金属\n该无机金属有着通常生命体才具备的特征。会自动恢复到其被塑造好的形态。","en":"Living Metal\nThis inorganic metal shows characteristics usually seen only in biological life forms. It will always attempt to regenerate back into the shape it was stabilized into."},"key":"action.92.living_metal.tooltip","gameText":true,"target":{"zh":"事件来源方","en":"the event source"},"hidden":true,"source":"events/on_action_events_1.txt:8322"}],"when":{"zh":"持有「活体金属」超过 0","en":"holds \"Living Metal\" more than 0","detail":["has_resource > {...}"]},"conditional":true,"target":{"zh":"事件来源方","en":"the event source"},"hidden":true,"source":"events/on_action_events_1.txt:8320"},{"kind":"if","label":{"zh":"如果：持有「星界丝缕」超过 0","en":"If: holds \"Astral Threads\" more than 0"},"effects":[{"kind":"tooltip","label":{"zh":"星界丝缕\n星界丝缕是一种时空浓缩而来的细丝，是不同维度位面互相碰撞的产物。可以用来产生各种全国范围的效果。","en":"Astral Threads\n Astral Threads are filaments of condensed space-time: the result of dimensional planes colliding with one another. They can be spent to enact various empire-wide effects."},"key":"action.92.astral_threads.tooltip","gameText":true,"target":{"zh":"事件来源方","en":"the event source"},"hidden":true,"source":"events/on_action_events_1.txt:8326"}],"when":{"zh":"持有「星界丝缕」超过 0","en":"holds \"Astral Threads\" more than 0","detail":["has_resource > {...}"]},"conditional":true,"target":{"zh":"事件来源方","en":"the event source"},"hidden":true,"source":"events/on_action_events_1.txt:8324"}]]}}}