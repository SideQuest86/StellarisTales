nce":0.0007,"group":"r29533","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:35","hooks":["on_roll_failed"],"story":"event-ancrel-8075"},{"target":"ancrel.8080","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29533","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:36","hooks":["on_roll_failed"],"story":"event-ancrel-8080"},{"target":"ancrel.8110","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29533","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:37","hooks":["on_roll_failed"],"story":"event-ancrel-8110"},{"target":"federations2.701","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29533","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:51","hooks":["on_roll_failed"],"story":"event-federations2-701"},{"target":"ancrel.4078","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0018,"group":"r29533","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:64","hooks":["on_roll_failed"],"story":"event-ancrel-4078"},{"target":"ancrel.13030","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29533","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:71","hooks":["on_roll_failed"],"story":"event-ancrel-13030"},{"target":"ancrel.4006","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29533","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:90","hooks":["on_roll_failed"],"story":"event-ancrel-4006"},{"target":"ancrel.4021","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29533","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:104","hooks":["on_roll_failed"],"story":"event-ancrel-4021"},{"target":"story.5","kind":"delay","conditional":false,"delayed":true,"sourceKind":"delay","delay":[{"days":"30"}],"source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt:74","story":"origin_fear_of_the_dark"}],"source":{"file":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","line":53},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"ancrel.6005","kind":"event","title":{"zh":"钻出一个洞","en":"Drilling a Hole"},"texts":[{"zh":"某种非常巨大的建筑物占据了[From.Planet.GetName]小行星的绝大部分内部空间。作为这个建筑物唯一入口的防爆门至今仍无法被打开，但是一条从小行星另一侧的通道已经被挖掘出来。\n\n我们的钻头目前仍无法钻透这个建筑物厚实的外壁，但这个方法似乎仍然提供了进入的最佳机会。尽管它们已经过千年风沙，但是防爆门仍然被证实是坚不可摧的。","en":"A very large structure of some kind occupies most of the interior of asteroid [From.Planet.GetName]. The blast door which once served as this structure's only entrance still can't be opened, but a passage has been dug from the other side of the asteroid.\n\nDrills have so far been unable to penetrate the thick outer walls of the structure, but this method still seems to afford the best chance of gaining access. Despite their age, the blast doors have proven nearly invulnerable."}],"sections":[],"image":"art/f7bcd1747cbd11842197.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.6010","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-command-center"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":278},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"ancrel.6010","kind":"event","title":{"zh":"入口","en":"Entrance"},"texts":[{"zh":"我们最终还是在[From.Planet.GetName]内建筑物的外墙上钻出了一个洞。它的内部是一个宽广的指挥中心，或者是某种地堡，其中零散的散布着几千个腐朽的外星人遗骸。\n\n仔细研究这些，将会让我们得到一张关于当年这颗小行星内部所发生事件更为清晰的图片，这也将花费相当长的时间。","en":"A hole has finally been drilled through the outer walls of structure inside [From.Planet.GetName]. The interior is a vast command center or bunker of some sort, littered with the decayed remains of thousands of dead aliens.\n\nSifting through all this to gain a clearer picture of what exactly was going on inside this asteroid will take considerable time."}],"sections":[],"image":"art/872246aedc238ff28ba5.webp","hidden":false,"choices":[{"key":"FASCINATING","label":{"zh":"很迷人。","en":"Fascinating."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.6015","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-command-center"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":304},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"ancrel.6015","kind":"event","title":{"zh":"指挥中心","en":"Command Center"},"texts":[{"zh":"这颗小行星曾经作为一个相对较大的星际帝国的隐匿首都，该帝国在数千年前曾经统治着这片星区。有了这样堡垒化的指挥中心，帝国的统治精英们可以与数以千计的军事或民政官员一道安全无虞地发号施令，不受其苛政引起的暴乱所威胁。\n\n小行星与帝国的其余部分的联系只依靠加密的亚空间通讯和一艘定期来访以补给基地物资和运送人员的货船来进行。","en":"This asteroid once served as the hidden capital of a relatively large interstellar empire that dominated this section of the galaxy several thousand years ago. From this fortified command center, the ruling elite along with thousands of military and civilian officials administered the empire while safe from the violent reprisals their harsh policies often inspired.\n\nContact with the rest of their empire seems to have been handled exclusively through encrypted subspace transmissions and a single freighter which made periodic visits to resupply the base and transfer personnel."}],"sections":[],"image":"art/80aca0711ce001dcbf46.webp","hidden":false,"choices":[{"key":"REMARKABLE","label":{"zh":"干得漂亮。","en":"Remarkable."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.6020","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-command-center"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":330}},{"id":"ancrel.6020","kind":"event","title":{"zh":"最后时日","en":"The Final Days"},"texts":[{"zh":"从拼凑出的数据来看，这艘补给货船似乎是由于推进器故障而与小行星相撞的。碰撞产生的爆炸破坏了防爆门，并摧毁了小行星的亚空间发射器，永久地切断了它与外界的所有联系。\n\n陷入了困境，更没有得救的希望，小行星的居民慢慢地死于饥饿或自杀。他们唯一残存的子空间接收器的最后日志证实，他们的帝国突然失去了首都，随后陷入内战和混乱中。","en":"From what can be pieced together, it appears that the resupply freighter collided with the asteroid due to a thruster malfunction. The resulting explosion damaged the blast doors and destroyed the asteroid's subspace transmitter, permanently severing all contact with the outside world.\n\nTrapped and with no hope of rescue, the asteroid's inhabitants slowly succumbed to starvation or suicide. The last logs of their single surviving subspace receiver confirm that their empire, suddenly bereft of its capital, descended into civil war and anarchy."}],"sections":[],"image":"art/114a28677a447f6d61c7.webp","hidden":false,"choices":[{"key":"INTERESTING","label":{"zh":"真是有趣。","en":"Interesting."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":356}}]}