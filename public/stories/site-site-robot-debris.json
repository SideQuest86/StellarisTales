nt_effects.txt:36","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8110","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r1","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:37","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"federations2.701","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r1","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:51","hooks":["on_roll_failed"],"story":"event-federations2-701"},{"target":"ancrel.4078","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0018,"group":"r1","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:64","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.13030","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r1","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:71","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4006","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r1","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:90","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4021","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r1","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:104","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"story.5","kind":"delay","conditional":false,"delayed":true,"sourceKind":"delay","delay":[{"days":"30"}],"source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt:395","story":"origin_fear_of_the_dark"}],"source":{"file":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","line":371},"notes":[{"zh":"勘察天体时，隐藏事件 ancrel.9999（on_survey_planet）以 5/405 的机会生成一个随机考古遗址（AI帝国或5年内刚发现过遗址者机会×0.2），再按各遗址的权重抽取；本遗址要求拥有《远古遗物》，权重100，出现在小行星或冰质小行星上。","en":"When a body is surveyed, hidden ancrel.9999 (on_survey_planet) has a 5/405 chance to create a random dig site (×0.2 for AI empires or if a site was found in the last 5 years), then picks a site type by weight; this site needs Ancient Relics and has weight 100 on asteroids and ice asteroids.","kind":"review"}]},{"id":"ancrel.6250","kind":"event","title":{"zh":"两个来源","en":"Two Sides"},"texts":[{"zh":"在仔细检查后，在[From.Planet.GetName]表面发现的机器人碎片似乎来自两种截然不同的文化。从技术上来说，这些机器人在能正常工作时其各部件间一定会完全匹配，但是许多微妙的差异暗示他们不是源自同一设计。","en":"Upon closer examination, the smashed droids found on the surface of [From.Planet.GetName] appear to originate from two distinct cultures. Technologically the droids must have been evenly matched when they were still functional, but there are many subtle differences that hint at different design origins."}],"sections":[],"image":"art/f2c8b72b42b186a8e31d.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.6255","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-robot-debris"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1616},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet","note":{"zh":"游戏里这里会出现这颗星球的名称。","en":"In the game, the planet's name appears here."}}}},{"id":"ancrel.6255","kind":"event","title":{"zh":"战场","en":"Battlefield"},"texts":[{"zh":"[From.Planet.GetName]似乎不仅仅简单的是一个机器人碎片的垃圾场——这颗小行星可能是这些机器人被破坏的战场。多层碎片暗示在过去的两个世纪中断断续续发生了许多场非常激烈的战争。\n\n为什么两个星际大国会因为在一个不起眼的小行星上大打出手仍然是一个未解之谜。","en":"[From.Planet.GetName] does not seem to have simply been a dumping ground for broken droids - it may have served as the actual battlefield where they were destroyed. The many layers of debris suggest a series of very intense battles waged intermittently across the better part of two centuries.\n\nExactly why two interstellar powers would commit such vast resources towards waging a massive ground war on a small and unremarkable asteroid remains an unanswered question."}],"sections":[],"image":"art/9dd0e3e6ffcf359310be.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.6260","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-robot-debris"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1642},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet","note":{"zh":"游戏里这里会出现这颗星球的名称。","en":"In the game, the planet's name appears here."}}}},{"id":"ancrel.6260","kind":"event","title":{"zh":"条约","en":"The Treaty"},"texts":[{"zh":"我们的考古学家已经了解到，在经历了一场漫长而艰苦的战争之后，居住在星系这一角落的两个帝国在大约20万年前签署了一项条约，要求他们用机器人军队之间安排好的、高度管制的战斗来解决所有未来的争端。\n\n[From.Planet.GetName]被选为这些战斗的地点。该条约似乎已维持了将近两个世纪，多次阻止了武装敌对行动的爆发，直到其中一个帝国被发现作弊为止。","en":"Our archaeologists have learned that after a long and bitter war, the two empires inhabiting this corner of the galaxy some 200,000 years ago signed a treaty compelling them to settle all future disputes with arranged and highly regulated combat engagements between robotic armies.\n\n[From.Planet.GetName] was chosen as the site of these battles. The treaty appears to have been upheld for nearly two centuries, preventing the outbreak of armed hostilities on numerous occasions, until one of the empires was caught cheating."}],"sections":[],"image":"art/d63f9361bc2bc9cdd5ab.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1668},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet","note":{"zh":"游戏里这里会出现这颗星球的名称。","en":"In the game, the planet's name appears here."}}}}],"summary":{"text":"# 机器人碎片 / Robot Debris\n\n- 分类 Category：先驱者与考古 Precursors · 来源 Sources：common/archaeological_site_types/02_ancient_relics_arc_sites.txt:371；events/ancient_relics_arcsite_events_2.txt:1617 · DLC：《远古遗物》Ancient Relics · 审阅 Reviewed 2026-10-13\n\n## 如何开始 How it starts\n\n勘察天体时，隐藏事件 ancrel.9999（on_survey_planet）以 5/405 的机会生成一个随机考古遗址（AI帝国或5年内刚发现过遗址者机会×0.2），再按各遗址的权重抽取；本遗址要求拥有《远古遗物》，权重100，出现在小行星或冰质小行星上。\n\nWhen a body is surveyed, hidden ancrel.9999 (on_survey_planet) has a 5/405 chance to create a random dig site (×0.2 for AI empires or if a site was found in the last 5 years), then picks a site type by weight; this site needs Ancient Relics and has weight 100 on asteroids and ice asteroids.\n\n## 剧情脉络 Story outline\n\n小行星表面铺满战斗机器人的残骸：两个帝国曾约定把争端交给机器人军队在此打擂台。\n\n1. 两个来源：残骸来自两种不同的文化\n2. 战场：这里是真正的战场，战斗持续近两个世纪\n3. 条约：二十万年前的条约规定用受管制的机器人对战解决纷争（质量加速器科技选项25%、工程学研究、中型文物）\n\nAn asteroid covered in the wreckage of combat droids: two empires agreed to settle disputes by robot armies fighting here.\n\n1. Two Sides: the droids come from two distinct cultures\n2. Battlefield: this was the battlefield itself, fought over almost two centuries\n3. The Treaty: a treaty 200,000 years ago set regulated robot battles (mass-driver tech option 25%, engineering research, medium artifact)\n\n## 分支与结局 Branches and outcomes\n\n\n## 条件与文明差异 Conditions and variants\n\n- 无特殊的文明差异。 / No empire-specific variants beyond the reward wording.\n- 掷骰失败时使用通用事件池 all_random_events（见“考古遗址：发掘意外”）。 / Failed rolls use the generic pool all_random_events (see \"Archaeological Sites: excavation incidents\").\n\n## 审阅记录 Review notes\n\n- 已核对：遗址定义（common/archaeological_site_types/02_ancient_relics_arc_sites.txt:371）的阶段顺序与条件、各阶段事件脚本、出现方式；中英文正文已读。\n- Checked: the site definition (common/archaeological_site_types/02_ancient_relics_arc_sites.txt:371) with its stage order and conditions, every stage event script, and how the site appears; both languages read.\n","path":"summaries/site-site-robot-debris.md"}}