e_events.txt","line":317},"body":[{"pieces":[{"text":0},{"break":true},{"text":2,"when":[[{"type":"identity","key":"origin_primal_calling","value":true,"label":{"zh":"野性呼唤","en":"Primal Calling"}}]]}]}]},{"id":"special_projects:VOIDWORMS_PROJECT","kind":"project","title":{"zh":"虚空虫研究","en":"Voidworm Research"},"texts":[{"zh":"虚空虫的生物学特性和繁殖模式值得进一步研究。","en":"The biology and reproductive patterns of the Voidworms warrant further study."}],"sections":[],"image":"art/1d63676aac33381abc58.webp","hidden":false,"choices":[],"next":[{"target":"grand_archive.2015","kind":"project","conditional":false,"delayed":false,"sourceKind":"project","source":"common/special_projects/04_projects_grand_archive.txt:17","hooks":["on_success"],"story":"event-grand-archive-2005"}],"source":{"file":"common/special_projects/04_projects_grand_archive.txt","line":5},"alsoIn":["origin_treasure_hunters"]},{"id":"grand_archive.2015","kind":"event","title":{"zh":"虚空虫酶","en":"Voidworm Enzymes"},"texts":[{"zh":"虚空虫以三只为一组交配，这种形态被称为“三头虫”。这些生物的一生都被绑定在永无止境的交配仪式中。然而，它们需要外部生物宿主才能繁殖后代。\n\n它们是寄生虫。\n\n虚空虫成熟后，会在其生殖系统内发育出一窝囊肿。这些保护性囊肿包含高腐蚀性的配子，当与三头虫中的其他配子结合时，可以被发送到具有合适生物量的星球上，以产下更多幼虫。它们的宿主无法在这一过程中存活。我们已经看到证据表明，虚空虫会协调它们的轰炸，以便在整个星系中维持可持续数量的可用宿主。\n\n无论如何，我们相信我们可以利用它们的生殖酶的力量来造福我们自己。我们甚至可以对它们的繁殖活动产生免疫力。","en":"Voidworms mate in groups of three, a formation known as a \"Troika.\" These creatures become bound for life in a never-ending mating ritual. However, they require an external biological host to produce offspring.\n\nThey are parasites.\n\nUpon reaching maturity, each Voidworm develops a clutch of cysts within their reproductive systems. These protective cysts contain highly caustic gametes that, when combined with others in a Troika, can be sent to planets with suitable biomass in order to give birth to more of their nymphs. Their hosts do not survive this process. We've seen evidence that the Voidworms coordinate their bombardments so as to maintain a sustainable amount of viable hosts throughout the galaxy.\n\nIn any case, we believe that we can harness the power of their reproductive enzymes to our own benefit. We may even develop an immunity to their reproductive efforts."}],"sections":[],"image":"art/957be1e6618b92e343b8.webp","hidden":false,"choices":[{"key":"grand_archive.2015.a","label":{"zh":"利用他们的生育能力来满足我们自己的需求。","en":"Harness their fertility for our own needs."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false},{"key":"grand_archive.2015.b","label":{"zh":"真恶心。找到治愈方式。","en":"Disgusting. Find a cure."},"responses":[],"tooltips":[],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"other","key":"has_technology","arg":"tech_voidworm_immunity","scope":"","value":false,"label":{"zh":"虚空虫免疫","en":"Voidworm Immunity"}}]]}],"next":[],"source":{"file":"events/grand_archive_events.txt","line":480},"alsoIn":["origin_treasure_hunters"]}]}