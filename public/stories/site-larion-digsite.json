sourceKind":"failure","chance":0.0007,"group":"r29822","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:35","hooks":["on_roll_failed"],"story":"event-ancrel-8075"},{"target":"ancrel.8080","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29822","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:36","hooks":["on_roll_failed"],"story":"event-ancrel-8080"},{"target":"ancrel.8110","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29822","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:37","hooks":["on_roll_failed"],"story":"event-ancrel-8110"},{"target":"federations2.701","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29822","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:51","hooks":["on_roll_failed"],"story":"event-federations2-701"},{"target":"ancrel.4078","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0018,"group":"r29822","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:64","hooks":["on_roll_failed"],"story":"event-ancrel-4078"},{"target":"ancrel.13030","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29822","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:71","hooks":["on_roll_failed"],"story":"event-ancrel-13030"},{"target":"ancrel.4006","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29822","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:90","hooks":["on_roll_failed"],"story":"event-ancrel-4006"},{"target":"ancrel.4021","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29822","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:104","hooks":["on_roll_failed"],"story":"event-ancrel-4021"}],"source":{"file":"common/archaeological_site_types/06_overlord_arc_sites.txt","line":89}},{"id":"unique.1","kind":"event","title":{"zh":"坠毁的飞船","en":"The Crashed Ship"},"texts":[{"zh":"在仔细搜索接收到奇怪信号的山谷后，我们最终找到了一艘失事的破旧飞船。尽管它仍在向外发出求救信号，但各个舱室似乎大都是空荡荡的，没有生命迹象。\n\n在我们完全检查这片区域后，我们的一位[Root.Owner.GetScientistPlural]偶然发现了一处小型营地，沿着久远的足迹向前探索之后便发现了一座古老的实验室。尽管其入口被残骸堵住，但就目前情况来看，这里很有可能就是飞船上失踪异种们所在的地方。","en":"After meticulously searching and analyzing the valley where we picked up on the weird signal, we finally managed to track down the crash site of an old dilapidated ship. Though it still sends out a call for aid, the vessel seems to be mostly empty, and there's no sign of life inside.\n\nOne of our [Root.Owner.GetScientistPlural] came across a small camp site while we were thoroughly examining the area, and after following some old tracks they found an old laboratory. Though blocked by debris, for now, this might be the location of the missing xenos from the ship."}],"sections":[],"image":"art/4b999fbce293afccb85f.webp","hidden":false,"choices":[{"key":"unique.1.a","label":{"zh":"清理残骸。","en":"Clear out the debris."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"unique.5","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/06_overlord_arc_sites.txt","hooks":["stage"],"story":"site-larion-digsite"}],"source":{"file":"events/unique_system_events.txt","line":12}},{"id":"unique.5","kind":"event","title":{"zh":"古怪的实验室","en":"The Weird Laboratory"},"texts":[{"zh":"清理完最后一块残骸之后，我们的[Root.Owner.GetScientistPlural]发现了一堆异种的遗骸，应该就是那艘失事飞船上的生物。通过小心分析这些遗骸，[Root.Owner.GetScientistPlural]认为他们一定是死于体内器官的过早衰竭，这很有可能是由某种未知的细菌或疾病引发的。\n\n目前而言我们还不知道他们来这里干什么，或者说不知道在生命的最后时光中是谁把他们带到这来的。实验室中的旧仪器和数据库无法再分析拆解，房间里也没有什么其他东西可以给我们提示。\n\n一扇通往地下室的小门被锁住了，而且我们无法将其解锁。但[Root.Owner.GetScientistPlural]相信只要给他们一些时间就肯定可以将其打开。","en":"After clearing out the last of the debris our [Root.Owner.GetScientistPlural] found the bodies of a group of xenos, presumably the ones who had arrived on the crashed ship. After their remains were carefully analyzed, our [Root.Owner.GetScientistPlural] have concluded they must have died from an early degradation of their internal organs - most likely due to some unknown bacteria or disease.\n\nIt is still unclear what their aims were, or what brought them to this specific location in their last moments. The old machines and computer banks of the laboratory are unsalvageable, and there's nothing else in the room itself that can give us any hints.\n\nA small door leading further downwards is blocked off, and any preliminary attempts at decrypting it have failed. But our [Root.Owner.GetScientistPlural] believe they can get them open given some time."}],"sections":[],"image":"art/17fa3811494dd020aafc.webp","hidden":false,"choices":[{"key":"unique.5.a","label":{"zh":"还有一步之遥，我们即将揭开此处的神秘面纱。","en":"One last push, and we will unravel the secrets of this place."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"unique.10","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/06_overlord_arc_sites.txt","hooks":["stage"],"story":"site-larion-digsite"}],"source":{"file":"events/unique_system_events.txt","line":65}},{"id":"unique.10","kind":"event","title":{"zh":"罕见的标本","en":"The Unique Specimens"},"texts":[{"zh":"随着一阵风从里面吹出，通往实验室最后一个房间的门终于打开了，房间的大小显然超出了我们的预期，里面摆满了一排排的克隆舱，数百，不，甚至是数千个生物被锁在这里，在这不见天日的地下。\n\n[Root.Owner.GetScientistPlural]很快得出结论，这些生物和之前我们所发现的遗骸是同种。如果我们想要的话，这些克隆舱旁边的小按钮似乎就可以唤醒他们。","en":"With a small release of air the doors to the final chamber of the laboratory finally opens, significantly larger than anyone would expect. Rows and rows of cloning vats fills the area - hundreds if not thousands of creatures locked away underground.\n\nOur [Root.Owner.GetScientistPlural] quickly conclude they are of the same species as the remains we found earlier. A small button by each of the cloning vats seems to be all that is needed to wake them up, if we so want."}],"sections":[],"image":"art/d154df6317c4085c5516.webp","hidden":false,"choices":[{"key":"unique.10.a","label":{"zh":"拆开这些克隆舱，我们可以从中学到什么。","en":"Take apart their cloning vats and see what we can learn."},"responses":[],"tooltips":[],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"other","key":"values_others","arg":"yes","scope":"owner","value":false},{"type":"identity","key":"origin_evolutionary_predators","value":false,"label":{"zh":"演化猎手","en":"Evolutionary Predators"}}]],"labels":[{"label":{"zh":"拆开这些克隆舱，我们可以从中学到什么。","en":"Take apart their cloning vats and see what we can learn."},"when":[[{"type":"other","key":"is_homicidal","arg":"no","scope":"owner","value":false}]]},{"label":{"zh":"猎物","en":"PREY"},"when":[[{"type":"identity","key":"civic_hive_devouring_swarm","value":true,"label":{"zh":"噬杀蜂群","en":"Devouring Swarm"}}]]},{"label":{"zh":"外星渣滓。","en":"Xeno scum."},"when":[[{"type":"identity","key":"civic_fanatic_purifiers","value":true,"label":{"zh":"种族洁癖","en":"Fanatic Purifiers"}}]]},{"label":{"zh":"<<侦测到有机生命。通讯终止。>>","en":"<< Organics identified. Communications terminated. >>"},"when":[[{"type":"identity","key":"civic_machine_terminator","value":true,"label":{"zh":"铁心灭绝者","en":"Determined Exterminator"}}]]}]},{"key":"unique.10.b","label":{"zh":"让我们挑其中的一个唤醒吧。","en":"Let us wake one of them."},"responses":[],"tooltips":[{"zh":"我们将与其中一位克隆体对话。","en":"We will engage with one of the clones."}],"conditional":true,"next":[{"target":"unique.15","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/unique_system_events.txt:178","story":"site-larion-digsite"}],"terminal":false,"when":[[{"type":"identity","key":"ethic_xenophobe","value":false,"label":{"zh":"排外主义","en":"Xenophobe"}},{"type":"other","key":"is_homicidal","arg":"no","scope":"owner","value":false}]]},{"key":"unique.10.c.evopred","label":{"zh":"装罐的有机体，美味极了。","en":"Canned genetics. Delicious."},"responses":[],"tooltips":[],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"origin_evolutionary_predators","value":true,"label":{"zh":"演化猎手","en":"Evolutionary Predators"}}]]}],"next":[],"source":{"file":"events/unique_system_events.txt","line":106}},{"id":"unique.15","kind":"event","title":{"zh":"拉里昂内斯克隆体","en":"Larionessi Clone"},"texts":[{"zh":"我……我们……苏醒了。\n\n我们……在哪？我们的母星怎么样了？它还……是的，我还能感觉到她，她依然存在。\n\n对不起，我知道这似乎对客人们很无礼，我们是拉里昂内斯的意识，欢迎来到我们的母星，拉里昂。请问能不能拜托你释放我们，让我们重回家园呢？","en":"I... we... awaken.\n\nWhere are... we? What of our homeworld, does it... Yes, we can feel it - it still exists.\n\nWe apologize, it seems we have been discourteous to guests - we of the Larionessi Consciousness welcome you to our homeworld, Larion. Would you be willing to release us so we can see our home once more?"}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"unique.15.a","label":{"zh":"你能更详细地介绍一下自己吗？","en":"Can you tell us more about yourselves?"},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"unique.16","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/unique_system_events.txt:218","story":"site-larion-digsite"}],"terminal":false},{"key":"unique.15.b","label":{"zh":"谁创造了这些克隆体？","en":"Who made these clones?"},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"unique.17","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/unique_system_events.txt:222","story":"site-larion-digsite"}],"terminal":false},{"key":"unique.15.c","label":{"zh":"你们能安全离开这些克隆舱吗？","en":"Would you be safe outside of these vats?"},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"unique.18","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/unique_system_events.txt:226","story":"site-larion-digsite"}],"terminal":false},{"key":"unique.15.d","label":{"zh":"我们知道该怎么办了。","en":"We know what to do with you."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"unique.20","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/unique_system_events.txt:230","story":"site-larion-digsite"}],"terminal":false}],"next":[],"source":{"file":"events/unique_system_events.txt","line":203}},{"id":"unique.16","kind":"event","title":{"zh":"","en":""},"texts":[{"zh":"我们是拉里昂内斯意识，是拉里昂的原住民。\n\n从前我们跨越数个恒星系，从星系的外缘一直遍布到核心。然而当我们的敌人给我们感染了一种罕见的疾病，瘫痪了我们的神经网络后，一切都改变了。\n\n这里就是我们现在所有的一切了，这些克隆舱，这些克隆体……","en":"We are the Larionessi Consciousness, the inhabitants of Larion.\n\nOnce our collective stretched across several solar systems, from the outer rims of our galaxy and all the way to the very core. That all changed when one of our adversaries infected us with a rare disease that ripped across our multitudes, and left our neural network paralyzed.\n\nNow this is all that remains. These vats, these clones..."}],"sections":[],"image":null,"hidden":false,"choices":[],"next":[],"source":{"file":"events/unique_system_events.txt","line":234}},{"id":"unique.17","kind":"event","title":{"zh":"","en":""},"texts":[{"zh":"是我们自己。\n\n这是我们最后一次尝试留下一部分我们的传承，这样主意识的记忆就永远不会消失了。呃……我们现在似乎也的确办到了。\n\n我们担心这些克隆体可能会把过去的疾病遗传下来，不过现在看来似乎没有。","en":"We did.\n\nIt was our last effort to try and carry on some part of our legacy, so that the memories of our consciousness would not disappear forever. And... it seems to have worked.\n\nWe worried our clones might inherit the problems of the past, but it seems they did not."}],"sections":[],"image":null,"hidden":false,"choices":[],"next":[],"source":{"file":"events/unique_system_events.txt","line":241}},{"id":"unique.18","kind":"event","title":{"zh":"","en":""},"texts":[{"zh":"据我们所知，这种疾病肯定已经在很久很久以前我们建造这些克隆舱之后消失了。\n\n毕竟很难想象这种疾病在找不到宿主的情况下还能一直存在。你放我们出来是没有问题的，这样就可以让我们的集体重获新生了。","en":"As far as we know, the disease must have disappeared in the eons since we originally created these clones.\n\nWe are hard pressed to imagine a scenario where the disease would survive without a host. We should be safe to be released so we can begin the restoration of our collective."}],"sections":[],"image":null,"hidden":false,"choices":[],"next":[],"source":{"file":"events/unique_system_events.txt","line":248}},{"id":"unique.20","kind":"event","title":{"zh":"","en":""},"texts":[{"zh":"所以……\n\n你会怎么决定我们的命运？你会将我们放出来让我们重回家园吗？","en":"So...\n\nWhat will be our fate? Will you finally release us from these vats and give us back our homes?"}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"unique.20.a","label":{"zh":"拉里昂是你们的，理应如此。","en":"Larion is yours, as it should be."},"responses":[],"tooltips":[{"zh":"我们将得到一个拥有[larion_planet.solar_system.GetName]恒星系的附庸。","en":"We get a new vassal who will be given the [larion_planet.solar_system.GetName] system."}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"other","key":"exists","arg":"event_target:larion_planet.starbase","scope":"","value":true},{"type":"other","key":"is_same_value","arg":"root","scope":"event_target:larion_planet.starbase/owner","value":true}]]},{"key":"unique.20.b","label":{"zh":"我们会为你们找到一个栖息地的。","en":"We will find a place for you to stay."},"responses":[],"tooltips":[{"zh":"拉里昂内斯将被指定[Root.Capital.GetName]作为母星。","en":"The Larionessi will get a designated home at [Root.Capital.GetName]."}],"conditional":false,"next":[],"terminal":false},{"key":"unique.20.c","label":{"zh":"你们曾经是有机会的。","en":"You had your chance."},"responses":[],"tooltips":[{"zh":"我们会关闭这些克隆舱。","en":"We we will shut down the clone vats."}],"conditional":false,"next":[{"target":"unique.22","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/unique_system_events.txt:412","story":"site-larion-digsite"}],"terminal":false}],"next":[],"source":{"file":"events/unique_system_events.txt","line":255}},{"id":"unique.22","kind":"event","title":{"zh":"","en":""},"texts":[{"zh":"那么接下来……","en":"So it is then..."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"DOTDOTDOT","label":{"zh":"……","en":"..."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/unique_system_events.txt","line":428}}]}