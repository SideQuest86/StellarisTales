e":0.0035,"group":"r1","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:51","hooks":["on_roll_failed"],"story":"event-federations2-701"},{"target":"ancrel.4078","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0018,"group":"r1","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:64","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.13030","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r1","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:71","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4006","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r1","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:90","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4021","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r1","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:104","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"story.5","kind":"delay","conditional":false,"delayed":true,"sourceKind":"delay","delay":[{"days":"30"}],"source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt:1535","story":"origin_fear_of_the_dark"}],"source":{"file":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","line":1522},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet","note":{"zh":"游戏里这里会出现这颗星球的名称。","en":"In the game, the planet's name appears here."}}},"notes":[{"zh":"勘察天体时，隐藏事件 ancrel.9999（on_survey_planet）以 5/405 的机会生成一个随机考古遗址（AI帝国或5年内刚发现过遗址者机会×0.2），再按各遗址的权重抽取；本遗址要求拥有《远古遗物》，权重100，出现在小行星上。全银河最多一处。","en":"When a body is surveyed, hidden ancrel.9999 (on_survey_planet) has a 5/405 chance to create a random dig site (×0.2 for AI empires or if a site was found in the last 5 years), then picks a site type by weight; this site needs Ancient Relics and has weight 100 on asteroids. At most one per galaxy.","kind":"review"}]},{"id":"ancrel.102","kind":"event","title":{"zh":"奇异之门","en":"Strange Door"},"texts":[{"zh":"随着科研船靠近[From.Planet.GetName]，一道巨大的，饱经风沙的门显露了出来。到底是谁修了这个大东西，又是为了什么？或许答案就在里面。","en":"As the science ship approaches [From.Planet.GetName], a vast and time-worn door is revealed. Who would have built such a thing, and why? Perhaps the answers are inside."}],"sections":[],"image":"art/be54c031eade3b90b35b.webp","hidden":false,"choices":[{"key":"ancrel.102.a","label":{"zh":"给我打开这扇门！","en":"Open the door!"},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.103","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-asteroid-vault-1"}],"source":{"file":"events/ancient_relics_arcsite_events_1.txt","line":680},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet","note":{"zh":"游戏里这里会出现这颗星球的名称。","en":"In the game, the planet's name appears here."}}}},{"id":"ancrel.103","kind":"event","title":{"zh":"小行星保险库","en":"Asteroid Vault"},"texts":[{"zh":"打开保险库所带来的问题比它解决的要多得多。放置在里面的是各种各样稀奇古怪的东西，从垃圾到可能来自被遗忘帝国的文物。整理这些物品需要一些时间，但我们确实找到了一些有用的东西。","en":"Opening the vault has raised more questions than it has answered. Contained within is an esoteric collection of items ranging from junk to what are possibly artifacts from a forgotten empire. Sorting through it all took some time, but we did find some useful items."}],"sections":[],"image":"art/93b3620d437a373e317d.webp","hidden":false,"choices":[{"key":"ancrel.103.a","label":{"zh":"一个惊喜！","en":"A welcome surprise!"},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_1.txt","line":698}}],"summary":{"text":"# 奇怪的小行星 / Strange Asteroid\n\n- 分类 Category：先驱者与考古 Precursors · 来源 Sources：common/archaeological_site_types/02_ancient_relics_arc_sites.txt:1522；events/ancient_relics_arcsite_events_1.txt:681 · DLC：《远古遗物》Ancient Relics · 审阅 Reviewed 2026-10-13\n\n## 如何开始 How it starts\n\n勘察天体时，隐藏事件 ancrel.9999（on_survey_planet）以 5/405 的机会生成一个随机考古遗址（AI帝国或5年内刚发现过遗址者机会×0.2），再按各遗址的权重抽取；本遗址要求拥有《远古遗物》，权重100，出现在小行星上。全银河最多一处。\n\nWhen a body is surveyed, hidden ancrel.9999 (on_survey_planet) has a 5/405 chance to create a random dig site (×0.2 for AI empires or if a site was found in the last 5 years), then picks a site type by weight; this site needs Ancient Relics and has weight 100 on asteroids. At most one per galaxy.\n\n## 剧情脉络 Story outline\n\n一颗伪装成天然小行星的人造保险库，一扇巨大的古门后是杂乱的“来自被遗忘帝国的物品”。\n\n1. 奇异之门：科学船接近时露出一扇古老的巨门（小型文物）\n2. 小行星保险库：开启保险库，整理后得到有用物品（质量加速器科技选项25%、三类研究、中型文物）\n\nAn artificial vault disguised as an asteroid; behind a vast ancient door is a jumble of artifacts from a forgotten empire.\n\n1. Strange Door: a time-worn door appears as the science ship approaches (small artifact)\n2. Asteroid Vault: opening it yields useful items (mass-accelerator tech option 25%, all three research types, medium artifact)\n\n## 分支与结局 Branches and outcomes\n\n\n## 条件与文明差异 Conditions and variants\n\n- 无特殊的文明差异。 / No empire-specific variants beyond the reward wording.\n- 掷骰失败时使用通用事件池 all_random_events（见“考古遗址：发掘意外”）。 / Failed rolls use the generic pool all_random_events (see \"Archaeological Sites: excavation incidents\").\n\n## 审阅记录 Review notes\n\n- 已核对：遗址定义（common/archaeological_site_types/02_ancient_relics_arc_sites.txt:1522）的阶段顺序与条件、各阶段事件脚本、出现方式；中英文正文已读。\n- Checked: the site definition (common/archaeological_site_types/02_ancient_relics_arc_sites.txt:1522) with its stage order and conditions, every stage event script, and how the site appears; both languages read.\n","path":"summaries/site-asteroid-vault-1.md"}}