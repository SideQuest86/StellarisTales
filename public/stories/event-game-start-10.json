Name] will be very angry, and are likely to attack us."}],"conditional":false,"next":[],"terminal":false,"clears":["fe_demand_made"]}],"next":[],"source":{"file":"events/fallen_empire_events.txt","line":190},"names":{"Root.GetSpeciesName":{"zh":"该物种","en":"the species"},"Root.GetName":{"zh":"我们的帝国","en":"our empire"}}},{"id":"fallen_empires.5","kind":"event","title":{"zh":"来自[From.GetName]的通讯","en":"Communication from [From.GetName]"},"texts":[{"zh":"[Root.GetSpeciesName]，我们发现你们正在笨拙地尝试创造人工智能，认为你们正在走上灵魂自毁的错误道路上。立即停止这个愚蠢的举动，否则我们会帮你停止。","en":"[Root.GetSpeciesName], we have observed your fumbling attempts at creating artificial intelligence and come to the conclusion that you are headed down the path of spiritual self-destruction. Abandon this foolish endeavour at once, or we will MAKE you."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"fallen_empires.5.a","label":{"zh":"我们别无选择，只能接受……","en":"We have no choice but to accept..."},"responses":[],"tooltips":[{"zh":"人工智能政策将被改为非法。","en":"Artificial Intelligence policy will be set to Outlawed."}],"conditional":true,"next":[],"terminal":false,"allow":[[{"type":"other","key":"policy","arg":"artificial_intelligence_policy","scope":"can_set_policy","value":true},{"type":"other","key":"option","arg":"ai_outlawed","scope":"can_set_policy","value":true}]],"clears":["fe_demand_made"]},{"key":"fallen_empires.5.b","label":{"zh":"[Root.GetName]绝不会受到欺凌！","en":"The [Root.GetName] will not be bullied!"},"responses":[],"tooltips":[{"zh":"[From.GetName]会勃然大怒，很可能会攻击我们。","en":"[From.GetName] will be very angry, and are likely to attack us."}],"conditional":false,"next":[],"terminal":false,"clears":["fe_demand_made"]}],"next":[],"source":{"file":"events/fallen_empire_events.txt","line":234},"names":{"Root.GetSpeciesName":{"zh":"该物种","en":"the species"},"Root.GetName":{"zh":"我们的帝国","en":"our empire"}}},{"id":"fallen_empires.6","kind":"event","title":{"zh":"来自[From.GetName]的通讯","en":"Communication from [From.GetName]"},"texts":[{"zh":"[Root.GetSpeciesName]野蛮人！别以为没人发现你们的暴行。你们肆意的屠杀和奴役行径正在威胁整个星系的未来。我们给你个选择的机会：停止你野蛮的行径，否则就做好准备面对我们的正义制裁吧。","en":"[Root.GetSpeciesName] barbarians! Your crimes have not gone unnoticed. The enslavement and butchery that you are so wantonly engaging threatens the future of the entire galaxy. We present you with a choice: end your barbarous practices, or prepare to face our righteous might."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"fallen_empires.6.a","label":{"zh":"我们别无选择，只能接受……","en":"We have no choice but to accept..."},"responses":[],"tooltips":[{"zh":"奴隶制政策将被改为禁止。\n净化政策将改为禁止。","en":"Slavery policy will be set to Prohibited.\nPurge policy will be set to Prohibited."}],"conditional":false,"next":[],"terminal":false,"clears":["fe_demand_made"]},{"key":"fallen_empires.6.b","label":{"zh":"[Root.GetName]绝不会受到欺凌！","en":"The [Root.GetName] will not be bullied!"},"responses":[],"tooltips":[{"zh":"[From.GetName]会勃然大怒，很可能会攻击我们。","en":"[From.GetName] will be very angry, and are likely to attack us."}],"conditional":false,"next":[],"terminal":false,"clears":["fe_demand_made"]}],"next":[],"source":{"file":"events/fallen_empire_events.txt","line":285},"names":{"Root.GetSpeciesName":{"zh":"该物种","en":"the species"},"Root.GetName":{"zh":"我们的帝国","en":"our empire"}}},{"id":"fallen_empires.7","kind":"event","title":{"zh":"来自[From.GetName]的通讯","en":"Communication from [From.GetName]"},"texts":[{"zh":"顽固的[From.GetSpeciesNamePluralInsult]！这是对你们冒犯我们领地的最后一次警告！马上撤走，不然我们会替宇宙清除污秽——也就是你们这悲哀渺小的物种。","en":"Filthy [From.GetSpeciesNamePluralInsult]! You have encroached upon our space for the last time! Withdraw immediately, or we will cleanse the stain upon the universe that is your worthless species."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"fallen_empires.7.a","label":{"zh":"我们别无选择，只能接受……","en":"We have no choice but to accept..."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false,"clears":["fe_demand_made"]},{"key":"fallen_empires.7.b","label":{"zh":"[Root.GetName]绝不会受到欺凌！","en":"The [Root.GetName] will not be bullied!"},"responses":[],"tooltips":[{"zh":"[From.GetName]会勃然大怒，很可能会攻击我们。","en":"[From.GetName] will be very angry, and are likely to attack us."}],"conditional":false,"next":[],"terminal":false,"clears":["fe_demand_made"]}],"next":[],"source":{"file":"events/fallen_empire_events.txt","line":330},"names":{"Root.GetName":{"zh":"我们的帝国","en":"our empire"}}},{"id":"fallen_empires.8","kind":"event","title":{"zh":"来自[From.GetName]的通讯","en":"Communication from [From.GetName]"},"texts":[{"zh":"无知的[Root.GetSpeciesName]。你们对长者的不敬简直大错特错。匍匐在我们面前乞求宽恕，我们或许有可能放过你们那毫无价值的小帝国。","en":"Foolish [Root.GetSpeciesName]. The lack of respect you show for your elders will be your undoing. Prostrate yourselves before us and beg our forgiveness, and we may refrain from annihilating your worthless little empire."},{"zh":"不和谐的[Root.GetSpeciesName]。难道你们没有发现自己是在带来杂音逼我们动手吗。好自为之，不然我们会来帮你们调调音准的。","en":"Disharmonious [Root.GetSpeciesName]. Don't you see that by inviting chaos you force us to intervene. Harmonize now or we will tune you."},{"zh":"愚昧的[Root.GetSpeciesName]，你们拒绝成长演化就是对生命本身的亵渎。乖乖听话，否则我们会把你们连根拔起，反正我们再种下新的种子亦非难事。","en":"Stagnant [Root.GetSpeciesName], your refusal to grow and evolve is an affront to life itself. Embrace our teachings, or we will uproot your failure and sow the seeds of progress ourselves"},{"zh":"怯懦的[Root.GetSpeciesName]。你们的帝国就是脆弱的教科书。把你们的弱点咽下去，好好道歉，然后准备接受我们的挑战——否则我们可以随手把你们化为齑粉，用更有价值的人来替代你们。","en":"Cowardly [Root.GetSpeciesName]. Your empire is a testament to frailty. Now swallow your weakness, apologize, and get ready to meet our challenge - or we will shatter you and replace you with someone more worthy."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"fallen_empires.8.a","label":{"zh":"我们别无选择，只能接受……","en":"We have no choice but to accept..."},"responses":[],"tooltips":[{"zh":"与[from.GetName]结束宿敌关系\n[Root.GetName]失去了所有针对[from.GetName]境内恒星系的宣称。","en":"Ends rivalry with [from.GetName]\n[Root.GetName] loses any claims to the [from.GetName]'s systems"}],"conditional":false,"next":[],"terminal":false,"clears":["fe_demand_made"]},{"key":"fallen_empires.8.b","label":{"zh":"[Root.GetName]绝不会受到欺凌！","en":"The [Root.GetName] will not be bullied!"},"responses":[],"tooltips":[{"zh":"[From.GetName]会勃然大怒，很可能会攻击我们。","en":"[From.GetName] will be very angry, and are likely to attack us."}],"conditional":false,"next":[],"terminal":false,"clears":["fe_demand_made"]}],"next":[],"source":{"file":"events/fallen_empire_events.txt","line":374},"body":[{"pieces":[{"text":0}]},{"pieces":[{"text":1}]},{"pieces":[{"text":2}]},{"pieces":[{"text":3}]}],"names":{"Root.GetSpeciesName":{"zh":"该物种","en":"the species"},"Root.GetName":{"zh":"我们的帝国","en":"our empire"}}}]}