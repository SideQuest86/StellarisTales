urceKind":"failure","chance":0.0035,"group":"r29675","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:37","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"federations2.701","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29675","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:51","hooks":["on_roll_failed"],"story":"event-federations2-701"},{"target":"ancrel.4078","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0018,"group":"r29675","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:64","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.13030","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29675","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:71","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4006","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29675","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:90","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4021","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29675","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:104","hooks":["on_roll_failed"],"story":"archaeology-incidents"}],"source":{"file":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","line":1758}},{"id":"ancrel.2041","kind":"event","title":{"zh":"白骨之城","en":"City of Bones"},"texts":[{"zh":"部分久藏于[From.Planet.GetName]沙漠之下森然的白骨之城已经被[Root.GetName]团队仔细的发掘出来。\n\n这个城市似乎是由数百万年之前原始外星社会在大陆上的沙漠中建造。在这片无水沙漠中缺乏建筑材料可能是这个失落城市使用骨头建造的原因……尽管我们还不清楚这些白骨来自什么生物。","en":"Parts of the ghastly city of bones long-buried beneath the sands on [From.Planet.GetName] have been carefully excavated by the [Root.GetName] team.\n\nThe city appears to have been built by a primitive alien society millions of years ago, on a continental stretch of desert. The lack of other building materials in a waterless desert likely contributed to this long-lost society's use of bones in construction... though what manner of creature the bones came from remains unknown."}],"sections":[],"image":"art/61df790f95c52e680c8c.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.2042","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-city-of-bones"}],"source":{"file":"events/ancient_relics_arcsite_events_1.txt","line":2417},"names":{"Root.GetName":{"zh":"这支舰队","en":"the fleet"},"From.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"ancrel.2042","kind":"event","title":{"zh":"白骨之城","en":"City of Bones"},"texts":[{"zh":"一场针对性的挖掘既没有发现任何一具这个用来建造这座城市的生物完整的骨骼，也没有在城外发现任何相似化石的案例。关于在[From.Planet.GetName]上失落文明到底是从哪里获得了建造这座令人毛骨悚然城市的骨头仍然是个问题。\n\n我们的研究人员已经假定这些骨骼来自某种与其共生或是其牲畜的物种身上，因此只会保留在他们城市附近。对其进一步研究应该揭示更多信息。","en":"A targeted excavation has revealed neither a complete skeleton belonging to the species from whose bones the timeworn city was built, nor any examples of similar fossils from beyond the city. The question of where the lost civilization on [From.Planet.GetName] obtained the bones they used to build their macabre city remains.\n\nOur researchers have begun to hypothesize that the bones may have been taken from a symbiotic or livestock species, kept only in the city's proximity. Further study should reveal more."}],"sections":[],"image":"art/61df790f95c52e680c8c.webp","hidden":false,"choices":[{"key":"DIG","label":{"zh":"继续挖！","en":"Keep digging!"},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.2043","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-city-of-bones"}],"source":{"file":"events/ancient_relics_arcsite_events_1.txt","line":2437},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"ancrel.2043","kind":"event","title":{"zh":"白骨之城","en":"City of Bones"},"texts":[{"zh":"[From.Planet.GetName]的沙漠上建成了一座白骨皑皑的城市，让人毛骨悚然，个中的缘由如今终于被我们的科学家揭晓。近来的研究发现，这些骨头都来自于此星球上一种早已灭绝的爬行生物——这种生物染上了一种很罕见的遗传病，会导致器官爆发式增殖及软组织骨化。\n\n似乎[From.Planet.GetName]上的失落文明注意到了这种遗传病，并加以利用。他们选择性地培育那些患病的爬行生物，以便在这片他们称之为家的荒凉砂地上稳定地获取建筑材料。","en":"Our scientists have at last unraveled the origins of the bones used to create the macabre city on the sandy dunes of [From.Planet.GetName]. Recent findings have proven the bones belong to a long-extinct species of reptile native to the planet -- a species which developed a rare genetic disease, causing explosive organ growth and soft-tissue ossification.\n\nThe lost civilization on [From.Planet.GetName] appears to have noted the spread of this disease and then exploited it, selectively breeding the affected reptiles in order to cultivate a steady supply of building materials on the sandy, desolate wastes they called home."}],"sections":[],"image":"art/61df790f95c52e680c8c.webp","hidden":false,"choices":[{"key":"ancrel.2043.a","label":{"zh":"真是可怕。","en":"Gruesome."},"responses":[],"tooltips":[{"zh":"解锁决议：应用组织生长刺激物","en":"Unlocks Decision: Deploy Tissue Growth Stimulants"}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"auth_machine_intelligence","value":false,"label":{"zh":"机械智能","en":"Machine Intelligence"}},{"type":"identity","key":"is_individual_machine","value":false}]],"sets":["city_of_bones_completed"]},{"key":"INTERESTING","label":{"zh":"真是有趣。","en":"Interesting."},"responses":[],"tooltips":[{"zh":"解锁决议：建造爆发增殖式真菌型住宅单元","en":"Unlocks Decision: Construct Explosive Fungiform Housing Units"}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"auth_machine_intelligence","value":true,"label":{"zh":"机械智能","en":"Machine Intelligence"}}],[{"type":"identity","key":"is_individual_machine","value":true}]],"sets":["city_of_bones_completed"]},{"key":"ancrel.2043.c.evopred","label":{"zh":"凿骨吸随。","en":"Crack open those bones and drink the marrow."},"responses":[],"tooltips":[{"zh":"解锁决议：应用组织生长刺激物","en":"Unlocks Decision: Deploy Tissue Growth Stimulants"}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"origin_evolutionary_predators","value":true,"label":{"zh":"演化猎手","en":"Evolutionary Predators"}}]],"sets":["city_of_bones_completed"]}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_1.txt","line":2457},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}}]}