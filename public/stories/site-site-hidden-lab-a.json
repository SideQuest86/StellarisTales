et":"ancrel.4078","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0018,"group":"r29691","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:64","hooks":["on_roll_failed"],"story":"event-ancrel-4078"},{"target":"ancrel.13030","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29691","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:71","hooks":["on_roll_failed"],"story":"event-ancrel-13030"},{"target":"ancrel.4006","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29691","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:90","hooks":["on_roll_failed"],"story":"event-ancrel-4006"},{"target":"ancrel.4021","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29691","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:104","hooks":["on_roll_failed"],"story":"event-ancrel-4021"}],"source":{"file":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","line":1878}},{"id":"ancrel.7001","kind":"event","title":{"zh":"探查遗址","en":"Revealing the Site"},"texts":[{"zh":"[From.Planet.GetName]冰冷的气候将这个遗址掩藏于冰雪之下。这个遗迹荒无人烟的位置也许暗示着其中的存在需要我们谨慎对待。不论里面发生过什么，有人希望尽量将其掩盖。","en":"The freezing climate of [From.Planet.GetName] has covered the site in thick layers of ice and snow. The desolate location of this site may be a hint of the need for discretion. Whatever took place here, someone wanted to keep it hidden."}],"sections":[],"image":"art/b51be10289361fe6e018.webp","hidden":false,"choices":[{"key":"DIG","label":{"zh":"继续挖！","en":"Keep digging!"},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.7002","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-hidden-lab-a"}],"source":{"file":"events/ancient_relics_arcsite_events_1.txt","line":6778}},{"id":"ancrel.7002","kind":"event","title":{"zh":"清理隧道","en":"Clearing the Tunnels"},"texts":[{"zh":"这个复合体由几个更大的地下结构以隧道网络连通而成，其中很多都已经坍塌或被冰块封堵。尽管这些隧道十分古老，其中一些仍能看出很明显的火灾的痕迹。这场火灾造成的损害十分巨大，足以使人认为这里发生过灾难性的事件，或是被人有意彻底毁坏。有一件事可以确定，这个遗址在本质上是用于与科学相关的事务。","en":"The complex consists of several larger underground structures connected with a network of tunnels, many of which are collapsed or blocked by ice. Although ancient, some of the tunnels show clear signs of fire. The damage caused by the fire is major enough to suggest a catastrophic event, or perhaps intentional destruction. One thing is sure, and that is that the purpose of this site seems to be scientific in nature."}],"sections":[],"image":"art/872246aedc238ff28ba5.webp","hidden":false,"choices":[{"key":"INTERESTING","label":{"zh":"真是有趣。","en":"Interesting."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.7004","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-hidden-lab-a"}],"source":{"file":"events/ancient_relics_arcsite_events_1.txt","line":6803}},{"id":"ancrel.7004","kind":"event","title":{"zh":"远古生物实验室","en":"Ancient Biological Lab"},"texts":[{"zh":"进一步的调查显示，这个站点的主要用途是研究与开发生物制剂。应该是由于这里开发的生物制剂意外泄露，整个建筑群已经用大火净化。对现存文物进行详细的研究，可能会发现一些线索。","en":"Further investigation reveals that the primary purpose of this site seems to have been in the research and development of biological agents. The whole complex seems to have been purged by fire, possibly as the result of the accidental release of one of the biological agents being developed here. With careful and meticulous study of the artifacts that remain, some clues may be found."}],"sections":[],"image":"art/8f8c4a7c3a5dfe3fc7f8.webp","hidden":false,"choices":[{"key":"OK","label":{"zh":"确认","en":"OK"},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.7005","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-hidden-lab-a"}],"source":{"file":"events/ancient_relics_arcsite_events_1.txt","line":6856}},{"id":"ancrel.7005","kind":"event","title":{"zh":"远古武器实验室","en":"Ancient Weapons Lab"},"texts":[{"zh":"进一步的调查显示，这个站点的主要目的是研究与开发先进的能量武器。一场事故似乎引发了一场灾难性的爆炸并摧毁了大部分场地。站点中的一座数据中心似乎还保持着相对良好的状态，也许它的数据能够带来一些有用的启示。","en":"Further investigation reveals that the primary purpose of this site seems to have been in the research and development advanced energy weapons. An accident seems to have triggered a catastrophic explosion, which eradicated most of the site. One data-center seems to be in relatively good condition, perhaps its data will yield some useful insights?"}],"sections":[],"image":"art/c6521a2bac2bb7c2248c.webp","hidden":false,"choices":[{"key":"OK","label":{"zh":"确认","en":"OK"},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_1.txt","line":6888}}]}