.8080","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29557","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:36","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8110","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29557","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:37","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"federations2.701","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29557","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:51","hooks":["on_roll_failed"],"story":"event-federations2-701"},{"target":"ancrel.4078","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0018,"group":"r29557","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:64","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.13030","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29557","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:71","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4006","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29557","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:90","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4021","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29557","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:104","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"story.5","kind":"delay","conditional":false,"delayed":true,"sourceKind":"delay","delay":[{"days":"30"}],"source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt:241","story":"origin_fear_of_the_dark"}],"source":{"file":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","line":227},"alsoIn":["event-ancrel-6151"]},{"id":"ancrel.6155","kind":"event","title":{"zh":"停战倡议组织","en":"The Armistice Initiative"},"texts":[{"zh":"对[From.Planet.GetName]的进一步挖掘的结果显示，这个废弃的基地曾经是由“停战倡议组织”建造的大型军事设施。这是一个由至少五个疆域广大并且非常先进的星际力量组成的半永久联盟，于大约75000年前活跃于星系区域。\n\n这个联盟的确切性质尚不清楚，但它似乎致力于立即结束某些长期的星系级战争。每个停战倡议成员都派遣了大量军事分遣队驻扎在这个卫星基地上。","en":"Continued excavations of the ruins on [From.Planet.GetName] have revealed that the abandoned base was once a massive military installation built by the \"Armistice Initiative.\" They were a semi-permanent alliance of at least five large and very advanced interstellar powers active in this galactic region some 75,000 years ago.\n\nThe exact nature of this alliance is unknown, but it appears to have been committed to bringing an immediate end to several long-running galactic wars. Large military contingents from each Initiative member were stationed at the base on this moon."}],"sections":[],"image":"art/e14306c024bd442a3235.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1254},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet"}},"alsoIn":["event-ancrel-6151"]},{"id":"ancrel.6160","kind":"event","title":{"zh":"交战方丙","en":"Belligerent Party C"},"texts":[{"zh":"在这个星系中被屏蔽的行星是一个正在交战的帝国的首都，停战倡议组织是正试图遏止这场战争。这个帝国的名字仍然不为人知——在迄今为止已恢复的倡议组织记录中，他们被简单地称为“交战方丙”。\n\n显然，停战倡议组织希望以交战方丙作为一个示例。在侵入他们的空间并赢得了几场艰苦战斗之后，倡议组织将丙方的母星永久地囚禁在一个能源护盾之中。他们还在在附近的卫星上建立了一座军事基地，以维持星球护盾的运行，并且提供预防遏制行动失败的临时反应部队。","en":"The shielded planet in this system was the capital of one of the warring empires the Armistice Initiative was formed to stop. This empire's name is still unknown - they are referred to simply as \"Belligerent Party C\" in all Initiative records recovered so far.\n\nApparently, the Armistice Initiative sought to make an example of Belligerent Party C. After invading their space and winning several hard-fought battles, the Initiative permanently imprisoned the homeworld of Party C behind an energy shield. A military base was established on the nearby moon to maintain the shield and act as a response force in the unlikely event of containment failure."}],"sections":[],"image":"art/80aca0711ce001dcbf46.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1280},"alsoIn":["event-ancrel-6151"]},{"id":"ancrel.6165","kind":"event","title":{"zh":"护盾生成器","en":"The Shield Generator"},"texts":[{"zh":"起初卫星基地维持了几个世纪的运行，由于没有遏制行动失败的迹象，基地的军事力量逐渐缩减。后来随着不同倡议组织成员之间的转移联盟和内讧，最终卫星基地完全荒废。\n\n自动化系统被保留在适当位置，以维护丙方的家园周围的防护罩。令人难以置信的是，直到现在，它们仍可正常工作。可惜的是，当我们的考古学家在向地下的护盾生成室挖洞时，一条关键的能量电缆被切断了。经过75000年的连续运行，防护罩已不复存在。","en":"The Initiative moon base was kept operational for several centuries, but with no signs of containment failure the forces were gradually scaled back. Shifting alliances and infighting between the various Initiative members eventually left the base completely deserted.\n\nAutomated systems were left in place to maintain the shield surrounding Party C's homeworld, and they have, incredibly, remained functional up until now. Alas, a critical power cable was severed when our archaeologists dug their way into the subterranean generator chamber. After 75,000 years of continuous operation, the shield is no more."}],"sections":[],"image":"art/50652ce2542ec8035c5c.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"archaeological_site_types:site_minigalaxy_2","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/ancient_relics_arcsite_events_2.txt:1340","story":"event-ancrel-6150"}],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1306},"alsoIn":["event-ancrel-6151"]},{"id":"archaeological_site_types:site_minigalaxy_2","kind":"site","title":{"zh":"被遗弃的都市星球","en":"Abandoned Ecumenopolis"},"texts":[{"zh":"这个古老的遗落星球已经被囚禁在一道无法穿透的能量屏障里大约有75000年之久。它曾经是一颗充满活力的都市星球，居住着数以亿计的居民，但现在街道和建筑物都被遗弃了，星球上的原初居民也都销声匿迹了。","en":"This ancient Relic World was imprisoned behind an impenetrable energy barrier for roughly 75,000 years. It must once have been a vibrant ecumenopolis home to hundreds of billions of individuals, but the streets and buildings are deserted now. None of the planet's original inhabitants remain."}],"sections":[{"zh":"这个古老的遗落星球已经被囚禁在一道无法穿透的能量屏障里大约有75000年之久。它曾经是一颗充满活力的都市星球，居住着数以亿计的居民，但现在街道和建筑物都被遗弃了，星球上的原初居民也都销声匿迹了。","en":"This ancient Relic World was imprisoned behind an impenetrable energy barrier for roughly 75,000 years. It must once have been a vibrant ecumenopolis home to hundreds of billions of individuals, but the streets and buildings are deserted now. None of the planet's original inhabitants remain."}],"image":"art/0b053481dda4b917bdff.webp","hidden":false,"choices":[],"next":[{"target":"ancrel.6170","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt:286","hooks":["stage:","stage_event"],"story":"event-ancrel-6150"},{"target":"ancrel.6175","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt:292","hooks":["stage:","stage_event"],"story":"event-ancrel-6150"},{"target":"ancrel.6180","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt:298","hooks":["stage:","stage_event"],"story":"event-ancrel-6150"},{"target":"ancrel.6185","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt:304","hooks":["stage:","stage_event"],"story":"event-ancrel-6150"},{"target":"ancrel.8000","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0002,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:2","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8001","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0011,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:3","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8002","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0011,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:4","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8003","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0011,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:5","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8010","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0002,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:2","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8011","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0011,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:3","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8