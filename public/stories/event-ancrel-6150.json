ce":"common/scripted_effects/archaeology_event_effects.txt:2","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8101","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0011,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:3","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8102","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0011,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:4","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8103","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0011,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:5","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8040","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:16","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8045","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:17","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8050","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:18","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8055","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:19","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8060","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:20","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8065","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:26","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8070","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:29","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8075","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0007,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:35","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8080","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:36","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8110","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:37","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"federations2.701","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:51","hooks":["on_roll_failed"],"story":"event-federations2-701"},{"target":"ancrel.4078","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0018,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:64","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.13030","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:71","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4006","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:90","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4021","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:104","hooks":["on_roll_failed"],"story":"archaeology-incidents"}],"source":{"file":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","line":270}},{"id":"ancrel.6170","kind":"event","title":{"zh":"失踪","en":"Disappearance"},"texts":[{"zh":"这颗星球原初人口的消失仍然是个谜。当护盾升起的时候，他们与星际帝国的其他部分隔绝，他们很可能面临大规模饥荒和国内动乱，因为他们需要竭尽全力用有限的资源来供养庞大的首都人口。\n\n然而，没有迹象表明，他们清理了城市星球的部分土地来耕种。没有任何迹象表明，在护盾升起后发生了任何重大的战斗，居民们没有遗骸、化石或其他遗留物。仿佛他们仅仅是消散在了稀薄的空气中。","en":"The disappearance of this planet's original population remains a mystery. Once the shield went up and they were isolated from the rest of their interstellar empire, they likely faced mass famine and civil unrest as they struggled to support their capital's massive population with what limited resources they had.\n\nYet there are no signs that they demolished parts of their city planet to cultivate the land. Nothing suggests that any significant fighting took place after the shield went up, and there are no remains, fossilized or otherwise, of the inhabitants. It's like they simply vanished into thin air."}],"sections":[],"image":"art/edb1471ee9ca2ab6ac76.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1376}},{"id":"ancrel.6175","kind":"event","title":{"zh":"撤离日","en":"Evacuation Day"},"texts":[{"zh":"这座被遗弃的星球城市中怪诞空旷的街道仍然没有暴露出原住民当初遭遇了什么。已经发现的一些海报和小册子提到了某种形式的“撤离日”，这些册子里面画着一些我们天文学家不认识的星系的图片：\n\n“撤离日——已经到来。尽快到离你们最近的定居中心报到，开启新的生活吧。”","en":"The eerie and empty streets of this abandoned planet-wide city still do not betray what happened to the original inhabitants. Posters and pamphlets have been discovered that mention some sort of \"Evacuation Day.\" They are typically accompanied by pictures of a galaxy that our astronomers do not recognize:\n\n\"EVACUATION DAY - TODAY IS THE DAY. REPORT TO YOUR NEAREST RELOCATION CENTER AS SOON AS POSSIBLE TO BEGIN YOUR NEW LIFE.\""}],"sections":[],"image":"art/edb1471ee9ca2ab6ac76.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1402}},{"id":"ancrel.6180","kind":"event","title":{"zh":"最终计划","en":"The Project"},"texts":[{"zh":"在“撤离日”之后整个行星被彻底废弃了，但这究竟是怎么做到的？没有任何的证据表明行星的能量屏障曾经减弱过。\n\n已经发现的线索表明，在护盾出现之前，行星上的原住民们正在进行某种大规模的研究项目。越来越多的资源和科研人员被转移到这个项目中，并且这种行为似乎在护盾产生后大大地加快了。","en":"The planet was clearly abandoned after this \"Evacuation Day\" concluded, but how? There is no evidence that the planet's energy barrier ever went down.\n\nClues have been discovered that indicate the pursuit of some sort of massive research project that predates the shield. Resources and science staff were diverted to this project in increasing numbers, and efforts appear to have greatly intensified after the shield went up."}],"sections":[],"image":"art/cacd21ca43fa3de7fdfa.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1428}},{"id":"ancrel.6185","kind":"event","title":{"zh":"微型星系","en":"Miniaturized Galaxy"},"texts":[{"zh":"经过高强度的搜索之后，我们发现了[From.Planet.GetName]原住民们的去向。在这个行星北极点附近一个高墙环绕的建筑深处，我们发现了一个遗珍，我们的考古学家确信这里面装有一个微型星系。\n\n通过某种手段，在创造了这个星系之后，遗落星球的原住民们都迁移到了里面，然后用某种不可渗透的亚空间场把星系封闭在了这个容器中。虽然我们无法干扰这个星系本身，但我们可以对它进行研究。","en":"After intense search efforts, we have discovered where the inhabitants of [From.Planet.GetName] went. Deep inside a tall fortified structure near the planet's northern pole, we found a relic that our archaeologists are convinced holds an actual miniaturized galaxy.\n\nSomehow, after creating this galaxy, the inhabitants of the Relic World all relocated there and then sealed it in this container with some kind of impervious subspace field. While we can't interfere with the galaxy itself, our scientists assure us that we can study it."}],"sections":[],"image":"art/cacd21ca43fa3de7fdfa.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"ancrel.7007","kind":"bridge","conditional":true,"delayed":false,"sourceKind":"bridge","source":"content/stories/event-ancrel-6150.json","label":{"zh":"获得遗珍“微缩星河”后：激活它（可重复）","en":"With the relic \"Miniature Galaxy\": activate it (repeatable)"},"story":"event-ancrel-6150"}],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1454},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"ancrel.7007","kind":"event","title":{"zh":"微缩星河","en":"Miniature Galaxy"},"texts":[{"zh":"微缩星河内部的时间流逝的更快，通过仔细观察其中的居民，我们可以学到许多与先进科技有关的知识。","en":"Time flows faster inside the miniature galaxy, and by carefully observing its denizens we are able to learn much when comes to advanced technologies."}],"sections":[],"image":"art/56679c6c72717a9b94ad.webp","hidden":false,"choices":[{"key":"FASCINATING","label":{"zh":"很迷人。","en":"Fascinating."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_1.txt","line":6978}},{"id":"ancrel.6151","kind":"event","title":{"zh":"屏障星球","en":"Shielded Planet"},"texts":[{"zh":"[From.GetName]散发出一道围绕着他所运行的行星的无法穿透的能量屏障。这道能量屏障的来源很难确定，但它似乎是来自于卫星贫瘠表面下深处的某个地方。\n\n在卫星上最大的一个陨石坑里，可以发现一些古代遗址，可能是出于某种军事用途的大型基地。那里可能会存在着一些关于能量屏障的答案。","en":"[From.GetName] is emitting an impenetrable energy barrier that surrounds the planet it orbits. The exact source of the barrier is difficult to pinpoint, but it appears to be coming from somewhere deep beneath the moon's barren surface.\n\nAncient ruins of what must have been a large base of some sort, possibly of a military nature, can be found inside one of the moon's largest craters. It may hold some answers."}],"sections":[],"image":"art/53283e01115c7b762068.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"archaeological_site_types:site_minigalaxy_1","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/ancient_relics_arcsite_events_2.txt:1246","story":"event-ancrel-6150"}],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1219},"sets":["minigalaxy_site_spawned"],"names":{"From.GetName":{"zh":"这颗星球","en":"this planet"}}}],"summary":{"text":"# 屏障星球 / Shielded Planet\n\n- 分类 Category：先驱者与考古 Precursors · 来源 Sources：events/ancient_relics_arcsite_events_2.txt:1171–1500（ancrel.6150–6185）；common/archaeological_site_types/02_ancient_relics_arc_sites.txt:227、270；common/relics/relics.txt:239、309；common/on_actions/00_on_actions.txt:1154–1155；common/solar_system_initializers/ancient_relics_initializers.txt:5 · DLC：《远古遗物》Ancient Relics · 审阅 Reviewed 2026-10-13\n\n## 如何开始 How it starts\n\n一个特殊星系（星系初始化器 relic_system_1，common/solar_system_initializers/ancient_relics_initializers.txt:5）里有一颗被无法穿透的能量屏障包住的行星（标志 minigalaxy_planet）和它的卫星（标志 minigalaxy_moon）。勘察这两个天体之一时，on_survey_planet（common/on_actions/00_on_actions.txt:1154–1155）触发 6150（先勘察行星：小型文物，并把卫星标为已勘察）或 6151（先勘察卫星），二者都设置全局标志 minigalaxy_site_spawned 并在卫星上创建遗址 site_minigalaxy_1。\n\nA special system (initializer relic_system_1, common/solar_system_initializers/ancient_relics_initializers.txt:5) holds a planet wrapped in an impenetrable energy barrier (flag minigalaxy_planet) and its moon (flag minigalaxy_moon). Surveying one of them fires, via on_survey_planet (common/on_actions/00_on_actions.txt:1154-1155), 6150 (planet first: a small artifact and the moon is marked surveyed) or 6151 (moon first); both set the global flag minigalaxy_site_spawned and create the site site_minigalaxy_1 on the moon.\n\n## 剧情脉络 Story outline\n\n第一个遗址“卫星基地”（site_minigalaxy_1，三阶段）：6155 停战倡议组织（废弃基地属于一个半永久的军事联盟）→ 6160 交战方丙（被屏障的行星是其中一个交战帝国的首都）→ 6165 护盾生成器（基地维持了数个世纪，之后各方内斗；获得科技“古物过载器”25%、工程学研究，并在行星上创建第二个遗址 site_minigalaxy_2）。\n\n第二个遗址“被遗弃的都市星球”（四阶段）：6170 失踪（被屏障隔绝75000年，居民失踪）→ 6175 撤离日 → 6180 最终计划 → 6185 微缩星河（极北的堡垒里的遗珍：原居民去了哪里；获得遗珍“微缩星河” r_galaxy，大型文物）。\n\n遗珍可以激活：ancrel.7007“微缩星河”（时间在内部流逝得更快，观察居民获得三类研究）。\n\nFirst site \"Moon Base\" (site_minigalaxy_1, three stages): 6155 The Armistice Initiative (a semi-permanent military alliance) -> 6160 Belligerent Party C (the shielded planet was a warring empire's capital) -> 6165 The Shield Generator (the base was kept for centuries, then infighting; archaeo-overcharger tech 25%, engineering research, and the second site site_minigalaxy_2 is created on the planet).\n\nSecond site \"Abandoned Ecumenopolis\" (four stages): 6170 Disappearance (isolated for 75,000 years, the population gone) -> 6175 Evacuation Day -> 6180 The Project -> 6185 Miniaturized Galaxy (a relic in a fortified structure at the north pole shows where they went; the relic r_galaxy and a large artifact).\n\nThe relic can be activated: ancrel.7007 \"Miniature Galaxy\" (time runs faster inside; observing its denizens gives all three research types).\n\n## 分支与结局 Branches and outcomes\n\n- 掷骰失败时使用通用事件池 all_random_events（见“考古遗址：发掘意外”）。 / Failed rolls use the generic pool all_random_events (see \"Archaeological Sites: excavation incidents\").\n- 6155–6185 每个阶段的选项都只有一个“好奇”，没有分支。 / The stages 6155-6185 each have a single \"Curious\" option and no branches.\n\n## 条件与文明差异 Conditions and variants\n\n- 无。 / None.\n\n## 审阅记录 Review notes\n\n- 已核对：ancrel.6150、6151、6155–6185 的脚本，两个遗址定义，初始化器 relic_system_1 的标志，r_galaxy 遗珍与 ancrel.7007，on_survey_planet 调用点；中英文正文已读。\n- Checked: the scripts of ancrel.6150, 6151, 6155-6185, both site definitions, the flags in the initializer relic_system_1, the relic r_galaxy and ancrel.7007, and the on_survey_planet call site; both languages read.\n- 修正：原先 event-ancrel-6150 与 event-ancrel-6151 是两个几乎一样的重复故事，event-ancrel-7007 是孤立的一张卡；现合并为一个故事，6150/6151 标为互斥的两个入口，7007 作为遗珍激活并入。\n- Fix: event-ancrel-6150 and event-ancrel-6151 were two near-identical duplicate stories and event-ancrel-7007 an orphan card; they are merged into one story with 6150/6151 as exclusive entries and 7007 as the relic activation.\n","path":"summaries/event-ancrel-6150.md"}}