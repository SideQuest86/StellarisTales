],"story":"archaeology-incidents"},{"target":"ancrel.8060","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:20","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8065","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:26","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8070","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:29","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8075","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0007,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:35","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8080","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:36","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8110","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:37","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"federations2.701","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:51","hooks":["on_roll_failed"],"story":"event-federations2-701"},{"target":"ancrel.4078","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0018,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:64","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.13030","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:71","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4006","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:90","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4021","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29565","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:104","hooks":["on_roll_failed"],"story":"archaeology-incidents"}],"source":{"file":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","line":270},"alsoIn":["event-ancrel-6151"]},{"id":"ancrel.6170","kind":"event","title":{"zh":"失踪","en":"Disappearance"},"texts":[{"zh":"这颗星球原初人口的消失仍然是个谜。当护盾升起的时候，他们与星际帝国的其他部分隔绝，他们很可能面临大规模饥荒和国内动乱，因为他们需要竭尽全力用有限的资源来供养庞大的首都人口。\n\n然而，没有迹象表明，他们清理了城市星球的部分土地来耕种。没有任何迹象表明，在护盾升起后发生了任何重大的战斗，居民们没有遗骸、化石或其他遗留物。仿佛他们仅仅是消散在了稀薄的空气中。","en":"The disappearance of this planet's original population remains a mystery. Once the shield went up and they were isolated from the rest of their interstellar empire, they likely faced mass famine and civil unrest as they struggled to support their capital's massive population with what limited resources they had.\n\nYet there are no signs that they demolished parts of their city planet to cultivate the land. Nothing suggests that any significant fighting took place after the shield went up, and there are no remains, fossilized or otherwise, of the inhabitants. It's like they simply vanished into thin air."}],"sections":[],"image":"art/edb1471ee9ca2ab6ac76.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1376},"alsoIn":["event-ancrel-6151"]},{"id":"ancrel.6175","kind":"event","title":{"zh":"撤离日","en":"Evacuation Day"},"texts":[{"zh":"这座被遗弃的星球城市中怪诞空旷的街道仍然没有暴露出原住民当初遭遇了什么。已经发现的一些海报和小册子提到了某种形式的“撤离日”，这些册子里面画着一些我们天文学家不认识的星系的图片：\n\n“撤离日——已经到来。尽快到离你们最近的定居中心报到，开启新的生活吧。”","en":"The eerie and empty streets of this abandoned planet-wide city still do not betray what happened to the original inhabitants. Posters and pamphlets have been discovered that mention some sort of \"Evacuation Day.\" They are typically accompanied by pictures of a galaxy that our astronomers do not recognize:\n\n\"EVACUATION DAY - TODAY IS THE DAY. REPORT TO YOUR NEAREST RELOCATION CENTER AS SOON AS POSSIBLE TO BEGIN YOUR NEW LIFE.\""}],"sections":[],"image":"art/edb1471ee9ca2ab6ac76.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1402},"alsoIn":["event-ancrel-6151"]},{"id":"ancrel.6180","kind":"event","title":{"zh":"最终计划","en":"The Project"},"texts":[{"zh":"在“撤离日”之后整个行星被彻底废弃了，但这究竟是怎么做到的？没有任何的证据表明行星的能量屏障曾经减弱过。\n\n已经发现的线索表明，在护盾出现之前，行星上的原住民们正在进行某种大规模的研究项目。越来越多的资源和科研人员被转移到这个项目中，并且这种行为似乎在护盾产生后大大地加快了。","en":"The planet was clearly abandoned after this \"Evacuation Day\" concluded, but how? There is no evidence that the planet's energy barrier ever went down.\n\nClues have been discovered that indicate the pursuit of some sort of massive research project that predates the shield. Resources and science staff were diverted to this project in increasing numbers, and efforts appear to have greatly intensified after the shield went up."}],"sections":[],"image":"art/cacd21ca43fa3de7fdfa.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1428},"alsoIn":["event-ancrel-6151"]},{"id":"ancrel.6185","kind":"event","title":{"zh":"微型星系","en":"Miniaturized Galaxy"},"texts":[{"zh":"经过高强度的搜索之后，我们发现了[From.Planet.GetName]原住民们的去向。在这个行星北极点附近一个高墙环绕的建筑深处，我们发现了一个遗珍，我们的考古学家确信这里面装有一个微型星系。\n\n通过某种手段，在创造了这个星系之后，遗落星球的原住民们都迁移到了里面，然后用某种不可渗透的亚空间场把星系封闭在了这个容器中。虽然我们无法干扰这个星系本身，但我们可以对它进行研究。","en":"After intense search efforts, we have discovered where the inhabitants of [From.Planet.GetName] went. Deep inside a tall fortified structure near the planet's northern pole, we found a relic that our archaeologists are convinced holds an actual miniaturized galaxy.\n\nSomehow, after creating this galaxy, the inhabitants of the Relic World all relocated there and then sealed it in this container with some kind of impervious subspace field. While we can't interfere with the galaxy itself, our scientists assure us that we can study it."}],"sections":[],"image":"art/cacd21ca43fa3de7fdfa.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1454},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet"}},"alsoIn":["event-ancrel-6151"]}]}