mmon/scripted_effects/first_contact_effects.txt:33","story":"event-first-contact-1105"},{"target":"first_contact.1110","kind":"option","conditional":true,"delayed":true,"sourceKind":"option","group":"c4","delay":[{"days":"30","random":"5"}],"when":[[[{"type":"other","key":"exists","arg":"reverse_first_contact","scope":"","value":true}]],[[{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_crew","scope":"","value":true},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_no_crew","scope":"","value":false},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_vivisection","scope":"","value":false}],[{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_crew_easy","scope":"","value":true},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_no_crew","scope":"","value":false},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_vivisection","scope":"","value":false}],[{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_crew_hard","scope":"","value":true},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_no_crew","scope":"","value":false},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_vivisection","scope":"","value":false}]]],"source":"common/scripted_effects/first_contact_effects.txt:45","story":"event-first-contact-1110"}],"terminal":false,"when":[[{"type":"identity","key":"ethic_spiritualist","value":false,"label":{"zh":"唯心主义","en":"Spiritualist"}}]]}],"next":[],"source":{"file":"events/first_contact_NPC_country_types_events.txt","line":1093},"body":[{"pieces":[{"text":0}],"when":[[{"type":"identity","key":"ethic_gestalt_consciousness","value":true,"label":{"zh":"格式塔意识","en":"Gestalt Consciousness"}}]]},{"pieces":[{"text":1}],"when":[[{"type":"identity","key":"ethic_spiritualist","value":true,"label":{"zh":"唯心主义","en":"Spiritualist"}}]]},{"pieces":[{"text":2}],"when":[[{"type":"identity","key":"ethic_gestalt_consciousness","value":false,"label":{"zh":"格式塔意识","en":"Gestalt Consciousness"}},{"type":"identity","key":"ethic_spiritualist","value":false,"label":{"zh":"唯心主义","en":"Spiritualist"}}]]}],"names":{"Root.Owner.GetName":{"zh":"我们帝国","en":"our empire","note":{"zh":"游戏里这里会出现你的帝国名称。","en":"In the game, your empire's name appears here."}},"This.ContactCountry.GetName":{"zh":"未知天体","en":"unknown object","note":{"zh":"游戏里这里会出现这个未知天体的代称。","en":"In the game, the working name of this unknown object appears here."}}},"notes":[{"zh":"审阅注：两个选项（灵性者 / 其他）都启用同一个研究项目 CLOUDS_PROJECT 并结束首次接触，仅措辞不同。","en":"Review note: both options (spiritualist / others) enable the same CLOUDS_PROJECT and finish first contact; only the wording differs.","kind":"review"}]},{"id":"special_projects:CLOUDS_PROJECT","kind":"project","title":{"zh":"云研究","en":"Cloud Study"},"texts":[{"zh":"指派一个科学部门收集并整理虚空之云的相关数据。","en":"Task a science department with collecting and collating data relating to the Void Clouds."}],"sections":[],"image":"art/63a2a8805384dfff0104.webp","hidden":false,"choices":[],"next":[{"target":"story.405","kind":"project","conditional":false,"delayed":false,"sourceKind":"project","source":"common/special_projects/00_projects_2.txt:589","hooks":["on_success"],"story":"event-first-contact-critters-85"}],"source":{"file":"common/special_projects/00_projects_2.txt","line":577}},{"id":"story.405","kind":"event","title":{"zh":"虚空渐晰","en":"Void Unclouded"},"texts":[{"zh":"虚空之云可能是宇宙中最古老的存在之一。在宇宙中刚开始形成物质之后仅仅数十亿年里，它们似乎就已经出现了，这是年轻宇宙用强大的力量凭空创造出来的产物，它们本可以成为恒星，但却没有。\n\n它们动物般的智慧可能更加难以解释，但答案或许就在维持其形态的强大电磁场中——另一个宇宙诞生之初的产物。只要有足够长的时间，它奇怪的星尘与引力场循环完全有可能会形成类似神经网络或是计算机电路的东西。\n\n而且，这些虚空之云似乎在互相发送脉冲信号，甚至可能是在进行沟通，尽管彼此之间的距离以光年计算。我们怀疑这一现象可能与量子纠缠有关。","en":"The Void Clouds may be among the oldest entities in the universe. They seem to have originated just a scant few billion years after matter as we know it first appeared, the tremendous forces of the young cosmos making something out of nothing. They would have been stars once, but were not.\n\nExplaining their apparent animal intelligence is more difficult, but the answer might lie in the abnormally strong electromagnetic fields that keep them together - another product of their primordial beginnings. It is not inconceivable that, given enough time, the circulation of its strange stardust and gravitic fields aligned in a flexible approximation of neural pathways or computational circuits.\n\nMoreover, the Clouds seem to be receiving impulses from one another, if not outright communicating, lightyears apart. Quantum entanglement is suspected to play a role in this phenomenon."},{"zh":"虚空之云是宇宙的观察者，在了解了虚空之云的特征之后，[Root.GetSpeciesAdj]的宇航员在宇宙各地都发现了虚空之云的踪迹。\n\n它们产生于万物初始的时候，观察着恒星闪耀、行星新生。现在它们在宇宙间漫无目的地移动着，似乎在有意识地收集过去留下的残骸，在死去的恒星和破碎的世界之间漂流。\n\n它们的存在时刻提醒着我们自己是多么的渺小。","en":"The Void Clouds are stewards of the cosmos. Once [Root.GetSpeciesAdj] astronomers knew what to look for, they found traces of the Void Clouds everywhere.\n\nFormed at the dawn of creation, they stood watch as stars were lit and young planets formed. Now they drift, quasi-conscious agglomerations of inanimate matter from the earliest hours of time itself, afloat between dying stars and breaking worlds.\n\nThey are a constant reminder that we are but all small parts of something greater."},{"zh":"目前，[Root.GetSpeciesAdj]的研究者认为虚空之云是宇宙中最古老的存在，它们似乎是在宇宙诞生仅仅几十亿年后出现的，这是年轻宇宙用强大的力量凭空创造出来的产物，它们本可以成为恒星，但却没有。\n\n想要解释它们那种原始的动物本能更是困难，但答案的关键可能就在将它们紧密结合在一起的异常强大的电磁场中——这也是在它们出现的时候就存在的东西。可以预见，只要有足够的时间，它奇怪的星尘和引力场循环将会变得和神经回路一样。\n\n还有，尽管彼此之间相距数光年的距离，虚空之云似乎在互相发送脉冲波，这之中可能存在量子纠缠的现象。","en":"The Void Clouds are, as far as [Root.GetSpeciesAdj] researchers can tell, among the oldest entities in the universe. They seem to have originated just a scant few billion years after matter as we know it first appeared, the tremendous forces of the young cosmos making something out of nothing. They would have been stars once, but were not.\n\nExplaining their apparent animal intelligence is more difficult, but the answer might lie in the abnormally strong electromagnetic fields that keep them together - another product of their primordial beginnings. It is not inconceivable that, given enough time, the circulation of its strange stardust and gravitic fields aligned in a flexible approximation of neural pathways.\n\nMoreover, the Clouds seem to be receiving impulses from one another, if not outright communicating, lightyears apart. Quantum entanglement is suspected to play a role in this phenomenon."}],"sections":[],"image":"art/181712172bc63128316e.webp","hidden":false,"choices":[{"key":"story.405.b","label":{"zh":"它们休想阻止我们。","en":"They will not stand in our way."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false},{"key":"story.405.a.spiri","label":{"zh":"保持谦卑。","en":"Humbling."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/story_events.txt","line":3200},"body":[{"pieces":[{"text":0}],"when":[[{"type":"identity","key":"ethic_gestalt_consciousness","value":true,"label":{"zh":"格式塔意识","en":"Gestalt Consciousness"}}]]},{"pieces":[{"text":1}],"when":[[{"type":"identity","key":"ethic_spiritualist","value":true,"label":{"zh":"唯心主义","en":"Spiritualist"}}]]},{"pieces":[{"text":2}],"when":[[{"type":"identity","key":"ethic_spiritualist","value":false,"label":{"zh":"唯心主义","en":"Spiritualist"}},{"type":"identity","key":"ethic_gestalt_consciousness","value":false,"label":{"zh":"格式塔意识","en":"Gestalt Consciousness"}}]]}],"names":{"Root.GetSpeciesAdj":{"zh":"帝国","en":"imperial","note":{"zh":"游戏里这里会出现你的帝国的形容词。","en":"In the game, your empire's adjective appears here."}}},"ending":{"label":{"zh":"结局：虚空云散","en":"Ending: void unclouded"},"note":{"zh":"项目完成：永久“云狩猎加成”和“虚空回路”修正。","en":"Project: permanent cloud-hunting buff and void-loops modifier."}}}],"summary":{"text":"# 虚空之云 / Void Clouds\n- 分类 Category：文明纪事 Society (C7) · 首次接触阶段链 first-contact stage chain（虚空云 void_clouds_stage_1/2）\n\n## 如何开始 How it starts\n\n与云类国家（cloud）首次相遇，启动 void_clouds_stage_1（难度3）。/ Meeting a cloud-type country starts void_clouds_stage_1.\n\n## 剧情脉络 Story outline\n\n1. **活着的太空碎片？（80）**：无法确认这团星尘是否为生命；→ 第二阶段（难度3）。/ Living space debris? — we must be missing something.\n2. **虚空云（85）**：充满未知电荷的粒子云；两个措辞不同的选项都启用 CLOUDS_PROJECT（1500 物理）并结束首次接触 → **405**。/ Void clouds; both options enable CLOUDS_PROJECT → 405.\n\n## 分支与结局 Branches and outcomes\n\n线性。结尾选项调用 finish_first_contact_effect（建立通讯/结束首次接触）。 / Linear. The ending options call finish_first_contact_effect (first contact ends).\n\n## 条件与文明差异 Conditions and variants\n\n85 的描述随格式塔/灵性变化。/ 85’s text varies with ethics.\n\n## 审阅记录 Review notes\n\n- 审阅 Reviewed：2026-10-13（c7b-society）\n- 来源 Sources：`events/first_contact_NPC_country_types_events.txt:1070–1163` · `common/first_contact/01_first_contact_space_fauna_and_NPCs.txt:373–411` · `common/special_projects/00_projects_2.txt:578–594`\n- 已核对 Checked：80、85、story.405、项目与阶段。/ Events, project, stages.\n- 审阅改动 Changes：并 80 入 85 篇。/ 80 joined 85.\n","path":"summaries/event-first-contact-critters-85.md"}}