":"","value":true}]],[[{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_crew","scope":"","value":true},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_no_crew","scope":"","value":false},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_vivisection","scope":"","value":false}],[{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_crew_easy","scope":"","value":true},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_no_crew","scope":"","value":false},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_vivisection","scope":"","value":false}],[{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_crew_hard","scope":"","value":true},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_no_crew","scope":"","value":false},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_vivisection","scope":"","value":false}]]],"source":"common/scripted_effects/first_contact_effects.txt:45","story":"event-first-contact-1110"}],"terminal":false}],"next":[],"source":{"file":"events/first_contact_events.txt","line":7634}},{"id":"special_projects:OCTOPODES_LIGHT_PATTERNS_PROJECT","kind":"project","title":{"zh":"[encountered_country.GetSpeciesAdj]图案","en":"[encountered_country.GetSpeciesAdj] Patterns"},"texts":[{"zh":"在与[encountered_country.GetSpeciesNamePlural]的接触过程中，我们发现他们用来沟通的发光模式和进出超空间航道的漩涡之间有着惊人的相似之处。对这个问题的进一步研究可能会使我们对星系的基本组成部分有所了解。","en":"During our encounter with the [encountered_country.GetSpeciesNamePlural], we discovered some astounding similarities between the patterns of light they use to communicate and the swirls of interstellar space that make hyperlane travel possible. Investigating further into this topic may shed some light on the fundamental building blocks of the galaxy."}],"sections":[],"image":"art/eb4bbc701c9bf528ec1d.webp","hidden":false,"choices":[],"next":[{"target":"first_contact.437","kind":"project","conditional":false,"delayed":false,"sourceKind":"project","source":"common/special_projects/00_projects_nemesis.txt:89","hooks":["on_success"],"story":"event-first-contact-435"}],"source":{"file":"common/special_projects/00_projects_nemesis.txt","line":78}},{"id":"first_contact.437","kind":"event","title":{"zh":"超空间洞见","en":"Hyperlane Insights"},"texts":[{"zh":"我们对[encountered_country.GetSpeciesAdj]的漩涡状发光模式和星际空间之间的联系取得了令人惊讶的成果。似乎[encountered_country.GetSpeciesNamePlural]的发光规则在其不知道的情况下，竟与超空间随着时间的推移而流动的规则暗合，只是规模差别很大。\n\n之后，通过研究[encountered_country.GetSpeciesNamePlural]，我们将能够更好地预测超空间的流动，这将极大地扩展我们的传感器的探测范围。","en":"Our study into connections between patterns observed in interstellar space and the [encountered_country.GetSpeciesAdj] swirls of light has unearthed surprising results. It seems that the rules by which the [encountered_country.GetSpeciesNamePlural] make their light patterns are - unbeknownst to them, apparently - the same as those by which the flows of hyperlane space drift over time, just on a vastly different scale.\n\nIt follows that, through studying the [encountered_country.GetSpeciesNamePlural], we will be able to better predict the flows of hyperlane space - significantly boosting our potential sensor range."}],"sections":[],"image":"art/eb4bbc701c9bf528ec1d.webp","hidden":false,"choices":[{"key":"first_contact.437.A","label":{"zh":"我们面前打开了一个新世界。","en":"We are now open to new possibilities."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/first_contact_events.txt","line":7670}}]}