contact_stage","arg":"default_end_stage_hostile_with_crew_easy","scope":"","value":true},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_no_crew","scope":"","value":false},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_vivisection","scope":"","value":false}],[{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_crew_hard","scope":"","value":true},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_no_crew","scope":"","value":false},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_vivisection","scope":"","value":false}]]],"source":"common/scripted_effects/first_contact_effects.txt:45","story":"event-first-contact-1110"}],"terminal":false}],"next":[],"source":{"file":"events/first_contact_events.txt","line":6711},"names":{"This.ContactCountry.GetName":{"zh":"该帝国","en":"that empire"},"This.ContactCountry.GetSpeciesNamePlural":{"zh":"该物种","en":"the species"}},"ending":{"label":{"zh":"结局：坚持后读懂光语","en":"Ending: the language of lights, by perseverance"},"note":{"zh":"无额外奖励，结束首次接触。","en":"No reward; first contact ends."}}},{"id":"first_contact.435","kind":"event","title":{"zh":"挡光板的另一侧","en":"Beyond the Light Barrier"},"texts":[{"zh":"我们的努力得到了回报，现在我们基本能够理解[This.ContactCountry.GetName]的语言并与之沟通了。他们自称[This.ContactCountry.GetSpeciesNamePlural]，并说自己从未使用过口语，取而代之的是光线交流。虽然他们过去曾经使用过文字，但其民众认为它远不如视觉语言优雅高效。他们的大脑似乎完全胜任从复杂的图案中快速得出意义的工作，因此在大多数情况下，他们更喜欢使用视觉语言的交流形式。\n\n进一步的研究中，我们惊奇地发现他们的发光模式与进出超空间航道的漩涡相似。我们的[This.Owner.GetResearchers]困惑于这种相似行为的含义，并提议对此进行深入研究。","en":"Our efforts have paid off, and we are now able to understand the light signals given off by the [This.ContactCountry.GetName] and communicate with them, at least on a rudimentary level. It appears that the [This.ContactCountry.GetSpeciesNamePlural], as they call themselves, never developed a spoken language and instead used their light displays. Though they used to use a written language, it is considered far less elegant and efficient than their visual language. Their brains seem perfectly adapted to rapidly derive meanings from even complex displays, so that they favor recordings of the latter in most cases.\n\nDuring our studies, we discovered to our surprise that their patterns of light bear an astounding similarity to the swirls of interstellar space that make hyperlane travel possible. Our [This.Owner.GetResearchers] are confused as to what this connection may mean and propose further study into the topic."}],"sections":[],"image":"art/ed3acbe442c0a6616a3e.webp","hidden":false,"choices":[{"key":"FASCINATING","label":{"zh":"很迷人。","en":"Fascinating."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"special_projects:OCTOPODES_LIGHT_PATTERNS_PROJECT","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/first_contact_events.txt:6680","story":"event-first-contact-435"},{"target":"galactic_features.387","kind":"option","conditional":true,"delayed":false,"sourceKind":"option","group":"c12981","when":[[[{"type":"other","key":"is_country_type","arg":"default","scope":"contact_country","value":false}],[{"type":"other","key":"has_first_contact_flag","arg":"hostile_first_contact_attempted","scope":"","value":true}]],[[{"type":"flag","scope":"country","name":"tiyanki_graveyard_survey","path":"","value":true}]]],"source":"common/scripted_effects/first_contact_effects.txt:178","story":"event-galactic-features-387"},{"target":"cara.1020","kind":"option","conditional":true,"delayed":false,"sourceKind":"option","group":"c12981","when":[[[{"type":"other","key":"is_country_type","arg":"default","scope":"contact_country","value":false}],[{"type":"other","key":"has_first_contact_flag","arg":"hostile_first_contact_attempted","scope":"","value":true}]],[[{"type":"other","key":"any_country","arg":"{…}","scope":"","value":true}]],[[{"type":"other","ke