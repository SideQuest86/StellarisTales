{"story":{"id":"site-broken-world-digsite","title":{"zh":"破损的大门","en":"The Broken Gates"},"category":"precursors","kind":"site","image":"art/804dd876f57361e4b183.webp","start":"archaeological_site_types:broken_world_digsite","chapters":10,"visible":true,"excerpt":{"zh":"我们在[From.Planet.GetName]的一处破损的拱顶发现了奇怪的信号。","en":"We have picked up strange signals from a broken dome on [From.Planet.GetName]."},"tree":{"root":"n0","nodes":{"n0":{"doc":null,"children":["n1"]},"n1":{"doc":"archaeological_site_types:broken_world_digsite","parent":"n0","via":{"kind":"entry"},"children":["n2"]},"n2":{"doc":"ancrel.11000","parent":"n1","via":{"hooks":["stage:","stage_event"],"kind":"stage","source":"common/archaeological_site_types/04_leviathans_arc_sites.txt:48"},"children":["n3"]},"n3":{"doc":"ancrel.11005","parent":"n2","via":{"kind":"stage","hooks":["stage"],"source":"common/archaeological_site_types/04_leviathans_arc_sites.txt"},"children":["n4"]},"n4":{"doc":"ancrel.11010","parent":"n3","via":{"kind":"stage","hooks":["stage"],"source":"common/archaeological_site_types/04_leviathans_arc_sites.txt"},"children":["n5"]},"n5":{"doc":"ancrel.11015","parent":"n4","via":{"kind":"stage","hooks":["stage"],"source":"common/archaeological_site_types/04_leviathans_arc_sites.txt"},"children":["n6"]},"n6":{"doc":"ancrel.11020","parent":"n5","via":{"option":"ancrel.11015.a","optionIndex":0,"kind":"option","source":"events/ancient_relics_arcsite_events_2.txt:7815"},"children":["n7","n8"]},"n7":{"doc":"ancrel.11035","parent":"n6","via":{"option":"ancrel.11020.b","optionIndex":1,"group":"c416","when":[[[{"type":"other","key":"any_system_planet","arg":"{…}","scope":"","value":false}]],[[{"type":"other","key":"any_fleet_in_system","arg":"{…}","scope":"","value":true}]],[[{"type":"other","key":"is_country_type","arg":"default","scope":"","value":true}]]],"kind":"option","source":"events/ancient_relics_arcsite_events_2.txt:7897"},"children":[]},"n8":{"doc":"ancrel.11025","parent":"n6","via":{"option":"ancrel.11020.b","optionIndex":1,"delay":[{"days":"10"}],"kind":"option","source":"events/ancient_relics_arcsite_events_2.txt:7965"},"children":["n9","n10"]},"n9":{"doc":"ancrel.11027","parent":"n8","via":{"option":"ancrel.11025.a","optionIndex":0,"kind":"option","source":"events/ancient_relics_arcsite_events_2.txt:8013"},"children":[]},"n10":{"doc":"ancrel.11030","parent":"n8","via":{"option":"ancrel.11025.b","optionIndex":1,"kind":"option","source":"events/ancient_relics_arcsite_events_2.txt:8039"},"children":[]}}}},"chapters":[{"id":"archaeological_site_types:broken_world_digsite","kind":"site","title":{"zh":"破损的大门","en":"The Broken Gates"},"texts":[{"zh":"我们在[From.Planet.GetName]的一处破损的拱顶发现了奇怪的信号。","en":"We have picked up strange signals from a broken dome on [From.Planet.GetName]."}],"sections":[{"zh":"我们在[From.Planet.GetName]的一处破损的拱顶发现了奇怪的信号。","en":"We have picked up strange signals from a broken dome on [From.Planet.GetName]."}],"image":"art/804dd876f57361e4b183.webp","hidden":false,"choices":[],"next":[{"target":"ancrel.11000","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/04_leviathans_arc_sites.txt:48","hooks":["stage:","stage_event"],"story":"site-broken-world-digsite"},{"target":"ancrel.8000","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0002,"group":"r29802","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:2","hooks":["on_roll_failed"],"story":"event-ancrel-8000"},{"target":"ancrel.8001","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0011,"group":"r29802","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:3","hooks":["on_roll_failed"],"story":"event-ancrel-8001"},{"target":"ancrel.8002","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0011,"group":"r29802","modified":true,"source":"common/scripted_effects/archaeolog