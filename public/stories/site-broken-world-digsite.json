:true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29802","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:36","hooks":["on_roll_failed"],"story":"event-ancrel-8080"},{"target":"ancrel.8110","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29802","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:37","hooks":["on_roll_failed"],"story":"event-ancrel-8110"},{"target":"federations2.701","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29802","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:51","hooks":["on_roll_failed"],"story":"event-federations2-701"},{"target":"ancrel.4078","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0018,"group":"r29802","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:64","hooks":["on_roll_failed"],"story":"event-ancrel-4078"},{"target":"ancrel.13030","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29802","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:71","hooks":["on_roll_failed"],"story":"event-ancrel-13030"},{"target":"ancrel.4006","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29802","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:90","hooks":["on_roll_failed"],"story":"event-ancrel-4006"},{"target":"ancrel.4021","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29802","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:104","hooks":["on_roll_failed"],"story":"event-ancrel-4021"},{"target":"story.5","kind":"delay","conditional":false,"delayed":true,"sourceKind":"delay","delay":[{"days":"30"}],"source":"common/archaeological_site_types/04_leviathans_arc_sites.txt:43","story":"origin_fear_of_the_dark"}],"source":{"file":"common/archaeological_site_types/04_leviathans_arc_sites.txt","line":3},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"ancrel.11000","kind":"event","title":{"zh":"第一层","en":"The First Layer"},"texts":[{"zh":"这座废墟看起来至少有成百上千年那么陈旧了。起初它看起来只是一个大型露天建筑，不过随着对外部结构发掘的深入，我们很快发现这只是一座城市中被废弃的贫民窟。有一座巨大的大门阻挡了我们深入城市的去路，我们的科学家猜想这个社会分为了数个阶层，而建筑的每一层分别居住着这座城市一个阶层的人。\n\n我们的科学家很快就在这座地下废墟破碎的混凝土地面下发现了外星人的遗骸。然而在找到第一具遗骸过后，我们很快发现贫民窟里到处都是遗骸，有的横尸街头，有的死在家中，有的从天花板上高高地悬挂下来。虽然不知道是谁干的，但真的是一副相当令人反胃的场景。","en":"The ruins seem to be centuries, if not millennia, old. At first it seems to be only a large open-air dome, but as we are excavating the outermost parts we quickly find ourselves in what appears to be the derelict slums of a city. As a large gate blocks our progress deeper into the city, our scientists speculate that it is split into a hierarchy, each layer holding one class of the people of the city.\n\nIt does not take long before one of our scientists finds alien remains in subterranean ruins under the broken concrete floor. After the first corpse is found, however, we start finding remains all over the slums, be it in the streets, in what would have been their homes, or hanging from the most remote parts of the ceiling. It is unclear what killed them, but it is a grisly sight."}],"sections":[],"image":"art/ed5834af7a2302717b7e.webp","hidden":false,"choices":[{"key":"ancrel.11000.a","label":{"zh":"那么其他层里又为我们隐藏着什么呢？","en":"What do the other layers have in store for us?"},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.11005","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/04_leviathans_arc_sites.txt","hooks":["stage"],"story":"site-broken-world-digsite"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":7710}},{"id":"ancrel.11005","kind":"event","title":{"zh":"第二层","en":"The Second Layer"},"texts":[{"zh":"第一个圈子似乎是由流浪汉和贫民们摇摇欲坠的窝棚组成，而第二个圈子则与[Root.GetAdj]市政规划观念有很多一致之处。\n\n我们发现了几个我们的科学家认为曾经是集市的开放广场，但因为年深日久，所有东西都早已腐朽到无法辨认它可能是什么的地步。\n\n之后不久，我们也开始在圆顶的这一部分发现值得注意的遗迹。此处居民尸骸遍地，其死亡方式似乎与他们那些穷邻居差不多。","en":"Whereas the first circle seemingly consisted of the ramshackle dwellings of the outcast and destitute, this second circle has more in common with the [Root.GetAdj] notion of proper urban planning.\n\nWe find several open squares our scientists assume used to be marketplaces, though anything from back then has long since decayed to the point where it is impossible to make out what it might have been.\n\nIt does not take long before we start finding unusual remains in this part of the dome too. They seem to have perished in much the same way as their poorer neighbors, and we find the dead strewn all over."}],"sections":[],"image":"art/d47236d81da9c8a331fc.webp","hidden":false,"choices":[{"key":"ancrel.11005.a","label":{"zh":"又是惨烈的一幕。","en":"Yet another brutal sight."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.11010","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/04_leviathans_arc_sites.txt","hooks":["stage"],"story":"site-broken-world-digsite"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":7736}},{"id":"ancrel.11010","kind":"event","title":{"zh":"第三层","en":"The Third Layer"},"texts":[{"zh":"当进入第三层的大门最终打开后，我们的科学家们——带着对下一步的发现的好奇——鱼贯而入，而这里很快被确认为是该穹顶古建筑中的一个更富有的区域。我们可就此对从这座城市可能获得的发现做出更积极的期望。\n\n进入这一层后不久，我们中的一个人突然转身，野蛮地袭击了一位同事。当该袭击者被制服时，受害者已经死在地上。此后，那位发疯的科学家一直胡言乱语，我们完全无法理解他们身上到底发生了什么。\n\n这一层比前两层都小，很可能是我们到达圆顶中心之前的最后一层。只剩下一扇门了。","en":"When the gate into the third layer finally opens, our scientists - curious about what they will find next - flood into what is soon identified as a yet wealthier region of the old dome. At this point we can make confident assumptions about what to expect from this city.\n\nShortly after we enter the layer, one of our people suddenly turns around and savagely attacks a colleague. The victim is already dead on the ground by the time the unexpected assailant is restrained. In the aftermath we are completely unable to get anything sensible out of the crazed scientist, and get no better understanding of what happened to them.\n\nThis layer is significantly smaller than either of the previous two, and it is most likely the final one before we reach the center of the dome. Only one gate remains."}],"sections":[],"image":"art/a9f01cae00b9958d387f.webp","hidden":false,"choices":[{"key":"ancrel.11010.a","label":{"zh":"我们的科学家随时准备探索最后一层。","en":"Our scientists stand ready to check the final layer."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.11015","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/04_leviathans_arc_sites.txt","hooks":["stage"],"story":"site-broken-world-digsite"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":7762}},{"id":"ancrel.11015","kind":"event","title":{"zh":"最后一层","en":"The Final Layer"},"texts":[{"zh":"当最后一扇门开启时，强烈的灵能波冲击着我们的科学家。他们中的大多数在剧烈的痛苦中崩溃了，最终只有少数人进入了这一层。\n\n这一层似乎是一座大寺庙，中间有一个巨大的祭台或祭坛。墙上到处都是描绘不同恒星系的巨大图表，一个重复的图表似乎围绕着[Root.System.GetName]本身。\n\n幸存为数不多的的几位科学家向中央靠拢，他们发现这实际上是一台打造成古老祭坛形式的雄伟机器。","en":"As soon as the final gate opens up, waves of intense psionic energy wash upon our scientists. Most of them collapse in apparent agony, leaving only a few to make their way into the actual layer itself.\n\nIt seems to be a large temple, with a massive dais or altar in the middle of it. All across the walls there are huge diagrams of different star systems, and a repeated one seems to center on [Root.System.GetName] itself.\n\nMaking their way closer to the middle, the few scientists that remain find that it is in fact an imposing machine fashioned in the form of an old altar."}],"sections":[],"image":"art/e1d588dfab7da33fe5bf.webp","hidden":false,"choices":[{"key":"ancrel.11015.a","label":{"zh":"让我们修一下这台机器，看看能发现什么。","en":"Let us tinker with this machine and see what we can find."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"ancrel.11020","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/ancient_relics_arcsite_events_2.txt:7815","story":"site-broken-world-digsite"}],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":7788},"names":{"Root.System.GetName":{"zh":"这个星系","en":"this system"}}},{"id":"ancrel.11020","kind":"event","title":{"zh":"长者","en":"The Elder One"},"texts":[{"zh":"当修理工作开始时，他们突然被一种共同的幻觉所困扰——一个正被挖出并解封的存在，尖啸着发出命令。尖啸越发刺耳，一个生物撕开[From.System.GetName]星系的景象在他们的脑海中反复上演。几位科学家不省人事，无法应对这种持续折磨他们身体疼痛。","en":"As they start tinkering with the machine, they are suddenly beset by a shared auditory hallucination - a screaming command by something to be unearthed, unshackled. Visions of a creature ripping apart the [From.System.GetName] system plays repeatedly in their heads as the creature's demands grow shriller. Several scientists fall unconscious, unable to deal with the unabating torrents of pain that rack their bodies."}],"sections":[],"image":"art/8f074413f235d7238af7.webp","hidden":false,"choices":[{"key":"ancrel.11020.a","label":{"zh":"拆了这台机器，以免造成更多的伤害！","en":"Rip the machine apart before it can cause any more harm!"},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false},{"key":"ancrel.11020.b","label":{"zh":"放它出来！","en":"LET IT OUT!"},"responses":[],"tooltips":[{"zh":"一个诡异之魇将被释放到[eldritch_location.GetName]恒星系中。","en":"An Eldritch Horror will be released in the [eldritch_location.GetName] system."}],"conditional":false,"next":[{"target":"ancrel.11035","kind":"option","conditional":true,"delayed":false,"sourceKind":"option","group":"c416","when":[[[{"type":"other","key":"any_system_planet","arg":"{…}","scope":"","value":false}]],[[{"type":"other","key":"any_fleet_in_system","arg":"{…}","scope":"","value":true}]],[[{"type":"other","key":"is_country_type","arg":"default","scope":"","value":true}]]],"source":"events/ancient_relics_arcsite_events_2.txt:7897","story":"site-broken-world-digsite"},{"target":"observer.50","kind":"option","conditional":true,"delayed":false,"sourceKind":"option","group":"c416","when":[[[{"type":"other","key":"any_system_planet","arg":"{…}","scope":"","value":false}]],[[{"type":"other","key":"which","arg":"machine_worlds_destroyed","scope":"check_variable","value":true},{"type":"other","key":"value","arg":"1","scope":"check_variable","value":true}]]],"source":"common/scripted_effects/00_scripted_effects.txt:105","story":"event-observer-50"},{"target":"crisis.2037","kind":"option","conditional":true,"delayed":false,"sourceKind":"option","group":"c416","when":[[[{"type":"other","key":"any_system_planet","arg":"{…}","scope":"","value":false}]],[[{"type":"other","key":"which","arg":"machine_worlds_destroyed","scope":"check_variable","value":true},{"type":"other","key":"value","arg":"1","scope":"check_variable","value":true}]]],"source":"common/scripted_effects/00_scripted_effects.txt:108","story":"contingency"},{"target":"ancrel.11025","kind":"option","conditional":false,"delayed":true,"sourceKind":"option","delay":[{"days":"10"}],"source":"events/ancient_relics_arcsite_events_2.txt:7965","story":"site-broken-world-digsite"}],"terminal":false,"sets":["eldritch_horror_country"]}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":7824},"names":{"From.System.GetName":{"zh":"这个星系","en":"this system"}}},{"id":"ancrel.11035","kind":"event","title":{"zh":"在[eldritch_location.GetName]损失舰队","en":"Lost Fleet in [eldritch_location.GetName]"},"texts":[{"zh":"我们与我们穿越[eldritch_location.GetName]星系的舰队失去了联系。随后，我们又收到了其中恒星坍缩和一切毁灭的消息。","en":"We have lost all contact with our fleet as it was traveling through the [eldritch_location.GetName] system. Shortly afterwards, we receive news about the collapse of the star and the destruction of everything around it."}],"sections":[],"image":"art/8f074413f235d7238af7.webp","hidden":false,"choices":[{"key":"ancrel.11035.a","label":{"zh":"一场悲剧。","en":"A tragedy."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":8083}},{"id":"ancrel.11025","kind":"event","title":{"zh":"信号传输接入","en":"Incoming Transmission"},"texts":[{"zh":"终于……\n\n凡人，跪下！在我面前卑躬屈膝，我将赐予你佑护和智慧。\n\n若敢不从，我将为你带来终结！","en":"FINALLY...\n\nBOW DOWN MORTALS, GROVEL BEFORE ME, AND I SHALL GRANT YOU PROTECTION AND WISDOM.\n\nOPPOSE ME, AND I SHALL BE YOUR END!"}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"ancrel.11025.a","label":{"zh":"啊，伟大的存在！来拥抱你迷途的羊群吧！","en":"O Great One! Embrace your wayward flock!"},"responses":[],"tooltips":[{"zh":"[Root.GetName]将重建在[eldritch_location.GetName]的恒星基地","en":"[Root.GetName] will rebuild their starbase in the [eldritch_location.GetName] system."}],"conditional":false,"next":[{"target":"ancrel.11027","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/ancient_relics_arcsite_events_2.txt:8013","story":"site-broken-world-digsite"}],"terminal":false},{"key":"ancrel.11025.b","label":{"zh":"释放你们是一个错误。","en":"It was a mistake to release you."},"responses":[],"tooltips":[{"zh":"[Root.GetName]将会与诡异之魇进入敌对。","en":"[Root.GetName] will become hostile to the Eldritch Horror."}],"conditional":false,"next":[{"target":"ancrel.11030","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/ancient_relics_arcsite_events_2.txt:8039","story":"site-broken-world-digsite"}],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":7983},"names":{"Root.GetName":{"zh":"我们的帝国","en":"our empire"}}},{"id":"ancrel.11027","kind":"event","title":{"zh":"信号传输接入","en":"Incoming Transmission"},"texts":[{"zh":"尔等既选择了智慧之路。\n一切将如其之所应为。","en":"SO YOU HAVE CHOSEN THE PATH OF WISDOM.\nEVERYTHING IS AS IT SHOULD BE."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"ancrel.11027.a","label":{"zh":"一切将如您所愿，伟大的存在。","en":"It will be as you wish, Great One."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":8046}},{"id":"ancrel.11030","kind":"event","title":{"zh":"信号传输接入","en":"Incoming Transmission"},"texts":[{"zh":"尔等既选择了死亡。","en":"SO YOU HAVE CHOSEN DEATH."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"ancrel.11030.a","label":{"zh":"切断通讯。","en":"Cut the transmission."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":8064}}]}