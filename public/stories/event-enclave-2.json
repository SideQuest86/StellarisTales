other","key":"has_modifier","arg":"mercenary_fleet_size_upgrade_4","scope":"event_target:mercenary_enclave_country","value":true}]]}],"next":[],"source":{"file":"events/overlord_enclaves_events.txt","line":3017},"names":{"mercenary_enclave_country.GetName":{"zh":"该帝国","en":"that empire"}}},{"id":"enclave.2020","kind":"event","title":{"zh":"[mercenary_enclave_country.GetName]城邦支付红利","en":"The [mercenary_enclave_country.GetName] Enclave Pays Dividends"},"texts":[{"zh":"尊敬的赞助者，我们最近的维和行动成功捣毁了几个海盗组织，我们收缴了一批数量极其丰厚的资源和科技数据。同你的常规分红一起，我们将这批战利品的大部分交付给你。","en":"Esteemed Patron, our latest peacekeeping operation had us dismantle several pirate operations and we recovered an extraordinary amount of resources and technological data. Most of these have been set apart for you, in addition to your well-earned dividends."}],"sections":[],"image":"art/7d8bfb9b4eb5fb47cd5a.webp","hidden":false,"choices":[{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"other","key":"has_modifier","arg":"mercenary_fleet_size_upgrade_2","scope":"event_target:mercenary_enclave_country","value":false}]]},{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"other","key":"has_modifier","arg":"mercenary_fleet_size_upgrade_4","scope":"event_target:mercenary_enclave_country","value":false},{"type":"other","key":"has_modifier","arg":"mercenary_fleet_size_upgrade_2","scope":"event_target:mercenary_enclave_country","value":true}]]},{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"other","key":"has_modifier","arg":"mercenary_fleet_size_upgrade_4","scope":"event_target:mercenary_enclave_country","value":true}]]}],"next":[],"source":{"file":"events/overlord_enclaves_events.txt","line":3073},"names":{"mercenary_enclave_country.GetName":{"zh":"该帝国","en":"that empire"}}},{"id":"enclave.2025","kind":"event","title":{"zh":"[mercenary_enclave_country.GetName]城邦支付红利","en":"The [mercenary_enclave_country.GetName] Enclave Pays Dividends"},"texts":[{"zh":"尊敬的赞助者，公司现在处于困难时期。我们失去了好几个民用客户，并且几个其他的行动也遭遇失败，损失惨重。我们设立了一个重组计划，将会削减董事会的开销，此外我们也会向社会输送一批人才，让我们的雇员灵活就业。\n\n请放心，我们会不知疲倦地将你的分红挣回来，这样的不幸只是暂时的。","en":"Esteemed Patron, the company is going through difficult times. We lost several civilian clients, and various of our other operations ended in costly failures. We are setting up a restructuring plan that will cut expenditures across the board, and we will be letting some of our staff go.\n\nRest assured that we worked tirelessly to bring you your dividends, and that this misfortune is only temporary."}],"sections":[],"image":"art/7d8bfb9b4eb5fb47cd5a.webp","hidden":false,"choices":[{"key":"enclave.2025.a","label":{"zh":"令人失望。","en":"Disappointing."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false},{"key":"enclave.2025.b","label":{"zh":"你被解雇了。去董事会领铺盖走人吧。","en":"You're fired. See the Board about your severance package."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false},{"key":"enclave.2025.c","label":{"zh":"改让我们来帮忙吧。","en":"Let us help instead."},"responses":[],"tooltips":[],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"other","key":"has_modifier","arg":"mercenary_fleet_size_upgrade_2","scope":"event_target:mercenary_enclave_country","value":false}]],"allow":[[{"type":"other","key":"resource","arg":"energy","scope":"resource_stockpile_compare","value":true},{"type":"other","key":"value","arg":"1000","scope":"resource_stockpile_compare","value":true},{"type":"other","key":"cost","arg":"1000","scope":"nomad_can_afford_enclave_cost","value":true}]]},{"key":"enclave.2025.c","label":{"zh":"改让我们来帮忙吧。","en":"Let us help instead."},"responses":[],"tooltips":[],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"other","ke