":"events/anomaly_events_3.txt:4717","story":"anomaly-nuke-planet-cat"}],"terminal":false,"when":[[{"type":"flag","scope":"country","name":"suspected_assholes","path":"","value":true},{"type":"identity","key":"ethic_fanatic_militarist","value":true,"label":{"zh":"极端军国主义","en":"Fanatic Militarist"}},{"type":"identity","key":"ethic_spiritualist","value":false,"label":{"zh":"唯心主义","en":"Spiritualist"}},{"type":"identity","key":"ethic_pacifist","value":false,"label":{"zh":"和平主义","en":"Pacifist"}}],[{"type":"flag","scope":"country","name":"suspected_assholes","path":"","value":true},{"type":"identity","key":"ethic_fanatic_materialist","value":true,"label":{"zh":"极端唯物主义","en":"Fanatic Materialist"}},{"type":"identity","key":"ethic_spiritualist","value":false,"label":{"zh":"唯心主义","en":"Spiritualist"}},{"type":"identity","key":"ethic_pacifist","value":false,"label":{"zh":"和平主义","en":"Pacifist"}}],[{"type":"flag","scope":"country","name":"suspected_angels","path":"","value":false},{"type":"identity","key":"ethic_fanatic_militarist","value":true,"label":{"zh":"极端军国主义","en":"Fanatic Militarist"}},{"type":"identity","key":"ethic_spiritualist","value":false,"label":{"zh":"唯心主义","en":"Spiritualist"}},{"type":"identity","key":"ethic_pacifist","value":false,"label":{"zh":"和平主义","en":"Pacifist"}}],[{"type":"flag","scope":"country","name":"suspected_angels","path":"","value":false},{"type":"identity","key":"ethic_fanatic_materialist","value":true,"label":{"zh":"极端唯物主义","en":"Fanatic Materialist"}},{"type":"identity","key":"ethic_spiritualist","value":false,"label":{"zh":"唯心主义","en":"Spiritualist"}},{"type":"identity","key":"ethic_pacifist","value":false,"label":{"zh":"和平主义","en":"Pacifist"}}]]},{"key":"anomaly.4158.f","label":{"zh":"离开吧。你的命运由你自己掌控。","en":"Leave. Your fate is your own."},"responses":[],"tooltips":[],"conditional":true,"next":[{"target":"anomaly.4163","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/anomaly_events_3.txt:4727","story":"anomaly-nuke-planet-cat"}],"terminal":false,"when":[[{"type":"identity","key":"ethic_fanatic_xenophobe","value":false,"label":{"zh":"极端排外主义","en":"Fanatic Xenophobe"}}]]},{"key":"anomaly.4158.xenophobe.f","label":{"zh":"你没有利用价值。走！","en":"You are of no use to us. Leave!"},"responses":[],"tooltips":[],"conditional":true,"next":[{"target":"anomaly.4163","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/anomaly_events_3.txt:4736","story":"anomaly-nuke-planet-cat"}],"terminal":false,"when":[[{"type":"identity","key":"ethic_fanatic_xenophobe","value":true,"label":{"zh":"极端排外主义","en":"Fanatic Xenophobe"}}]]}],"next":[],"source":{"file":"events/anomaly_events_3.txt","line":4597},"dialogue":{"states":{"start":["anomaly.4158.a","anomaly.4158.b","anomaly.4158.militant.b","anomaly.4158.spiritual.b","anomaly.4158.c","anomaly.4158.d","anomaly.4158.f","anomaly.4158.xenophobe.f"]},"transitions":{},"exits":["anomaly.4158.d","anomaly.4158.f","anomaly.4158.xenophobe.f"]}},{"id":"anomaly_failure.4157","kind":"event","title":{"zh":"战场之下","en":"Beneath the Battlefield"},"texts":[{"zh":"打开[WarriorHomePlanet.GetName]上发现的容器后，我们找到了一些健康作物的样本，还有一些辅助器材，这可以让样本在肥沃条件下重新生长。我们可以用逆向工程技术研究它。","en":"Opening up the container we found on [WarriorHomePlanet.GetName] revealed it to hold samples of healthy crops, as well as instruments that would help it grow again in infertile conditions. We could reverse engineer this."},{"zh":"打开[WarriorHomePlanet.GetName]上发现的容器后，我们找到了一些健康作物的样本，还有一些辅助器材，这可以让样本在肥沃条件下重新生长。.\n\n虽然意义不大，但这个文明的文化历史数据可以让我们更了解他们的真面目。","en":"Opening up the container we found on [WarriorHomePlanet.GetName] revealed it to hold samples of healthy crops, as well as instruments that would help it grow again in infertile conditions..\n\nWhile not being that useful to us, there were also data on the civilization's culture and history, which could give us more insight into who they were."}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/failures.txt","line":379},"body":[{"pieces":[{"text":0}],"when":[[{"type":"other","key":"has_technology","arg":"tech_climate_restoration","scope":"","value":false,"label":{"zh":"气候复苏","en":"Climate Restoration"}}]]},{"pieces":[{"text":1}],"when":[[{"type":"other","key":"has_technology","arg":"tech_climate_restoration","scope":"","value":true,"label":{"zh":"气候复苏","en":"Climate Restoration"}}]]}],"names":{"WarriorHomePlanet.GetName":{"zh":"这颗星球","en":"this planet","note":{"zh":"游戏里这里会出现这颗星球的名称。","en":"In the game, the planet's name appears here."}}}},{"id":"anomaly_failure.4158","kind":"event","title":{"zh":"特殊项目失败","en":"Special Project Failed"},"texts":[{"zh":"打开[WarriorHomePlanet.GetName]上发现的容器后，我们才意识到那是一个生物武器的发射器。\n\n这种生物武器专门降低目标的生殖能力，并且扩散迅速。不过和我们的遗传因子不兼容，所以不会影响我们种群的数量。","en":"After opening the container we found on [WarriorHomePlanet.GetName] we were shocked to realize that it was a dispenser for a biological weapon!\n\nThe bio-weapon was made to target fertility functions and quickly spreads. It is however not entirely compatible with our DNA, and will not cause us to diminish in numbers."}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[{"key":"CURSES","label":{"zh":"可恶！","en":"Curses!"},"responses":[],"tooltips":[{"zh":"你的帝国获得抑制繁衍生物武器的修正。","en":"Your Empire gains the Fertility Inhibiting Bio-Weapon modifier."}],"conditional":false,"next":[],"terminal":false,"clears":["cryo_pod_planet"]}],"next":[],"source":{"file":"events/failures.txt","line":417},"names":{"WarriorHomePlanet.GetName":{"zh":"这颗星球","en":"this planet","note":{"zh":"游戏里这里会出现这颗星球的名称。","en":"In the game, the planet's name appears here."}}}},{"id":"anomaly_failure.4156","kind":"event","title":{"zh":"特殊项目失败","en":"Special Project Failed"},"texts":[{"zh":"在[WarriorHomePlanet.GetName]的地下避难所附近清除野兽时，战斗意外地导致了建筑崩塌。我们未能从残骸中回收到有价值的东西。","en":"Fighting off the beasts around the underground vault on [WarriorHomePlanet.GetName] has caused the complex to collapse. We are unable to salvage anything of value from the debris."}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[{"key":"UNFORTUNATE","label":{"zh":"真不幸。","en":"Unfortunate."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false,"clears":["cryo_pod_planet"]}],"next":[],"source":{"file":"events/failures.txt","line":344},"names":{"WarriorHomePlanet.GetName":{"zh":"这颗星球","en":"this planet","note":{"zh":"游戏里这里会出现这颗星球的名称。","en":"In the game, the planet's name appears here."}}}}],"summary":{"text":"# 末日之冬 / The Winter of the Fallen\n\n- 分类 Category：深空异闻 Exploration (C3)\n- 来源 Sources：`common/anomalies/02_anomaly_categories.txt:456-479` · `events/anomaly_events_3.txt:4277-4916 (4155-4163)` · `common/special_projects/00_projects_3.txt:478-529` · `events/failures.txt:344-453`\n- 审阅 Review：2026-10-12（c3b-exploration）· 已审阅 Reviewed\n\n## 如何开始 How it starts\n\n- 5级异常；在墓穴世界（未被标记禁用核爆世界异常的星球）上以权重3生成；格式塔帝国与拥有“纪念主义者”公民性的帝国生成权重为0。  \n  Level-5 anomaly; spawn weight 3 on tomb worlds without the nuked_planet_anomalies_disabled flag; weight 0 for gestalt empires and empires with the Memorialist civic.\n- 研究成功只有一个结果：4155“战场之下”。  \n  Success has a single outcome: 4155 \"Beneath the Battlefield\".\n\n## 剧情脉络 Story outline\n\n- 4155：山下发现地下避难所，周围有野兽。可开启项目“地下避难所”（需3艘军舰、100天）；唯心主义帝国也可选择不打扰而获得影响力。  \n  4155: a vault beneath the mountains, guarded by beasts. Start \"Underground Vault\" (3 military ships, 100 days); spiritualists may leave it be for influence.\n- 项目完成：70% 4156（进入避难所，找到一个容器），30% anomaly_failure.4156（避难所坍塌，一无所获）。  \n  Project result: 70% 4156 (a container is found), 30% anomaly_failure.4156 (the vault collapses).\n- 4156：把容器送回母星（500工程学项目“撬开它”）或只研究避难所（影响力）。  \n  4156: send the container home (500 engineering project \"Cracking it Open\") or only study the vault (influence).\n- “撬开它”完成：40% 4157 冷冻舱中苏醒的外星将军马朱拉，30% anomaly_failure.4157 作物样本（下一项地形改造科技），30% anomaly_failure.4158 生物武器（帝国获“生育抑制生物武器”修正3600天）。  \n  \"Cracking it Open\": 40% 4157 the cryopod warrior Majula awakens, 30% anomaly_failure.4157 crop samples (next terraforming tech), 30% anomaly_failure.4158 a bio-weapon (Fertility Inhibiting Bio-Weapon modifier for 3600 days).\n\n## 分支与结局 Branches and outcomes\n\n- 4157 的回答决定下一窗口：亲外/狂热唯心/和平（且非尚武、非狂热唯物）可说“你很安全”（设suspected_angels）；人人可说“你的母星已毁”；排外/尚武/狂热平等/狂热唯物可说“我们打捞了残骸”（设suspected_assholes）→ 4159。前两者 → 4158。  \n  4157's reply decides the next window: xenophile/fanatic spiritualist/pacifist empires may reassure her (suspected_angels); anyone may say her world is ruined; xenophobe/militarist/fanatic egalitarian/fanatic materialist may say \"we salvaged it\" (suspected_assholes) → 4159; the first two → 4158.\n- 4158/4159 是同一组同窗问答（关于她自己、为何被保存、她的人民），然后“你愿意加入吗？”按思潮与上述标志分为：4161 拒绝并回到母星、4160 加入（成为5级指挥官“持守者马朱拉”）、4162 挟持研究员逃跑被击毙（失去一名非研究主管的科学家）；或直接“离开吧”→ 4163 告别。  \n  4158/4159 are the same in-window Q&A; then \"Will you join us?\" resolves by ethics and the flags into 4161 refusal, 4160 she joins (a skill-5 commander \"Majula the Bearer\"), or 4162 she takes a researcher hostage and is shot (a non-head scientist dies); or \"Leave\" → 4163 farewell.\n\n## 条件与文明差异 Conditions and variants\n\n- 4161 中非和平、非亲外帝国还可选“抓住她！”（无额外效果）。  \n  In 4161 non-pacifist, non-xenophile empires may also choose \"Seize her!\" (no extra effect).\n- anomaly_failure.4157 在已拥有气候恢复科技时使用另一段文本。  \n  anomaly_failure.4157 uses another text once Climate Restoration is known.\n\n## 审阅记录 Review notes\n\n- 已核对 Checked：类别、4155–4163、两个项目、三个失败事件（含问答选项条件）。  \n  Category, 4155–4163, both projects and the three failure events, including option conditions.\n- 覆盖 Coverage：15 个文档全部核对 / all 15 docs checked.\n","path":"summaries/anomaly-nuke-planet-cat.md"}}