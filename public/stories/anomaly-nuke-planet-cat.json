{"story":{"id":"anomaly-nuke-planet-cat","title":{"zh":"末日之冬","en":"The Winter of the Fallen"},"category":"exploration","kind":"anomaly","image":"art/1847c49a9205c90405fe.webp","start":"anomalies:NUKE_PLANET_CAT","chapters":15,"visible":true,"excerpt":{"zh":"这片核废土是这里逝去文明的佐证。我们应该进一步调查那些探测器探测到的有活动迹象的地点。","en":"The nuclear wasteland is evidently a sign of a previous civilization. Our scanners are picking up activity at certain locations that we should investigate."},"tree":{"root":"n0","nodes":{"n0":{"doc":null,"children":["n1"]},"n1":{"doc":"anomalies:NUKE_PLANET_CAT","parent":"n0","via":{"kind":"entry"},"children":["n2"]},"n2":{"doc":"anomaly.4155","parent":"n1","via":{"hooks":["on_success"],"kind":"research","source":"common/anomalies/02_anomaly_categories.txt:478"},"children":["n3"]},"n3":{"doc":"special_projects:CRYOPOD_FOUND_PROJECT","parent":"n2","via":{"option":"anomaly.4155.a","optionIndex":0,"kind":"option","source":"events/anomaly_events_3.txt:4305"},"children":["n4","n5"]},"n4":{"doc":"anomaly.4156","parent":"n3","via":{"chance":0.7,"group":"r39901","hooks":["on_success"],"kind":"random","source":"common/special_projects/00_projects_3.txt:499"},"children":["n6"]},"n5":{"doc":"anomaly_failure.4156","parent":"n3","via":{"chance":0.3,"group":"r39901","hooks":["on_success"],"kind":"random","source":"common/special_projects/00_projects_3.txt:500"},"children":[]},"n6":{"doc":"special_projects:CRYOPOD_OPENING_PROJECT","parent":"n4","via":{"option":"RESEARCHIT","optionIndex":0,"kind":"option","source":"events/anomaly_events_3.txt:4358"},"children":["n7","n8","n9"]},"n7":{"doc":"anomaly.4157","parent":"n6","via":{"chance":0.4,"group":"r39902","hooks":["on_success"],"kind":"random","source":"common/special_projects/00_projects_3.txt:523"},"children":["n10","n11","n12"]},"n8":{"doc":"anomaly_failure.4157","parent":"n6","via":{"chance":0.3,"group":"r39902","hooks":["on_success"],"kind":"random","source":"common/special_projects/00_projects_3.txt:524"},"children":[]},"n