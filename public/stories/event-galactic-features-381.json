ills]雌性缇扬奇：","en":"[Root.tiyanki_cow_kills] Tiyanki Cows:"},{"zh":"[Root.tiyanki_bull_kills]雄性缇扬奇：","en":"[Root.tiyanki_bull_kills] Tiyanki Bulls:"},{"zh":"[Root.tiyanki_calf_kills]缇扬奇幼崽：","en":"[Root.tiyanki_calf_kills] Tiyanki Calves:"},{"zh":"[Root.tiyanki_hatchling_kills]缇扬奇幼体：","en":"[Root.tiyanki_hatchling_kills] Tiyanki Hatchlings:"},{"zh":"[Root.tiyanki_ox_kills]缇扬奇成年体：","en":"[Root.tiyanki_ox_kills] Tiyanki Oxen:"}],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/galactic_features_events.txt","line":3427},"names":{"tiyanki_kill_system.GetName":{"zh":"这个星系","en":"this system"}}}]}