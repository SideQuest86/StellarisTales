:false,"choices":[{"key":"FASCINATING","label":{"zh":"很迷人。","en":"Fascinating."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/cosmic_storms_events_1.txt","line":3989},"body":[{"pieces":[{"text":0},{"break":true},{"text":2,"when":[[{"type":"flag","scope":"ship","name":"event_traumatized_leader","path":"","value":true}]]}]}],"sets":["collect_alloys","collect_energy","collect_minerals","collect_multiple_resources","collect_zro","event_traumatized_leader"],"names":{"from.GetName":{"zh":"这颗星球","en":"this planet"},"leader.GetName":{"zh":"这位领袖","en":"the leader"}}},{"id":"special_projects:EYE_OF_THE_celestial_storm_PROJECT","kind":"project","title":{"zh":"风暴之眼","en":"Eye of the Storm"},"texts":[{"zh":"扫描位于[this.GetName]中的[fromfrom.GetName]，结果表明其内部漩涡中携带着大量物质。远程传感器无法对这一不寻常现象提供确凿的答案。为了增进我们的认识，需要对风暴中心进行一次实地考察。","en":"Scans of [fromfrom.GetName] in [this.GetName] suggest it is carrying a large mass within its inner vortex. Long-range sensors have been unable to provide conclusive answers about this unusual phenomenon. A field expedition into the eye of the storm is required to advance our understanding."}],"sections":[],"image":"art/d2c09b013a19edca5bd9.webp","hidden":false,"choices":[],"next":[{"target":"cstorms.1805","kind":"project","conditional":false,"delayed":false,"sourceKind":"project","source":"common/special_projects/03_projects_cosmic_storms.txt:577","hooks":["on_success"],"story":"event-cstorms-1800"}],"source":{"file":"common/special_projects/03_projects_cosmic_storms.txt","line":562}},{"id":"special_projects:EYE_OF_THE_electric_storm_PROJECT","kind":"project","title":{"zh":"风暴之眼","en":"Eye of the Storm"},"texts":[{"zh":"扫描位于[this.GetName]中的[fromfrom.GetName]，结果表明其内部漩涡中携带着大量物质。远程传感器无法对这一不寻常现象提供确凿的答案。为了增进我们的认识，需要对风暴中心进行一次实地考察。","en":"Scans of [fromfrom.GetName] in [this.GetName] suggest it is carrying a large mass within its inner vortex. Long-range sensors have been unable to provide conclusive ans