{"story":{"id":"site-site-absolute-zero","title":{"zh":"绝对零度","en":"Absolute Zero"},"category":"precursors","kind":"site","image":"art/6d22b79ad9a1c87a1cce.webp","start":"archaeological_site_types:site_absolute_zero","chapters":6,"visible":true,"excerpt":{"zh":"对[from.Planet.GetName]的地质扫描显示在一个特定的地下区域中，局部的极端温度接近绝对零度。\n\n对内部更详尽的研究将会带来更多的答案。","en":"Topographical scans of [from.Planet.GetName] show extreme temperatures approaching absolute zero localized in a particular subterranean region.\n\nA more detailed study of the interior should yield more answers."},"tree":{"root":"n0","nodes":{"n0":{"doc":null,"children":["n1"]},"n1":{"doc":"archaeological_site_types:site_absolute_zero","parent":"n0","via":{"kind":"entry"},"children":["n2","n3","n4","n5","n6"]},"n2":{"doc":"extreme_frontiers.1000","parent":"n1","via":{"hooks":["stage:","stage_event"],"kind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:26"},"children":[]},"n3":{"doc":"extreme_frontiers.1005","parent":"n1","via":{"hooks":["stage:","stage_event"],"kind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:32"},"children":[]},"n4":{"doc":"extreme_frontiers.1010","parent":"n1","via":{"hooks":["stage:","stage_event"],"kind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:38"},"children":[]},"n5":{"doc":"extreme_frontiers.1015","parent":"n1","via":{"hooks":["stage:","stage_event"],"kind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:44"},"children":[]},"n6":{"doc":"extreme_frontiers.1020","parent":"n1","via":{"hooks":["stage:","stage_event"],"kind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:50"},"children":[]}}}},"chapters":[{"id":"archaeological_site_types:site_absolute_zero","kind":"site","title":{"zh":"绝对零度","en":"Absolute Zero"},"texts":[{"zh":"对[from.Planet.GetName]的地质扫描显示在一个特定的地下区域中，局部的极端温度接近绝对零度。\n\n对内部更详尽的研究将会带来更多的答案。","en":"Topographical scans of [from.Planet.GetName] show extreme temperatures approaching absolute zero localized in a particular subterranean region.\n\nA more detailed study of the interior should yield more answers."}],"sections":[{"zh":"对[from.Planet.GetName]的地质扫描显示在一个特定的地下区域中，局部的极端温度接近绝对零度。\n\n对内部更详尽的研究将会带来更多的答案。","en":"Topographical scans of [from.Planet.GetName] show extreme temperatures approaching absolute zero localized in a particular subterranean region.\n\nA more detailed study of the interior should yield more answers."}],"image":"art/6d22b79ad9a1c87a1cce.webp","hidden":false,"choices":[],"next":[{"target":"extreme_frontiers.1000","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:26","hooks":["stage:","stage_event"],"story":"site-site-absolute-zero"},{"target":"extreme_frontiers.1005","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:32","hooks":["stage:","stage_event"],"story":"site-site-absolute-zero"},{"target":"extreme_frontiers.1010","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:38","hooks":["stage:","stage_event"],"story":"site-site-absolute-zero"},{"target":"extreme_frontiers.1015","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:44","hooks":["stage:","stage_event"],"story":"site-site-absolute-zero"},{"target":"extreme_frontiers.1020","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:50","hooks":["stage:","stage_event"],"story":"site-site-absolute-zero"},{"target":"ancrel.8000","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failu