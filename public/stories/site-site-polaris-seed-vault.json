{"story":{"id":"site-site-polaris-seed-vault","title":{"zh":"最后的希望","en":"One Last Hope"},"category":"precursors","kind":"site","image":"art/756b9c98c33733a17249.webp","start":"archaeological_site_types:site_polaris_seed_vault","chapters":6,"visible":true,"excerpt":{"zh":"漂浮在 [From.Planet.GetName] 行星残骸水晶的般清澈的海洋上，包裹在微小冰盖的，似乎是一个人造结构。\n\n需要一个团队来挖掘这个结构。","en":"Encapsulated in what remains of the planet's tiny ice cap, floating on the crystal clear oceans of [From.Planet.GetName], is what appears to be an artificial structure. \n\nA team is required to excavate this structure."},"tree":{"root":"n0","nodes":{"n0":{"doc":null,"children":["n1"]},"n1":{"doc":"archaeological_site_types:site_polaris_seed_vault","parent":"n0","via":{"kind":"entry","triggers":[{"zh":"星系生成","en":"Galaxy generation"}]},"children":["n2"]},"n2":{"doc":"ancrel.13005","parent":"n1","via":{"hooks":["stage:","stage_event"],"kind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt:2405"},"children":["n3"]},"n3":{"doc":"ancrel.13010","parent":"n2","via":{"kind":"stage","hooks":["stage"],"source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt"},"children":["n4"]},"n4":{"doc":"ancrel.13015","parent":"n3","via":{"kind":"stage","hooks":["stage"],"source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt"},"children":["n5"]},"n5":{"doc":"ancrel.13020","parent":"n4","via":{"kind":"stage","hooks":["stage"],"source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt"},"children":["n6"]},"n6":{"doc":"ancrel.13025","parent":"n5","via":{"kind":"stage","hooks":["stage"],"source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt"},"children":[]}}}},"chapters":[{"id":"archaeological_site_types:site_polaris_seed_vault","kind":"site","title":{"zh":"最后的希望","en":"One Last Hope"},"texts":[{"zh":"漂浮在 [From.Planet.GetName] 行星残骸水晶的般清澈的海洋上，包裹在微小冰盖的，似乎是一个人造结构。\n\n需要一个团队来挖掘这个结构。","en":"Encapsulated in what remains of the planet's tiny ice cap, floating on the crystal clear oceans of [From.Planet.GetName], is what appears to be an artificial structure. \n\nA team is required to excavate this structure."}],"sections":[{"zh":"漂浮在 [From.Planet.GetName] 行星残骸水晶的般清澈的海洋上，包裹在微小冰盖的，似乎是一个人造结构。\n\n需要一个团队来挖掘这个结构。","en":"Encapsulated in what remains of the planet's tiny ice cap, floating on the crystal clear oceans of [From.Planet.GetName], is what appears to be an artificial structure. \n\nA team is required to excavate this structure."}],"image":"art/756b9c98c33733a17249.webp","hidden":false,"choices":[],"next":[{"target":"ancrel.13005","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt:2405","hooks":["stage:","stage_event"],"story":"site-site-polaris-seed-vault"},{"target":"ancrel.8000","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0002,"group":"r29760","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:2","hooks":["on_roll_failed"],"story":"event-ancrel-8000"},{"target":"ancrel.8001","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0011,"group":"r29760","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:3","hooks":["on_roll_failed"],"story":"event-ancrel-8001"},{"target":"ancrel.8002","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0011,"group":"r29760","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:4","hooks":["on_roll_failed"],"story":"event-ancrel-8002"},{"target":"ancrel.8003","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0011,"group":"r29760","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:5","hooks":["on_roll_failed"],"story":"event-ancrel-8003"},{"target":"ancrel.8010","kind":"failure","conditional":true,"delayed":false,"sourceKin