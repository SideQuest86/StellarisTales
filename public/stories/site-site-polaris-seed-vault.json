:"r29760","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:18","hooks":["on_roll_failed"],"story":"event-ancrel-8050"},{"target":"ancrel.8055","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29760","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:19","hooks":["on_roll_failed"],"story":"event-ancrel-8055"},{"target":"ancrel.8060","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29760","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:20","hooks":["on_roll_failed"],"story":"event-ancrel-8060"},{"target":"ancrel.8065","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29760","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:26","hooks":["on_roll_failed"],"story":"event-ancrel-8065"},{"target":"ancrel.8070","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29760","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:29","hooks":["on_roll_failed"],"story":"event-ancrel-8070"},{"target":"ancrel.8075","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0007,"group":"r29760","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:35","hooks":["on_roll_failed"],"story":"event-ancrel-8075"},{"target":"ancrel.8080","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29760","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:36","hooks":["on_roll_failed"],"story":"event-ancrel-8080"},{"target":"ancrel.8110","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29760","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:37","hooks":["on_roll_failed"],"story":"event-ancrel-8110"},{"target":"federations2.701","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29760","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:51","hooks":["on_roll_failed"],"story":"event-federations2-701"},{"target":"ancrel.4078","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0018,"group":"r29760","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:64","hooks":["on_roll_failed"],"story":"event-ancrel-4078"},{"target":"ancrel.13030","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29760","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:71","hooks":["on_roll_failed"],"story":"event-ancrel-13030"},{"target":"ancrel.4006","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29760","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:90","hooks":["on_roll_failed"],"story":"event-ancrel-4006"},{"target":"ancrel.4021","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29760","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:104","hooks":["on_roll_failed"],"story":"event-ancrel-4021"},{"target":"story.5","kind":"delay","conditional":false,"delayed":true,"sourceKind":"delay","delay":[{"days":"30"}],"source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt:2400","story":"origin_fear_of_the_dark"}],"source":{"file":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","line":2385},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"ancrel.13005","kind":"event","title":{"zh":"冰山","en":"Iceberg"},"texts":[{"zh":"漂浮的冰山本身内置了一个巨大的黑色长方体，由与上方太空舰队残骸相同的合金制成。我们的冰川专家表示，尽管据称“很难用外星大气来判断”，冰山形成依然可以追溯到至少一千年前。结构内部的扫描显示有相当多的生物读数，因此不建议使用破坏性工具。\n\n团队将不得不穿越冰冻的悬崖，到达似乎是建筑物入口的地方。","en":"Built into the floating iceberg itself is a hulking black cuboid made out of the same alloys as the wreckage of the space fleet above. Our glacial specialists state that analysis of the iceberg dates its formation to least a thousand years ago, though it's supposedly \"hard to tell with alien atmospheres\". Scans of the interior of the structure show quite a few biological readings, therefore using disruptive tools is inadvisable.\n\nThe team will have to traverse the frozen cliffs to what appears to be an entrance into the building."}],"sections":[],"image":"art/b51be10289361fe6e018.webp","hidden":false,"choices":[{"key":"acnrel.13005.a","label":{"zh":"那就一路向下吧。","en":"Down we go."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.13010","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-polaris-seed-vault"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":9193}},{"id":"ancrel.13010","kind":"event","title":{"zh":"霜冻之门","en":"Frost Gate"},"texts":[{"zh":"我们在[From.Planet.GetName]的设施入口处建立了大本营。我们已经发现了一些看起来像是刻在建筑物墙壁上的文字。现在我们将开始在不会损坏里面任何东西的情况下打开这扇门的漫长而艰巨的过程。与此同时，我们的异种语言学家尝试翻译铭文中已失传的外星语言。","en":"We have set up base camp at the supposed entrance to the facility here on [From.Planet.GetName]. Already we have discovered something that looks like writing inscribed on the walls of the building. Now we will begin the long and arduous process of opening this door without damaging whatever is inside. At the same time, our xeno-linguists attempt to translate the dead alien language of the inscriptions."}],"sections":[],"image":"art/579f16ac11828e9a5ab1.webp","hidden":false,"choices":[{"key":"INTERESTING","label":{"zh":"真是有趣。","en":"Interesting."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.13015","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-polaris-seed-vault"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":9219},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"ancrel.13015","kind":"event","title":{"zh":"盗墓","en":"Grave Robbing"},"texts":[{"zh":"是时候了，我们已经准备好解封黑色结构，根据墙上铭文的初步翻译，它被称为“避难所”。这个避难所的创造者勾陈一星人将其作为保护财宝安全的最后手段。当我们打开门时，迎接我们的是——根据我们的传感器的数据——一种类似于外界空气的受控大气，只是二氧化碳要少得多。","en":"The time was upon us, and we stood ready to unseal the black structure, dubbed \"The Vault\" according to preliminary translations of the wall inscriptions. The creators of this vault, the Polarians, made it as a last resort to keep their treasures safe. As we opened the doors, we were greeted by - according to our sensors - a controlled atmosphere similar to the air outside, just with quite a bit less carbon dioxide."}],"sections":[],"image":"art/77e89ca049baccbf9fb3.webp","hidden":false,"choices":[{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.13020","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-polaris-seed-vault"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":9246}},{"id":"ancrel.13020","kind":"event","title":{"zh":"藏宝","en":"Treasure"},"texts":[{"zh":"远古种子！植物胚胎——那是勾陈一星人藏在这个金库里的宝藏。进一步的翻译告诉我们，这些外星人怪异地不断用过量二氧化碳填充他们的大气层。一旦气候发生不可逆转的变化，这个星球的古代居民就会收集他们所能找到的所有不能在新环境下生存的植物物质，并将它们全部冻结在这里。\n\n那时，整个星球都会被冰覆盖；现在，只剩下这片孤独的小冰山了。然而，他们的努力不会白费——拿到星球上的整个植物生态的编目和分类，将极大地帮助我们的科学家研究未来的生物问题。","en":"Ancient seeds! Plant embryos - that was the treasure the Polarians hid away in this vault. Further translations tell us that these aliens curiously kept filling their atmosphere with too much carbon dioxide. Once the atmosphere was irreversibly changed the ancient inhabitants of this world gathered all the plant matter they could find that might not survive their new status quo and froze them all in here.\n\nBack then, the whole planet would have been covered in ice; now, all that remains is this small lonely iceberg. However, their efforts will not have been wasted - having a planet's whole plant ecology already cataloged and sorted will significantly help our scientists in researching future biological matters."}],"sections":[],"image":"art/97a6b89eb63606dfc473.webp","hidden":false,"choices":[{"key":"ancrel.13020.a","label":{"zh":"把这些样本发送给我们的科学家。","en":"Send these samples to our scientists."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false},{"key":"ancrel.13020.b.evopred","label":{"zh":"不仅编目了而且还便于克隆？这个地库简直是为我们建的。","en":"Cataloged and ready for cloning? This vault was made for us."},"responses":[],"tooltips":[],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"origin_evolutionary_predators","value":true,"label":{"zh":"演化猎手","en":"Evolutionary Predators"}}]]}],"next":[{"target":"ancrel.13025","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-polaris-seed-vault"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":9293}},{"id":"ancrel.13025","kind":"event","title":{"zh":"藏宝","en":"Treasure"},"texts":[{"zh":"有机微生物！所有有害和有益的细菌。所有真核生物和原核生物。所有这些都在高级存储设施中标记和分类：这是勾陈一星人藏在这个金库中的巨大财富。进一步的翻译告诉我们，这些外星人怪异地不断用过量二氧化碳填充他们的大气层。一旦大气发生了不可逆转的变化，这个星球的古代居民就会收集他们所能找到的所有不能在新环境下生存的微生物，并将它们全部冻结在这里。\n\n那时，整个星球都会被冰覆盖；现在，只剩下这片孤独的小冰山了。然而，他们的努力不会白费——拿到星球的整个微生物生态的编目和分类，将极大地帮助我们的[Root.Owner.getscientistplural]开发新星球以及改造殖民地。","en":"Microorganisms! Every harmful and helpful bacterium. Every eukaryote and prokaryote. All in an advanced storage facility labeled and cataloged: this was the great treasure the Polarians hid away in this vault. Further translations tell us that these aliens curiously kept filling their atmosphere with too much carbon dioxide. Once the atmosphere was irreversibly changed, the ancient inhabitants of this world gathered all the microbial life they could find that might not survive their new status quo and froze them all in here.\n\nBack then, the whole planet would have been covered in ice; now, all that remains is this small lonely iceberg. However, their efforts will not have been wasted - having a planet's whole microbial ecology already cataloged and sorted will significantly help our [Root.Owner.getscientistplural] develop new and improved colonies for new worlds."},{"zh":"有机微生物。所有有害和有益的细菌，所有真核生物和原核生物。标记和编目：这是勾陈一星人藏在这个金库中的宝藏。进一步的翻译告诉我们，这些外星人怪异地不断用过量二氧化碳填充他们的大气层。一旦大气发生了不可逆转的变化，这个星球的古代居民就会收集他们所能找到的所有不能在新环境下生存的微生物，并将它们全部冻结在这里。\n\n那时，整个星球都会被冰覆盖；现在，剩下的就是这座孤独的小冰山。然而，感谢他们的努力——预先分类的生物将使提取相关信息变得更加容易。","en":"Microorganisms. Every harmful and helpful bacterium, every eukaryote and prokaryote. Labeled and cataloged: this was the great treasure the Polarians hid away in this vault. Further translations tell us that these aliens curiously kept filling their atmosphere with too much carbon dioxide. Once the atmosphere was irreversibly changed, the ancient inhabitants of this world gathered all the microbial life they could find that might not survive their new status quo and froze them all in here.\n\nBack then, the whole planet would have been covered in ice; now, all that remains is this small, lonely iceberg. However, their efforts are appreciated- pre-sorted biologicals will make it easier to extract relevant information."}],"sections":[],"image":"art/06a548b312f847f58286.webp","hidden":false,"choices":[{"key":"ancrel.13020.a","label":{"zh":"把这些样本发送给我们的科学家。","en":"Send these samples to our scientists."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false},{"key":"ancrel.13020.b.evopred","label":{"zh":"不仅编目了而且还便于克隆？这个地库简直是为我们建的。","en":"Cataloged and ready for cloning? This vault was made for us."},"responses":[],"tooltips":[],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"origin_evolutionary_predators","value":true,"label":{"zh":"演化猎手","en":"Evolutionary Predators"}}]]}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":9337},"body":[{"pieces":[{"text":0}],"when":[[{"type":"identity","key":"auth_machine_intelligence","value":false,"label":{"zh":"机械智能","en":"Machine Intelligence"}}]]},{"pieces":[{"text":1}],"when":[[{"type":"identity","key":"auth_machine_intelligence","value":true,"label":{"zh":"机械智能","en":"Machine Intelligence"}}]]}]}]}