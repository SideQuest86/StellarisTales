tage","arg":"default_end_stage_hostile_with_crew","scope":"","value":true},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_no_crew","scope":"","value":false},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_vivisection","scope":"","value":false}],[{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_crew_easy","scope":"","value":true},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_no_crew","scope":"","value":false},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_vivisection","scope":"","value":false}],[{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_crew_hard","scope":"","value":true},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_no_crew","scope":"","value":false},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_vivisection","scope":"","value":false}]]],"source":"common/scripted_effects/first_contact_effects.txt:45","story":"event-first-contact-1110"}],"terminal":false}],"next":[],"source":{"file":"events/first_contact_NPC_country_types_events.txt","line":766},"names":{"encountered_marauder.GetSpeciesName":{"zh":"该物种","en":"the species"},"marauder_system.GetName":{"zh":"这个星系","en":"this system"},"encountered_marauder.GetRealName":{"zh":"这位领袖","en":"the leader"},"This.Leader.GetName":{"zh":"这位领袖","en":"the leader"}},"ending":{"label":{"zh":"结局：确认为掠夺者","en":"Ending: marauders identified"},"note":{"zh":"结束首次接触，后续见掠夺者篇（marauder.1）。","en":"First contact ends; continues in the marauder story (marauder.1)."}}}],"summary":{"text":"# 野蛮迹象 / Signs of Barbarism\n- 分类 Category：文明纪事 Society (C7) · 首次接触阶段链 first-contact stage chain（marauders_stage_1/2）\n- 来源 Sources：`events/first_contact_NPC_country_types_events.txt:743-839` · `common/first_contact/01_first_contact_space_fauna_and_NPCs.txt:209-247`\n- 审阅 Reviewed：2026-10-13（c7b-society）\n\n## 如何开始 How it starts\n\n与休眠掠夺者（dormant_marauders）国家首次相遇，启动 marauders_stage_1（难度3）。 / Meeting a dormant-marauders country starts marauders_stage_1 (difficulty 3).\n\n## 剧情脉络 Story outline\n\n1. **野蛮的迹象（50）：大使怀疑对方是否具有智慧；→ 第二阶段（难度5）。 / Signs of Barbarism; stage 2 follows (difficulty 5).**\n2. **被遇到的掠夺者（55）：译出语言，确认对方是游牧文明“掠夺者”，唯一选项为 marauder.1.a 的“尝试联系”并结束首次接触。 / The marauders identified; the option leads on to the marauder story.**\n\n## 分支与结局 Branches and outcomes\n\n线性，无分叉。结尾选项调用 finish_first_contact_effect（建立通讯/结束首次接触）。 阶段检定失败时：每次失败有 1/20 的概率触发该阶段指定的随机事件池（同一站点 125 天内最多一次）。 / Linear. The ending options call finish_first_contact_effect (first contact ends). When a stage roll fails there is a 1-in-20 chance to draw from the stage’s random-event pool (at most once per 125 days per site). (pool: early_fc_random_events (stage 1) / late_fc_random_events (stage 2))\n\n## 条件与文明差异 Conditions and variants\n\n无文明差异。 / No variants.\n\n## 审阅记录 Review notes\n\n- 已核对 Checked：50、55与两个阶段定义。/ Both events and stage definitions.\n- 审阅改动 Changes：并 55 入本篇。/ 55 merged into this story.\n","path":"summaries/event-first-contact-critters-50.md"}}