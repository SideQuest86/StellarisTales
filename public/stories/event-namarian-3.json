":"namarian.525","parent":"n12","via":{"option":"namarian.511.d","optionIndex":3,"kind":"option","source":"events/namarian_events.txt:3186"}},"n22":{"ref":"n10","doc":"namarian.514","parent":"n13","via":{"option":"namarian.513.b","optionIndex":0,"kind":"option","source":"events/namarian_events.txt:3217"}},"n23":{"ref":"n10","doc":"namarian.514","parent":"n13","via":{"option":"namarian.513.d","optionIndex":1,"kind":"option","source":"events/namarian_events.txt:3229"}},"n24":{"ref":"n7","doc":"namarian.525","parent":"n13","via":{"option":"namarian.513.c","optionIndex":2,"kind":"option","source":"events/namarian_events.txt:3242"}},"n25":{"ref":"n7","doc":"namarian.525","parent":"n13","via":{"option":"namarian.511.d","optionIndex":3,"kind":"option","source":"events/namarian_events.txt:3255"}},"n26":{"doc":"namarian.521","parent":"n16","via":{"option":"namarian.520.b","optionIndex":1,"kind":"option","source":"events/namarian_events.txt:3406"},"children":["n27","n28"]},"n27":{"doc":"namarian.522","parent":"n26","via":{"option":"namarian.521.a","optionIndex":0,"kind":"option","source":"events/namarian_events.txt:3441"},"children":["n29","n30"]},"n28":{"ref":"n27","doc":"namarian.522","parent":"n26","via":{"option":"namarian.521.b","optionIndex":1,"kind":"option","source":"events/namarian_events.txt:3448"}},"n29":{"doc":"namarian.523","parent":"n27","via":{"option":"namarian.522.d","optionIndex":2,"kind":"option","source":"events/namarian_events.txt:3485"},"children":["n31","n32","n33"]},"n30":{"doc":"namarian.526","parent":"n27","via":{"option":"namarian.522.e","optionIndex":3,"kind":"option","source":"events/namarian_events.txt:3492"},"children":[]},"n31":{"doc":"namarian.524","parent":"n29","via":{"option":"namarian.523.c","optionIndex":0,"kind":"option","source":"events/namarian_events.txt:3517"},"children":["n34"]},"n32":{"ref":"n30","doc":"namarian.526","parent":"n29","via":{"option":"namarian.523.a","optionIndex":1,"kind":"option","source":"events/namarian_events.txt:3527"}},"n33":{"ref":"n30","doc":"namarian.526","parent":"n29","via":{"option":"namarian.523.b","optionIndex":2,"kind":"option","source":"events/namarian_events.txt:3534"}},"n34":{"ref":"n17","doc":"namarian.530","parent":"n31","via":{"option":"namarian.524.a","optionIndex":0,"delay":[{"days":"20"}],"kind":"option","source":"events/namarian_events.txt:3563"}}}}},"chapters":[{"id":"namarian.21","kind":"event","title":{"zh":"星海游牧民","en":"Galactic Nomads"},"texts":[{"zh":"你们好，[Root.GetAdj][Root.GetRulerTitle]。我们有个请求。在我们穿过漫漫虚空的旅途中，我们中的一些人民心生倦怠，眼中失去了目标。我们不是暴君，因此不会强迫任何人跟随我们完成旅途。所以我们在此请求：你们可以接收上述船员吗？让他们栖息在你们的[NomadMissionPlanet.GetName]上，可以吗？","en":"Greetings again, [Root.GetAdj] [Root.GetRulerTitle]. We have a request for you. As we travel the void some of our people grow weary and lose sight of our goal. We are no tyrants, we force no one to see our quest to the end. So we ask of you: will you take some of our people in? To dwell on your orb, the one named [NomadMissionPlanet.GetName]?"}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"namarian.21.c","label":{"zh":"他们因何不满？","en":"Why are they discontent?"},"responses":[{"zh":"旅途漫漫，很可能我们一生都无法到达终点。有人想要寻找在有生之年能够到达的目标，而不是在无尽的旅途中耗尽此生。","en":"The fleet's journey has been a long one. And it will not likely end within our lifetime. The discontent among us want another purpose in their lives other than searching the stars for our goal."}],"tooltips":[],"conditional":false,"next":[],"terminal":false},{"key":"namarian.21.d","label":{"zh":"他们要怎么适应我们的社会？","en":"How will they adapt to our society?"},"responses":[{"zh":"他们是一群不仅唯心还追求所谓平等的懦夫，至于他们能否和你们友好相处那就是你们自己的决断了。","en":"They are a spiritual and egalitarian crowd, how well that meshes with your tribe is for you to discern."}],"tooltips":[],"conditional":false,"next":[],"terminal":false},{"key":"namarian.21.a","label":{"zh":"我们会接收他们的。","en":"We will take them in."},"responses":[{"zh":"太感谢你们了，[Root.GetSpeciesAdj]。愿我们同你们一道得偿所愿。","en":"We thank you, [Root.GetSpeciesAdj]. May our people find what they are looking for, in communion with your people."}],"tooltips":[{"zh":"[NomadMissionPlanet.GetName]：\n+300£pop£游牧人口","en":"[NomadMissionPlanet.GetName]:\n+300 £pop£ Nomad Pops"}],"conditional":false,"next":[],"terminal":false,"sets":["nomad_left_stragglers"],"clears":["nomad_on_mission"]},{"key":"namarian.21.b","label":{"zh":"我们不能收留他们。","en":"We cannot host them."},"responses":[{"zh":"那真是太不幸了，[Root.GetSpeciesAdj]。希望那些掉队者能再坚持一下。我们马上就启程。","en":"That is unfortunate, [Root.GetSpeciesAdj]. Hopefully the stragglers will endure for a while longer. We will be on our way."}],"tooltips":[],"conditional":false,"next":[],"terminal":false,"clears":["nomad_on_mission"]}],"next":[],"source":{"file":"events/namarian_events.txt","line":1864},"names":{"NomadMissionPlanet.GetName":{"zh":"这颗星球","en":"this planet"},"Root.GetRulerTitle":{"zh":"统治者","en":"ruler"},"Root.GetSpeciesAdj":{"zh":"该族","en":"the species'"},"Root.GetAdj":{"zh":"我方","en":"our"}}},{"id":"namarian.41","kind":"event","title":{"zh":"星海游牧民","en":"Galactic Nomads"},"texts":[{"zh":"愿你沐浴和风，[Root.GetAdj][Root.GetRulerTitle]。我们发现你们称之为[NomadMissionPlanet.GetName]的球体目前并未被你们占据。我们请求：能否让我们的一支帝国在此安家？\n\n我们知道这是个不小的要求——失去整座星系来给我们一个家。我们等待你的答复，无论你如何决定。","en":"Pleasant winds to you, [Root.GetAdj] [Root.GetRulerTitle]. We have found that the orb you call [NomadMissionPlanet.GetName] is not currently being held by your people. We ask of you: could you let one of our tribes land upon it and make it a new home?\n\nWe realize we ask much of you - to lose an entire system to give our people a home. We await your decision, whatever it may be."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"namarian.41.b","label":{"zh":"我们不能祝福你们。","en":"We cannot grant you this wish."},"responses":[{"zh":"这对我们而言是个噩耗，[Root.GetSpeciesAdj]。希望他们能在下一个水坑中找到苦苦搜寻的目标，而不是灼热的风暴。通讯终止。","en":"That is unfortunate for our people, [Root.GetSpeciesAdj]. We can only hope that they will find what they are looking for at the next watering hole, instead of searing winds. End transmission."}],"tooltips":[{"zh":"与[nomad_fleet_country.GetName]的关系恶化","en":"Your relation with the [nomad_fleet_country.GetName] is worsened"}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"ethic_xenophobe","value":false,"label":{"zh":"排外主义","en":"Xenophobe"}},{"type":"identity","key":"ethic_spiritualist","value":false,"label":{"zh":"唯心主义","en":"Spiritualist"}}]],"clears":["nomad_on_mission"]},{"key":"namarian.41.b.phobe","label":{"zh":"这颗“星球”是我们的。","en":"The \"planet\" is ours."},"responses":[{"zh":"这对我们而言是个噩耗，[Root.GetSpeciesAdj]。希望他们能在下一个水坑中找到苦苦搜寻的目标，而不是灼热的风暴。通讯终止。","en":"That is unfortunate for our people, [Root.GetSpeciesAdj]. We can only hope that they will find what they are looking for at the next watering hole, instead of searing winds. End transmission."}],"tooltips":[{"zh":"与[nomad_fleet_country.GetName]的关系恶化","en":"Your relation with the [nomad_fleet_country.GetName] is worsened"}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"ethic_xenophobe","value":true,"label":{"zh":"排外主义","en":"Xenophobe"}}]],"clears":["nomad_on_mission"]},{"key":"namarian.41.b.spirit","label":{"zh":"不，这是我们不可冒犯的领地。","en":"No, it is ours by divine right."},"responses":[{"zh":"这对我们而言是个噩耗，[Root.GetSpeciesAdj]。希望他们能在下一个水坑中找到苦苦搜寻的目标，而不是灼热的风暴。通讯终止。","en":"That is unfortunate for our people, [Root.GetSpeciesAdj]. We can only hope that they will find what they are looking for at the next watering hole, instead of searing winds. End transmission."}],"tooltips":[{"zh":"与[nomad_fleet_country.GetName]的关系恶化","en":"Your relation with the [nomad_fleet_country.GetName] is worsened"}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"ethic_spiritualist","value":true,"label":{"zh":"唯心主义","en":"Spiritualist"}},{"type":"identity","key":"ethic_xenophobe","value":false,"label":{"zh":"排外主义","en":"Xenophobe"}}]],"clears":["nomad_on_mission"]},{"key":"namarian.41.a","label":{"zh":"这座星系，以及那个“球体”归你们了。","en":"The system, and the \"orb\" is yours."},"responses":[{"zh":"我们衷心感谢你们。在冰冻刺骨的星系中，这样的热情能够驱散一丝寒意。我们游牧舰队衷心祝愿你们以及新生的帝国前途光明。","en":"We thank your people for their grace. The galaxy is a cold place but today an act of kindness will ripple through its waters. We of the nomadic fleet wish both you and this new empire the best of luck in your affairs."}],"tooltips":[{"zh":"你将割让[NomadMissionPlanet.GetStarName]星系的控制权\n\n在[NomadMissionPlanet.GetName]上创建一个拥有1.5K£pop£的纳马里安族帝国\n\n你与[nomad_fleet_country.GetName]以及纳马里安帝国的关系得到了改善","en":"You will cede control of the [NomadMissionPlanet.GetStarName] System\n\nCreates a Namarian empire with 1.5K £pop£ Pops on [NomadMissionPlanet.GetName]\n\nYour relation with the [nomad_fleet_country.GetName] and the Namarian empire is improved"}],"conditional":false,"next":[],"terminal":false,"sets":["nomad02_country_flag","nomad_settled"],"clears":["nomad_on_mission"]},{"key":"namarian.41.c","label":{"zh":"为什么对这颗行星感兴趣？","en":"Why is the planet of interest?"},"responses":[{"zh":"在虚空之河航行对十分艰难，却只是漫长旅程的一小步。我们的帝国只想寻求栖息之地，而[NomadMissionPlanet.GetName]能够满足他们的需求。\n\n[Root.GetAdj][Root.GetRulerTitle]，你们愿意为他们提供栖息之地吗？","en":"Sailing the voids-between is an arduous journey, and yet only a step on an already strenuous path. Our people simply seek rest, and thought that [NomadMissionPlanet.GetName] fulfilled their needs.\n\nWill you grant them this rest, [Root.GetAdj] [Root.GetRulerTitle]?"}],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/namarian_events.txt","line":2180},"names":{"nomad_fleet_country.GetName":{"zh":"这支舰队","en":"the fleet"},"Root.GetSpeciesAdj":{"zh":"该族","en":"the species'"},"NomadMissionPlanet.GetStarName":{"zh":"这颗恒星","en":"the star"},"Root.GetAdj":{"zh":"我方","en":"our"},"NomadMissionPlanet.GetName":{"zh":"这颗星球","en":"this planet"},"Root.GetRulerTitle":{"zh":"统治者","en":"ruler"}}},{"id":"namarian.500","kind":"event","title":{"zh":"游牧民族贸易提案","en":"Nomad Trade Proposal"},"texts":[{"zh":"很高兴再会，绿洲的[Root.GetRulerTitle]。在周围的行星之间穿行使得我们可以在废弃种群找寻有用的东西。也正因如此我们刚刚建好了我们的新飞船。\n\n事实上我们建造出过量的飞船是为了解决的资源过剩这个问题。我们更希望商队能够保持灵活，不受束缚，所以我们带着希望达成交易的愿景来找到你们。","en":"Greetings again, [Root.GetRulerTitle] of the oasis. Sailing through the nearby stars have made for some particularly fruitful scavenging. And so we have just finished the construction of new vessels.\n\nIn actuality we build more than we need in order to get rid of the excess resources. We prefer the caravan to stay nimble, unburdened, so we come to you with a transaction in mind."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"namarian.500.a","label":{"zh":"商队？","en":"The caravan?"},"responses":[{"zh":"舰队中的方舟。是我们的建设者工作休息的地方。商队穿梭于宇宙之中需要它来提供维持生存的空间，因此我们需要降低它的负载。\n\n如果飞船组成了舰队的手臂的话，那么商队就是舰队的心脏。","en":"The arkships of our fleet. Where we construct our contraptions, where our builders sleep. Steering the caravan across the great voids-between requires it to offer living space, hence the need to reduce its load.\n\nIf our military make up the fleet's hands, the caravan is its heart."}],"tooltips":[],"conditional":false,"next":[],"terminal":false},{"key":"namarian.500.b","label":{"zh":"交易？","en":"A transaction?"},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"namarian.505","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:2955","story":"event-namarian-3"}],"terminal":false},{"key":"namarian.500.c","label":{"zh":"说说吧。","en":"Out with it."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"namarian.505","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:2962","story":"event-namarian-3"}],"terminal":false}],"next":[],"source":{"file":"events/namarian_events.txt","line":2914},"sets":["nomad_ship_trade"],"names":{"Root.GetRulerTitle":{"zh":"统治者","en":"ruler"}}},{"id":"namarian.505","kind":"event","title":{"zh":"游牧民族贸易提案","en":"Nomad Trade Proposal"},"texts":[{"zh":"我们有一个提案。我们需要能量币和矿物来维持我们的航行。作为交换，我们会交给你们五艘我们的新型舰船","en":"A proposal, then. We require energy credits and minerals for the next crossing. In exchange, you may have five of our newly-built vessels."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"namarian.505.a","label":{"zh":"只有五艘？","en":"Only five?"},"responses":[{"zh":"我们想卖的就是这么多。毕竟商队需要攻防兼备。","en":"That is as many as we are willing to part with. The caravan needs its hands to hold both shield and spear after all."}],"tooltips":[],"conditional":false,"next":[],"terminal":false},{"key":"namarian.505.b","label":{"zh":"请继续。","en":"Go on."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"namarian.510","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:2994","story":"event-namarian-3"}],"terminal":false},{"key":"namarian.505.c","label":{"zh":"我们不相信纳马里安的工程技术。","en":"We do not trust Namarian engineering."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"namarian.525","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:3001","story":"event-namarian-3"}],"terminal":false}],"next":[],"source":{"file":"events/namarian_events.txt","line":2967}},{"id":"namarian.510","kind":"event","title":{"zh":"游牧民族贸易提案","en":"Nomad Trade Proposal"},"texts":[{"zh":"这就是我们的行事方式，不断的收集资源，随时保持我们的船坞处于运作状态，这不仅仅是我们的传统也是我们必须要做的事。比起拖累我们的舰队我们更希望看到的是我们的造物被其他天体居民买去使用。\n\n我们能够确信我们的设计不会让你失望。","en":"It is our way, by tradition and necessity, to scavenge resources and activate our internal shipyards when and where we can. We would prefer to see whatever excess we generate is put to use among the orb-dwellers, than have it hamper our journey.\n\nWe believe our designs would not disappoint you."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"namarian.510.a","label":{"zh":"给我介绍介绍这些舰队。","en":"Tell us about these vessels."},"responses":[{"zh":"巡洋舰，你们应该是这么叫的吧。装备有护盾，以及电弧发射器和等离子发射器。","en":"Cruisers, we suppose you would call them. Shielded and armed with plasma throwers and arc emitters."}],"tooltips":[],"conditional":false,"next":[],"terminal":false},{"key":"namarian.510.b","label":{"zh":"我们很感兴趣。","en":"We are interested."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"namarian.511","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:3033","story":"event-namarian-3"}],"terminal":false},{"key":"namarian.510.c","label":{"zh":"我们没兴趣。","en":"We are not interested."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"namarian.525","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:3040","story":"event-namarian-3"}],"terminal":false}],"next":[],"source":{"file":"events/namarian_events.txt","line":3006}},{"id":"namarian.511","kind":"event","title":{"zh":"游牧民族贸易提案","en":"Nomad Trade Proposal"},"texts":[{"zh":"一个令人心旷神怡的回答，[Root.GetAdj][Root.GetRulerTitle]，我们只需2000£minerals£或者2000£energy£作为回报。","en":"A refreshing answer, [Root.GetAdj] [Root.GetRulerTitle]. All we ask in return is £minerals£ 2000 or £energy£ 2000."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"namarian.511.a","label":{"zh":"我们非常乐意支付2000£energy£。","en":"We will happily ease your burden for £energy£ 2000."},"responses":[],"tooltips":[],"conditional":true,"next":[{"target":"namarian.514","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:3071","story":"event-namarian-3"}],"terminal":false,"allow":[[{"type":"other","key":"resource_stockpile_compare","arg":"{…}","scope":"","value":true}]]},{"key":"namarian.511.e","label":{"zh":"我们愿意支付2000£minerals£。","en":"We will take them for £minerals£ 2000."},"responses":[],"tooltips":[],"conditional":true,"next":[{"target":"namarian.514","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:3083","story":"event-namarian-3"}],"terminal":false,"allow":[[{"type":"other","key":"resource_stockpile_compare","arg":"{…}","scope":"","value":true}]]},{"key":"namarian.511.b","label":{"zh":"你再卖便宜一点。","en":"Lower your price."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"namarian.512","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","chance":0.5,"group":"r18095","source":"events/namarian_events.txt:3091","story":"event-namarian-3"},{"target":"namarian.513","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","chance":0.5,"group":"r18095","source":"events/namarian_events.txt:3092","story":"event-namarian-3"}],"terminal":false},{"key":"namarian.511.c","label":{"zh":"我们付不起。","en":"We cannot afford that."},"responses":[],"tooltips":[],"conditional":true,"next":[{"target":"namarian.525","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:3106","story":"event-namarian-3"}],"terminal":false,"when":[[{"type":"other","key":"resource_stockpile_compare","arg":"{…}","scope":"","value":false}]]},{"key":"namarian.511.d","label":{"zh":"没门。","en":"No deal."},"responses":[],"tooltips":[],"conditional":true,"next":[{"target":"namarian.525","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:3119","story":"event-namarian-3"}],"terminal":false,"allow":[[{"type":"other","key":"resource_stockpile_compare","arg":"{…}","scope":"","value":true}]]}],"next":[],"source":{"file":"events/namarian_events.txt","line":3045},"names":{"Root.GetRulerTitle":{"zh":"统治者","en":"ruler"},"Root.GetAdj":{"zh":"我方","en":"our"}}},{"id":"namarian.514","kind":"event","title":{"zh":"游牧民族贸易提案","en":"Nomad Trade Proposal"},"texts":[{"zh":"舰船将开往你们的中央绿洲——[Root.Capital.GetName]？是的。30天内完成交付。\n\n愿你们一路顺风，永远能够得到荫凉的庇佑，[Root.GetRulerName]。","en":"The ships will be driven to your central oasis - [Root.Capital.GetName]? Yes. To be delivered within 30 days.\n\nMay you always follow the trail and find shade, [Root.GetRulerName]."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"namarian.514.a","label":{"zh":"再见了，[contact_speaker_leader.GetName]。","en":"Farewell, [contact_speaker_leader.GetName]."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"namarian.520","kind":"option","conditional":true,"delayed":true,"sourceKind":"option","chance":0.3,"group":"c18096","delay":[{"days":"10"}],"when":[[[{"type":"other","key":"any_neighbor_country","arg":"{…}","scope":"","value":true}]]],"source":"events/namarian_events.txt:3313","story":"event-namarian-3"},{"target":"namarian.530","kind":"option","conditional":true,"delayed":true,"sourceKind":"option","chance":0.7,"group":"c18096","delay":[{"days":"30"}],"when":[[[{"type":"other","key":"any_neighbor_country","arg":"{…}","scope":"","value":true}]]],"source":"events/namarian_events.txt:3314","story":"event-namarian-3"}],"terminal":false,"sets":["nomad_doublecrossing"]}],"next":[],"source":{"file":"events/namarian_events.txt","line":3260},"names":{"contact_speaker_leader.GetName":{"zh":"这位领袖","en":"the leader"},"Root.Capital.GetName":{"zh":"这颗星球","en":"this planet"},"Root.GetRulerName":{"zh":"统治者","en":"the ruler"}}},{"id":"namarian.520","kind":"event","title":{"zh":"加密通讯","en":"Encrypted Transmission"},"texts":[{"zh":"嗨，天体居民。\n\n我们有消息要告诉你们。","en":"Hey, orb-dweller.\n\nWe've got some news for your kind."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"namarian.520.a","label":{"zh":"纳马里安人，请表明身份。","en":"Identify yourself, Namarian."},"responses":[{"zh":"我们的身份并无特殊之处。我们是逐浪者舰队中的热心人士。","en":"We're no one special. A concerned party among the Pursuing Waters fleet, one might call us."}],"tooltips":[],"conditional":false,"next":[],"terminal":false},{"key":"namarian.520.b","label":{"zh":"说说吧。","en":"Out with it."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"namarian.521","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:3406","story":"event-namarian-3"}],"terminal":false}],"next":[],"source":{"file":"events/namarian_events.txt","line":3380}},{"id":"namarian.521","kind":"event","title":{"zh":"加密通讯","en":"Encrypted Transmission"},"texts":[{"zh":"你们最近是不是买来了5艘我们新制造的舰船，对吧？速度快而且装配着有大口径的武器？\n\n事情是这样的，尽管你们不是……啊算了，我还是老实告诉你们吧。为了维护这片区域的稳定，和我们定下这笔舰船交易的国家可不止你们。你们的邻居，[other_empire.GetName]同样也和逐浪者舰队谈成了买卖。","en":"You've recently purchased 5 of the fleet's newly crafted vessels, correct? Swift of speed, with large weapons?\n\nHere's the thing, though, you weren't... ah, given the full story. In the interest of preserving regional stability, your people were not the only one offered this deal. Your neighbors, the [other_empire.GetName] have also parleyed with the Pursuing Waters."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"namarian.521.a","label":{"zh":"所以呢？","en":"So?"},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"namarian.522","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:3441","story":"event-namarian-3"}],"terminal":false},{"key":"namarian.521.b","label":{"zh":"有话直说。","en":"Get to the point."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"namarian.522","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:3448","story":"event-namarian-3"}],"terminal":false}],"next":[],"source":{"file":"events/namarian_events.txt","line":3411},"names":{"other_empire.GetName":{"zh":"该帝国","en":"that empire"}}},{"id":"namarian.522","kind":"event","title":{"zh":"加密通讯","en":"Encrypted Transmission"},"texts":[{"zh":"他们谈下了一笔差不多的买卖，又有5艘舰船即将被送往[other_empire.GetAdj]的首都[other_empire.Capital.GetName]。但我们并不希望舰队里的这些船最后是为[other_empire.GetName]效力，所以现在想要请你们帮帮忙。","en":"They accepted a similar offer, and 5 additional craft are set to be shipped to the [other_empire.GetAdj] oasis of [other_empire.Capital.GetName]. We would rather the fleet's ships do not end up in service of the [other_empire.GetName], and we would like your help."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"namarian.522.b","label":{"zh":"为什么告诉我们这个？","en":"Why tell us this?"},"responses":[{"zh":"我们不相信[other_empire.GetSpeciesNamePlural]，与我们之前遇到的其他的帝国不同，他们到现在都没有付款，我们怀疑他们在试图拖延付款时间直到舰船送达到他们的首都，然后再拒绝付款。因为他们意识到了我们的舰队领导非常急切的渴望离开这片星域……","en":"We do not trust the [other_empire.GetSpeciesNamePlural], unlike the rest of the fleet. They have yet to pay, and we suspect they may try to stall until the vessels are delivered and then never send us payment. They realize the fleet leaders are very eager to move on..."}],"tooltips":[],"conditional":false,"next":[],"terminal":false},{"key":"namarian.522.c","label":{"zh":"那你们打算怎么做？","en":"How would you accomplish this?"},"responses":[{"zh":"我们有进入商队船坞自动驾驶设置的权限。只要命令所有舰队在[Root.Capital.GetName]集结，禁止理应交付的那一半飞船发往[other_empire.Capital.GetName]的[other_empire.GetAdj]天体即可。我们不会被逮到的。","en":"We have privileged access to the autopilot configurations in the caravan's shipyards. Simply setting all vessels to rally at [Root.Capital.GetName] - and not sending half of them to the [other_empire.GetAdj] orb of [other_empire.Capital.GetName] - is trivial for us. We wouldn't even get caught."}],"tooltips":[],"conditional":false,"next":[],"terminal":false},{"key":"namarian.522.d","label":{"zh":"那你想要我们做什么？","en":"What do you want us to do?"},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"namarian.523","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:3485","story":"event-namarian-3"}],"terminal":false},{"key":"namarian.522.e","label":{"zh":"不感兴趣。","en":"Not interested."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"namarian.526","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:3492","story":"event-namarian-3"}],"terminal":false}],"next":[],"source":{"file":"events/namarian_events.txt","line":3453},"names":{"other_empire.GetSpeciesNamePlural":{"zh":"该物种","en":"the species"},"other_empire.Capital.GetName":{"zh":"这颗星球","en":"this planet"},"other_empire.GetName":{"zh":"该帝国","en":"that empire"},"other_empire.GetAdj":{"zh":"该国","en":"their"},"Root.Capital.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"namarian.523","kind":"event","title":{"zh":"加密通讯","en":"Encrypted Transmission"},"texts":[{"zh":"我们需要得到实际的利益。就算是能够确保得到£energy£1000也比[other_empire.GetAdj]天体居民的承诺靠谱。","en":"We would need something to show for it. Even £energy£ 1000 would be more than whatever the fleet would get out of the [other_empire.GetAdj] orb-dwellers."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"namarian.523.c","label":{"zh":"成交。","en":"Deal."},"responses":[],"tooltips":[],"conditional":true,"next":[{"target":"namarian.524","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:3517","story":"event-namarian-3"}],"terminal":false,"when":[[{"type":"other","key":"resource_stockpile_compare","arg":"{…}","scope":"","value":true}]]},{"key":"namarian.523.a","label":{"zh":"没门。","en":"No deal."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"namarian.526","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:3527","story":"event-namarian-3"}],"terminal":false},{"key":"namarian.523.b","label":{"zh":"我们付不起。","en":"We cannot afford that."},"responses":[],"tooltips":[],"conditional":true,"next":[{"target":"namarian.526","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:3534","story":"event-namarian-3"}],"terminal":false,"when":[[{"type":"other","key":"resource_stockpile_compare","arg":"{…}","scope":"","value":true}]]