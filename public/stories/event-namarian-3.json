e conscientious interloper in its midst - two fleets totaling 10 military vessels have been delivered to the [Root.Capital.GetStarName] system and are orbiting our capital."}],"sections":[],"image":"art/b5b6c7440ae71484e037.webp","hidden":false,"choices":[{"key":"OK","label":{"zh":"确认","en":"OK"},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false,"clears":["nomad_on_mission"]}],"next":[],"source":{"file":"events/namarian_events.txt","line":3656},"body":[{"pieces":[{"text":0}],"when":[[{"type":"flag","scope":"country","name":"double_fleet","path":"","value":false}]]},{"pieces":[{"text":1}],"when":[[{"type":"flag","scope":"country","name":"double_fleet","path":"","value":true}]]}],"sets":["nomad_ships_sold"],"names":{"Root.Capital.GetStarName":{"zh":"这颗恒星","en":"the star"}}},{"id":"namarian.512","kind":"event","title":{"zh":"游牧民族贸易提案","en":"Nomad Trade Proposal"},"texts":[{"zh":"我们清楚自己产品的价值，天体居民。我们要的不多。","en":"We know what our creations are worth, orb-dweller. We do not ask for much."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"namarian.511.a","label":{"zh":"我们非常乐意支付2000£energy£。","en":"We will happily ease your burden for £energy£ 2000."},"responses":[],"tooltips":[],"conditional":true,"next":[{"target":"namarian.514","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:3149","story":"event-namarian-3"}],"terminal":false,"allow":[[{"type":"other","key":"resource_stockpile_compare","arg":"{…}","scope":"","value":true}]]},{"key":"namarian.511.e","label":{"zh":"我们愿意支付2000£minerals£。","en":"We will take them for £minerals£ 2000."},"responses":[],"tooltips":[],"conditional":true,"next":[{"target":"namarian.514","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/namarian_events.txt:3160","story":"event-namarian-3"}],"terminal":false,"allow":[[{"type":"other","key":"resource_stockpile_compare","arg":"{…}","scope":"","value":true}]]},{