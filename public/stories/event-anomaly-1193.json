lony.GetName]."}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"other","key":"has_policy_flag","arg":"ai_outlawed","scope":"","value":false},{"type":"other","key":"any_planet_within_border","arg":"{…}","scope":"","value":true}]],"allow":[[{"type":"other","key":"has_policy_flag","arg":"ai_outlawed","scope":"","value":false},{"type":"other","key":"any_planet_within_border","arg":"{…}","scope":"","value":true}]]},{"key":"anomaly.189.b","label":{"zh":"还是分道扬镳比较好。","en":"It's better if we part ways."},"responses":[],"tooltips":[{"zh":"外星人们将去其它地方安家。","en":"The aliens will look for a new home elsewhere."}],"conditional":true,"next":[{"target":"anomaly.1196","kind":"option","conditional":true,"delayed":true,"sourceKind":"option","group":"c569","delay":[{"days":"10"}],"when":[[[{"type":"other","key":"any_system","arg":"{…}","scope":"","value":true}]]],"through":["anomaly.1197"],"source":"events/anomaly_events_1.txt:5313","hooks":["immediate"],"story":"event-anomaly-1193"},{"target":"anomaly.1195","kind":"option","conditional":true,"delayed":true,"sourceKind":"option","group":"c569","delay":[{"days":"40"}],"when":[[[{"type":"other","key":"any_system","arg":"{…}","scope":"","value":false}]]],"through":["anomaly.1197"],"source":"events/anomaly_events_1.txt:5313","hooks":["immediate"],"story":"event-anomaly-1193"}],"terminal":false,"when":[[{"type":"other","key":"has_policy_flag","arg":"ai_outlawed","scope":"","value":false},{"type":"other","key":"any_system","arg":"{…}","scope":"","value":true}]],"allow":[[{"type":"other","key":"has_policy_flag","arg":"ai_outlawed","scope":"","value":false},{"type":"other","key":"any_system","arg":"{…}","scope":"","value":true}]]},{"key":"anomaly.189.c","label":{"zh":"拆掉它们。","en":"Dismantle them."},"responses":[],"tooltips":[{"zh":"清除[Root.Capital.GetName]的数据库中的神经网路投影。","en":"Purge the neural scans from the databanks on [Root.Capital.GetName]."}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"other","key":"has_policy_flag","arg":"ai_servitude","scope":"","value":true}]]}],"next":[],"source":{"file":"events/anomaly_events_1.txt","line":5204},"names":{"Root.Capital.GetName":{"zh":"这颗星球","en":"this planet"},"new_colony.GetName":{"zh":"这颗星球","en":"this planet"}},"alsoIn":["anomaly-barr-base-cat"]},{"id":"anomaly.1196","kind":"event","title":{"zh":"生死弥留：觉醒者","en":"Limbo: the Awoken"},"texts":[{"zh":"有报告称，意识被我们上传至机器人的外星人已经成功对一颗行星进行了殖民，他们现在自称“觉醒者”。","en":"Reports are coming in that the aliens, whose minds we uploaded to robotic bodies, have colonized a planet and now style themselves \"the Awoken.\""}],"sections":[],"image":"art/6be17562d05ffabd6d89.webp","hidden":false,"choices":[{"key":"OK","label":{"zh":"确认","en":"OK"},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/anomaly_events_1.txt","line":5662},"alsoIn":["anomaly-barr-base-cat"]},{"id":"anomaly.1195","kind":"event","title":{"zh":"生死弥留：离去","en":"Limbo: Gone"},"texts":[{"zh":"那些外星人，在我们将其神经模式传输到机器人躯体以后，离开了我们的帝国。他们在某一个清晨聚集在一小群民用航天器上，设定了前往遥远星系的航线。到目前为止，我们还没有听到他们的回音，我们可能永远不会知道他们是否到达了目的地。","en":"The aliens, whose minds we uploaded to robotic bodies, have left. They gathered early one morning on a small fleet of civilian spacecraft, setting course for a distant star system. So far we haven't heard back from them and we may never learn whether they reached their destination."}],"sections":[],"image":"art/602eb656c2e9a341b17b.webp","hidden":false,"choices":[{"key":"OK","label":{"zh":"确认","en":"OK"},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/anomaly_events_1.txt","line":5646},"alsoIn":["anomaly-barr-base-cat"]},{"id":"anomaly.1198","kind":"event","title":{"zh":"生死弥留：新的开始","en":"Limbo: a New Beginning"},"texts":[{"zh":"在多次尝试之后，工程部门终于将灭绝的外星人的神经扫描结果上传到了机器人中，结果十分令人惊喜。古代外星人已经彻底恢复了意识，并表达了加入我们帝国的意愿，希望我们能够允许他们在我们领域内的一个新星球上进行殖民。","en":"After many trials the engineering department has finally managed to transfer the extinct aliens' neural scans to robotic bodies, and the results are exhilarating. The ancient aliens have fully regained consciousness and have expressed a desire to join our empire, requesting our permission to colonize a new planet within our borders."}],"sections":[],"image":"art/457068dfc94aacecf6d6.webp","hidden":false,"choices":[{"key":"anomaly.189.a","label":{"zh":"荣幸之至。","en":"We would be honored."},"responses":[],"tooltips":[{"zh":"外星人加入我方帝国并在[new_colony.GetName]定居。","en":"The aliens join our empire and colonize [new_colony.GetName]."}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"other","key":"any_planet_within_border","arg":"{…}","scope":"","value":true},{"type":"other","key":"has_policy_flag","arg":"ai_outlawed","scope":"","value":false}]],"allow":[[{"type":"other","key":"has_policy_flag","arg":"ai_outlawed","scope":"","value":false},{"type":"other","key":"any_planet_within_border","arg":"{…}","scope":"","value":true}]]},{"key":"anomaly.1198.a","label":{"zh":"还是分道扬镳比较好。","en":"It's better if we part ways."},"responses":[],"tooltips":[{"zh":"外星人们将去其它地方安家。","en":"The aliens will look for a new home elsewhere."}],"conditional":false,"next":[{"target":"anomaly.1195","kind":"option","conditional":false,"delayed":true,"sourceKind":"option","delay":[{"days":"40"}],"source":"events/anomaly_events_1.txt:5804","story":"event-anomaly-1193"}],"terminal":false},{"key":"anomaly.189.c","label":{"zh":"拆掉它们。","en":"Dismantle them."},"responses":[],"tooltips":[{"zh":"清除[Root.Capital.GetName]的数据库中的神经网路投影。","en":"Purge the neural scans from the databanks on [Root.Capital.GetName]."}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"other","key":"has_policy_flag","arg":"ai_servitude","scope":"","value":true}]]}],"next":[],"source":{"file":"events/anomaly_events_1.txt","line":5678},"names":{"Root.Capital.GetName":{"zh":"这颗星球","en":"this planet"},"new_colony.GetName":{"zh":"这颗星球","en":"this planet"}},"alsoIn":["anomaly-barr-base-cat"]},{"id":"anomaly.1200","kind":"event","title":{"zh":"生死弥留：觉醒者","en":"Limbo: the Awoken"},"texts":[{"zh":"在多次尝试之后，我们的工程师终于将灭绝外星人的神经扫描结果上传到了机器人中，结果十分令人惊喜。古代外星人已经彻底恢复了意识，并表达了要重建自己帝国的意愿。我们的驿站网络已标定了一颗可以作为他们新家园的星球。","en":"After many trials our engineers have finally managed to transfer the extinct aliens' neural scans to robotic bodies, and the results are exhilarating. The ancient aliens have fully regained consciousness and have expressed a desire to strike out on their own and rebuild their empire. Our Waystation network has charted a world that could serve as their new home."}],"sections":[],"image":"art/457068dfc94aacecf6d6.webp","hidden":false,"choices":[{"key":"anomaly.189.c","label":{"zh":"拆掉它们。","en":"Dismantle them."},"responses":[],"tooltips":[{"zh":"清除[Root.Capital.GetName]的数据库中的神经网路投影。","en":"Purge the neural scans from the databanks on [Root.Capital.GetName]."}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"other","key":"has_policy_flag","arg":"ai_servitude","scope":"","value":true}]]},{"key":"anomaly.1200.a","label":{"zh":"让他们去我们驿站附近的一颗星球。","en":"Direct them to a world near our Waystations."},"responses":[],"tooltips":[{"zh":"外星人们将去其它地方安家。","en":"The aliens will look for a new home elsewhere."}],"conditional":true,"next":[{"target":"anomaly.1196","kind":"option","conditional":false,"delayed":true,"sourceKind":"option","delay":[{"days":"10"}],"source":"events/anomaly_events_1.txt:6305","story":"event-anomaly-1193"}],"terminal":false,"when":[[{"type":"other","key":"has_policy_flag","arg":"ai_outlawed","scope":"","value":false},{"type":"other","key":"any_owned_nonprimary_starbase","arg":"{…}","scope":"","value":true}]],"allow":[[{"type":"other","key":"has_policy_flag","arg":"ai_outlawed","scope":"","value":false},{"type":"other","key":"any_owned_nonprimary_starbase","arg":"{…}","scope":"","value":true}]],"sets":["limbo_country","synthetic_empire"]}],"next":[],"source":{"file":"events/anomaly_events_1.txt","line":6088},"names":{"Root.Capital.GetName":{"zh":"这颗星球","en":"this planet"}},"alsoIn":["anomaly-barr-base-cat"]},{"id":"anomaly.1199","kind":"event","title":{"zh":"生死弥留：觉醒","en":"Limbo: Awakening"},"texts":[{"zh":"在多次尝试之后，工程部门终于将灭绝外星人的神经扫描结果上传到了机器人中，结果十分令人惊喜。古代外星人已经彻底恢复了意识，并表达了要重建自己帝国的意愿。","en":"After many trials the engineering department has finally managed to transfer the extinct aliens' neural scans to robotic bodies, and the results are exhilarating. The ancient aliens have fully regained consciousness and have expressed a desire to strike out on their own and rebuild their empire."}],"sections":[],"image":"art/457068dfc94aacecf6d6.webp","hidden":false,"choices":[{"key":"anomaly.189.c","label":{"zh":"拆掉它们。","en":"Dismantle them."},"responses":[],"tooltips":[{"zh":"清除[Root.Capital.GetName]的数据库中的神经网路投影。","en":"Purge the neural scans from the databanks on [Root.Capital.GetName]."}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"other","key":"has_policy_flag","arg":"ai_servitude","scope":"","value":true}]]},{"key":"anomaly.1199.a","label":{"zh":"我们不会阻拦。","en":"We won't stand in their way."},"responses":[],"tooltips":[{"zh":"外星人们将去其它地方安家。","en":"The aliens will look for a new home elsewhere."}],"conditional":true,"next":[{"target":"anomaly.1196","kind":"option","conditional":false,"delayed":true,"sourceKind":"option","delay":[{"days":"10"}],"source":"events/anomaly_events_1.txt:6080","story":"event-anomaly-1193"}],"terminal":false,"when":[[{"type":"other","key":"has_policy_flag","arg":"ai_outlawed","scope":"","value":false},{"type":"other","key":"any_system","arg":"{…}","scope":"","value":true}]],"allow":[[{"type":"other","key":"has_policy_flag","arg":"ai_outlawed","scope":"","value":false},{"type":"other","key":"any_system","arg":"{…}","scope":"","value":true}]],"sets":["limbo_country","synthetic_empire"]}],"next":[],"source":{"file":"events/anomaly_events_1.txt","line":5817},"names":{"Root.Capital.GetName":{"zh":"这颗星球","en":"this planet"}},"alsoIn":["anomaly-barr-base-cat"]},{"id":"anomaly.1190","kind":"event","title":{"zh":"生死弥留：线缆中的灵魂","en":"Limbo: Spirits in the Wires"},"texts":[{"zh":"工程部门带回了令人高度担忧的消息。在“生死弥留”项目期限最后一天的工作中，科学家们再一次尝试将外星人的神经扫描结果上传到机器人身体的工作似乎还是失败了，但在第二天科学家们回来的时候，却发现那些机器人都不见了。\n\n有些人猜测，上传尝试其实已经成功了，是外星人趁夜间瞧瞧出逃，也有人说这是个精心设计的骗局。我们看来是无从确认了……","en":"The engineering department has returned with some highly disturbing news. After concluding the final day of \"Project Limbo\" with yet another seemingly failed attempt at uploading the alien neural scans to robotic bodies, the scientists returned the following day to find the robots missing.\n\nSome believe the attempt succeeded after all and that the aliens stole away in the night, others that it's an elaborate hoax. We may never know for sure..."}],"sections":[],"image":"art/6be17562d05ffabd6d89.webp","hidden":false,"choices":[{"key":"anomaly.1190.a","label":{"zh":"干得漂亮。","en":"Remarkable."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/anomaly_events_1.txt","line":5546},"alsoIn":["anomaly-barr-base-cat"]}]}