path":"","value":false},{"type":"other","key":"counter","arg":"clues","scope":"has_completed_event_chain_counter","value":false}]]],"source":"common/scripted_effects/00_scripted_effects.txt:17","story":"event-distar-9000"}],"terminal":false,"sets":["lcluster_clue_desc_2"]}],"next":[],"source":{"file":"events/distant_stars_events_2.txt","line":2025},"names":{"big_rip_planet.GetName":{"zh":"这颗星球","en":"this planet"}}}]}