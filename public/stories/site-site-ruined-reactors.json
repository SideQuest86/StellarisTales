{"story":{"id":"site-site-ruined-reactors","title":{"zh":"损毁反应堆","en":"Ruined Reactors"},"category":"precursors","kind":"site","image":"art/a0e295ed3c881e8c227f.webp","start":"archaeological_site_types:site_ruined_reactors","chapters":6,"visible":true,"excerpt":{"zh":"[from.Planet.GetName]表面居高不下的辐射水平指向了一座破旧的反应堆复合体。这座孤零零的设施似乎废弃已久，有待调查。","en":"Elevated radiation levels on the surface of [from.Planet.GetName] were traced to a dilapidated reactor complex. The isolated facility appears inactive and warrants investigation."},"tree":{"root":"n0","nodes":{"n0":{"doc":null,"children":["n1"]},"n1":{"doc":"archaeological_site_types:site_ruined_reactors","parent":"n0","via":{"kind":"entry"},"children":["n2","n3","n4","n5","n6"]},"n2":{"doc":"extreme_frontiers.1200","parent":"n1","via":{"hooks":["stage:","stage_event"],"kind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:143"},"children":[]},"n3":{"doc":"extreme_frontiers.1205","parent":"n1","via":{"hooks":["stage:","stage_event"],"kind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:149"},"children":[]},"n4":{"doc":"extreme_frontiers.1210","parent":"n1","via":{"hooks":["stage:","stage_event"],"kind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:155"},"children":[]},"n5":{"doc":"extreme_frontiers.1215","parent":"n1","via":{"hooks":["stage:","stage_event"],"kind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:161"},"children":[]},"n6":{"doc":"extreme_frontiers.1220","parent":"n1","via":{"hooks":["stage:","stage_event"],"kind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:167"},"children":[]}}}},"chapters":[{"id":"archaeological_site_types:site_ruined_reactors","kind":"site","title":{"zh":"损毁反应堆","en":"Ruined Reactors"},"texts":[{"zh":"[from.Planet.GetName]表面居高不下的辐射水平指向了一座破旧的反应堆复合体。这座孤零零的设施似乎废弃已久，有待调查。","en":"Elevated radiation levels on the surface of [from.Planet.GetName] were traced to a dilapidated reactor complex. The isolated facility appears inactive and warrants investigation."}],"sections":[{"zh":"[from.Planet.GetName]表面居高不下的辐射水平指向了一座破旧的反应堆复合体。这座孤零零的设施似乎废弃已久，有待调查。","en":"Elevated radiation levels on the surface of [from.Planet.GetName] were traced to a dilapidated reactor complex. The isolated facility appears inactive and warrants investigation."}],"image":"art/a0e295ed3c881e8c227f.webp","hidden":false,"choices":[],"next":[{"target":"extreme_frontiers.1200","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:143","hooks":["stage:","stage_event"],"story":"site-site-ruined-reactors"},{"target":"extreme_frontiers.1205","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:149","hooks":["stage:","stage_event"],"story":"site-site-ruined-reactors"},{"target":"extreme_frontiers.1210","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:155","hooks":["stage:","stage_event"],"story":"site-site-ruined-reactors"},{"target":"extreme_frontiers.1215","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:161","hooks":["stage:","stage_event"],"story":"site-site-ruined-reactors"},{"target":"extreme_frontiers.1220","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt:167","hooks":["stage:","stage_event"],"story":"site-site-ruined-reactors"},{"target":"ancrel.8000","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0002,"group":"r29891","modified":true,"source":"common/scripted_effects/archaeology