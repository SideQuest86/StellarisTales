6","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8070","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29891","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:29","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8075","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0007,"group":"r29891","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:35","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8080","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29891","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:36","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8110","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29891","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:37","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"federations2.701","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29891","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:51","hooks":["on_roll_failed"],"story":"event-federations2-701"},{"target":"ancrel.4078","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0018,"group":"r29891","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:64","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.13030","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29891","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:71","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4006","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29891","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:90","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4021","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29891","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:104","hooks":["on_roll_failed"],"story":"archaeology-incidents"}],"source":{"file":"common/archaeological_site_types/12_extreme_frontiers_arc_sites.txt","line":114},"names":{"from.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"extreme_frontiers.1200","kind":"event","title":{"zh":"远古反应堆发电站","en":"Ancient Reactor Plant"},"texts":[{"zh":"这座位于[from.Planet.GetName]的陈旧设施是一座废弃的反应堆发电站。放射性半衰期计算表明这里在超过一万年前发生过严重的污染事故。\n\n这里的系统已离线，物理结构呈现出明显的大规模受损迹象。","en":"The aging facility on [from.Planet.GetName] is an abandoned reactor power plant. Radiation half life calculations suggest a serious containment failure occurred here over 10,000 years ago.\n\nSystems are offline and the physical structure shows signs of significant damage throughout."}],"sections":[],"image":"art/a0e295ed3c881e8c227f.webp","hidden":false,"choices":[{"key":"extreme_frontiers.1200.a","label":{"zh":"谨慎前进。","en":"Proceed with care."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/extreme_frontiers_events.txt","line":3214},"names":{"from.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"extreme_frontiers.1205","kind":"event","title":{"zh":"灾难性堆芯熔毁","en":"Catastrophic Meltdown"},"texts":[{"zh":"[from.Planet.GetName]的许多反应堆呈现出了严重堆芯熔毁的迹象。许多安全壳被液化成了放射性废渣。\n\n设施的这一部分遍地是扭曲的金属和破裂的冷凝管。尽管数据腐化严重，我们还是确认这里尝试过紧急关闭措施，但根本没有成功。","en":"Several of the reactors on [from.Planet.GetName] shows signs of severe meltdown. Many of the containment vessels have been liquefied into radioactive slag.\n\nThis section of the facility is littered with twisted metal and ruptured coolant tubes. Despite heavy data corruption we were able to determine that an emergency shutdown procedure was initiated but never completed."}],"sections":[],"image":"art/3a493b9cb80e53d343e5.webp","hidden":false,"choices":[{"key":"extreme_frontiers.1205.a","label":{"zh":"真是不幸。","en":"Unfortunate."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/extreme_frontiers_events.txt","line":3258},"names":{"from.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"extreme_frontiers.1210","kind":"event","title":{"zh":"设计失败","en":"Design Failures"},"texts":[{"zh":"[leader.GetName]发现了[from.Planet.GetName]上的这座原始的裂变设施在设计上的主要缺陷。\n\n尽管这里有数十个反应堆，但只安装有最小量的冷却系统。设施的系统只有很低限度的自动化，需要大量的劳动力来维持其正常的运转条件。这显然是由一群还没有完全掌握基本核原理的人建造的。","en":"[leader.GetName] identified major flaws in the design of the crude nuclear fission facility on [from.Planet.GetName].\n\nDespite the presence of dozens of reactors, only minimal cooling systems were attached. Few of the site's systems are automated, necessitating a large workforce to maintain its normal operating conditions. It was clearly built by those who had yet to fully master even the most basic of nuclear principles."}],"sections":[],"image":"art/1b0b556b6473a35fe2e0.webp","hidden":false,"choices":[{"key":"extreme_frontiers.1210.a","label":{"zh":"无知的代价很昂贵。","en":"Ignorance is costly."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/extreme_frontiers_events.txt","line":3302},"names":{"leader.GetName":{"zh":"这位领袖","en":"the leader"},"from.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"extreme_frontiers.1215","kind":"event","title":{"zh":"撤离残迹","en":"Evacuation Remnants"},"texts":[{"zh":"在[from.Planet.GetName]核设施内解锁一系列封锁的防爆门后，我们发现了一个紧急撤离区域。\n\n这些小型机库有着一排快速发射的穿梭机泊位，其中大多数是空的，被推进器烧焦的痕迹也表明数千年前这里有船只快速起飞过。\n\n最后一个泊位被一个扭曲的穿梭机残骸占据着，发射夹还未释放。我们从废墟中尽可能地进行了发掘，但没有找到任何乘员的遗体。","en":"After unlocking a set of sealed blast doors, we found an emergency evacuation zone within the reactor complex on [from.Planet.GetName].\n\nThe small hangar features a row of quick launch shuttle berths. Most are vacant and marked by thruster burns suggestive of a rapid vessel departure thousands of years ago.\n\nThe twisted wreckage of a shuttle occupies the final bay, its launch clamps still attached. We salvaged what we could from the debris, but no remains of any occupants could be found."}],"sections":[],"image":"art/72794ace98db33d6f908.webp","hidden":false,"choices":[{"key":"extreme_frontiers.1215.a","label":{"zh":"他们走得很急嘛。","en":"They left in a hurry."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/extreme_frontiers_events.txt","line":3346},"names":{"from.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"extreme_frontiers.1220","kind":"event","title":{"zh":"铀容器","en":"Uranium Vault"},"texts":[{"zh":"通过了一道道带铅板的安全门，我们进入了[from.Planet.GetName]核设施的地下部分。辐射计数器示数陡然上升。\n\n我们在其中发现了一个储存着数千个钢衬桶的大型舱室。有许多钢衬桶遭到火灾破坏，泄露着不稳定的铀和钚同位素。\n\n建造了这座设施的[leader.Owner.GetPreFTLLower]显然对循环回收核燃料不得章法。这些废弃的同位素仍然潜藏着庞大的能量。","en":"We entered the underground sections of the reactor facility on [from.Planet.GetName] through a series of lead plated security doors. Radiation readings rose sharply.\n\nInside we found a vast chamber storing thousands of steel lined casks. Many were fire damaged and leaking unstable uranium and plutonium isotopes.\n\nThe [leader.Owner.GetPreFTLLower] civilization that built this place had apparently not yet discovered methods for the proper recycling of nuclear fuel. These discarded isotopes still contain tremendous energetic potential."}],"sections":[],"image":"art/524021cef89338765c56.webp","hidden":false,"choices":[{"key":"extreme_frontiers.1220.a","label":{"zh":"俭以防匮。","en":"Waste not, want not."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/extreme_frontiers_events.txt","line":3390},"names":{"from.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}}]}