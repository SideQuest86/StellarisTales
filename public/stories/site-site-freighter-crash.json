p":"r29589","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:35","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8080","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29589","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:36","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8110","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29589","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:37","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"federations2.701","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29589","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:51","hooks":["on_roll_failed"],"story":"event-federations2-701"},{"target":"ancrel.4078","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0018,"group":"r29589","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:64","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.13030","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29589","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:71","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4006","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29589","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:90","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4021","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29589","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:104","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"story.5","kind":"delay","conditional":false,"delayed":true,"sourceKind":"delay","delay":[{"days":"30"}],"source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt:451","story":"origin_fear_of_the_dark"}],"source":{"file":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","line":424}},{"id":"ancrel.6300","kind":"event","title":{"zh":"舰长航行日志","en":"Captain's Chronicle"},"texts":[{"zh":"我们从那些应该是舰桥的地方找回了很多航行日志：\n\n“舰长航行日志。开始记录。\n\n迫降于行星55-23-X号。无能的船员们应受责备。沙德巴，伍克尔和迪巴拉克三世未能幸存。皮尔瓦克斯失去了两个次级附肢和十一个眼睛——生命仍处于危险状态，能否生存依旧未知。其余安好。等待救援，但是被愚蠢的生物包围着，十分悲伤。”","en":"A log of sorts was recovered from what is believed to have served as the spacecraft's bridge:\n\n\"Captain's chronicle. Begin recording.\n\nMade forced landing on planet 55-23-X. Incompetent crew to blame. Shadba, Vuxal, and Dibrak the Third did not survive. Pirvax lost two secondary appendages and eleven of his eyes - remains in critical condition, survival doubtful. Rest are fine. Awaiting rescue, but surrounded by idiots. Very depressed.\""}],"sections":[],"image":"art/8ea0220070ff004d5793.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.6310","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-freighter-crash"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1731}},{"id":"ancrel.6310","kind":"event","title":{"zh":"大副的报告","en":"First Mate's Report"},"texts":[{"zh":"已找到另一篇日志并翻译：\n\n“大副尤瑟尔记录。舰长已被安然的存放在C号杂物橱中。那个笨手笨脚的傻瓜是这一切的罪魁祸首。现在由我指挥。总工程师扎布拉现在正试着做一个子空间信号发射机。我们离企业贸易线路太远了，没有那个机器，恐怕我们永远都不会获救。\n\n皮尔瓦克斯又失去了一只眼睛。他可能等不到那一天了。”","en":"Another log has been found and translated:\n\n\"First Mate Ythar speaking. Captain has been safely stowed in Utility Closet C. That bumbling fool is to blame for everything. I am in command now. Chief Engineer Zarbla is working on a subspace transmitter. Without one, I fear we'll never get rescued as we're too far off the corporate trade routes.\n\nPirvax lost another eye. Likely won't last the day.\""}],"sections":[],"image":"art/80aca0711ce001dcbf46.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.6320","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-freighter-crash"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1757}},{"id":"ancrel.6320","kind":"event","title":{"zh":"食物状况","en":"Food Situation"},"texts":[{"zh":"又一篇已翻译的日志：\n\n“食物已经耗尽，五个周期前我们就开始吃死者的尸体，现在已经不够了。所以我们投票决定分食舰长。扎布拉工程师还在努力制造出子空间信号发射器。她向我保证它几乎要完成了。看起来它非常的复杂。\n\n皮尔瓦克斯的最后一个次级附肢已经萎缩并变成洋红色，他就要死了。”","en":"Yet another translated log:\n\n\"Running out of food. Ate our dead five cycles ago, but not enough to last us. We had a vote, and decided to eat the Captain. Engineer Zarbla still working hard on subspace transmitter. She assures me it is nearly complete. It looks very complex.\n\nPirvax's last secondary appendage has shriveled up and turned magenta. Death is near.\""}],"sections":[],"image":"art/872246aedc238ff28ba5.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.6330","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-freighter-crash"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1783}},{"id":"ancrel.6330","kind":"event","title":{"zh":"骗局","en":"The Fraud"},"texts":[{"zh":"来自大副尤瑟尔的另一篇日志：\n\n“与扎布拉就亚空间发射器进行了质询。事实证明她只是把一堆垃圾和松散的电缆硬塞进空油罐而已。她甚至不是真正的工程师。\n\n皮尔瓦克斯的胸窦正在渗出体液。将会很快迎来死亡。真羡慕啊。”","en":"Another log from First Mate Ythar:\n\n\"Confronted Zarbla about the subspace transmitter. Turns out she had just shoved a bunch of junk and loose cables into an empty fuel canister. She's not even a real engineer.\n\nPirvax is now leaking fluids from his mesothorax. Will surely perish soon. Envious.\""}],"sections":[],"image":"art/50652ce2542ec8035c5c.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.6340","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-freighter-crash"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1809}},{"id":"ancrel.6340","kind":"event","title":{"zh":"三副的报告","en":"Third Mate's Report"},"texts":[{"zh":"这篇已翻译的日志似乎记录自三副乌克拉：\n\n“大副尤瑟尔昨天通过切断自己的触须自杀了。技术员（二等）米斯瓦不久之后宣称自己是女皇，但因由食物引发的骚乱被驱逐至下甲板。我们的情况十分严峻。同类相食的情况普遍存在。\n\n皮尔瓦克斯在昨天腹部发生炸裂之后整个身体都变的潮红。理应已经死去，但依旧存活。目前被伽马相移当做神灵来崇拜。”","en":"This translated log appears to have been recorded by Uxla, the Third Mate:\n\n\"First Mate Ythar committed suicide by ripping off his own antennas yesterday. Technician (2nd class) Misiva declared herself Empress shortly afterwards, but food riots forced her into exile on the lower decks. Situation very bleak. Cannibalism widespread.\n\nPirvax has turned entirely magenta after his lower abdomen exploded yesterday. Should be dead, but is not. Now worshipped as deity by gamma shift.\""}],"sections":[],"image":"art/114a28677a447f6d61c7.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.6350","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-freighter-crash"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1835}},{"id":"ancrel.6350","kind":"event","title":{"zh":"巡逻日志","en":"Patrol Log"},"texts":[{"zh":"最后的日志已被发现并翻译：\n\n“巡逻日志，船副吉尔伽美。在55-23-X侦测到坠毁的船只，前往调查。船只被鉴定为莱文克号，一艘P级货船。在残骸中发现了仅存的生还者，处于十分危急的状况。其身份被确认是皮尔瓦克斯，副水手长。\n\n剩下的船员不是在坠毁中遇难就是在我们到来不久之前互相厮杀。按照标准协议，我将这份日志留在这里并将莱文克号注册为保护墓地。记录结束。”","en":"One last log has been found and translated:\n\n\"Patrol log, Officer Gilgamm. Detected crashed vessel on 55-23-X, moved to investigate. Vessel identified as the Ravink, a class-P modular freighter. A single survivor in critical condition was recovered from the wreckage. Identity confirmed as Pirvax, Boatswain's mate.\n\nRemaining crew either perished in crash or turned on each other shortly before our arrival. As per standard protocol, I am leaving this log here and registering the Ravink as a protected grave site. End recording.\""}],"sections":[],"image":"art/b13b1b705655211a950c.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1861}}]}