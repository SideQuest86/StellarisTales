heck_variable","value":false}]]],"source":"common/scripted_effects/first_contact_dlc_effects.txt:36","story":"event-preftl-operation-1045"}],"terminal":false}],"next":[],"source":{"file":"events/first_contact_dlc_operations_events.txt","line":551},"names":{"from.target.GetSpeciesAdj":{"zh":"该族","en":"the species'"}}},{"id":"preftl_operation.1046","kind":"event","title":{"zh":"[from.target.GetName]：一日千里","en":"[from.target.GetName]: One Giant Leap"},"texts":[{"zh":"成功了！我们向[from.target.GetSpeciesAdj]社会播撒的科技和知识蓬勃发展，从内部大大推进了他们的文明。只有时间才能说明由此可能产生的长期影响，但目前我们的特工报告说，[from.target.capital_scope.GetName]相当繁荣，善意空前。","en":"Success! The technology and knowledge we sowed into [from.target.GetSpeciesAdj] society has flourished, greatly advancing their civilization from within. Only time will tell what long-term impacts this may have, but for now our operatives report a great deal of good will and prosperity down on [from.target.capital_scope.GetName]."}],"sections":[],"image":"art/6bd95df5a4155ed7d62b.webp","hidden":false,"choices":[{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[{"zh":"[pre_ftl_country.GetName]：+[pre_ftl_country.TechProgressPercentage]%科技进步。","en":"[pre_ftl_country.GetName]: +[pre_ftl_country.TechProgressPercentage]% Technological Progression."}],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/first_contact_dlc_operations_events.txt","line":582},"names":{"pre_ftl_country.GetName":{"zh":"该帝国","en":"that empire"},"from.target.GetSpeciesAdj":{"zh":"该族","en":"the species'"},"from.target.capital_scope.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"preftl_operation.1047","kind":"event","title":{"zh":"[from.target.GetName]：重大飞跃","en":"[from.target.GetName]: A Sizeable Leap"},"texts":[{"zh":"我们的特工从[from.target.capital_scope.GetName]传来捷报！我们向[from.target.GetSpeciesAdj]社会播撒的科技和知识已开花结果，推动他们的文明向星系进发。只有时间才能说明由此可能产生的长期影响，但目前我们的特工报告说，[from.owner.GetPreFTLLower]星球的繁荣程度有所提高。","en":"Our operatives report good results on [from.target.capital_scope.GetName]! The technology and knowledge we sowed into [from.target.GetSpeciesAdj] society has borne fruit, nudging their civilization closer towards galactic involvement. Only time will tell what long-term impacts this may have, but for now our operatives report increased prosperity on the [from.owner.GetPreFTLLower] world."}],"sections":[],"image":"art/6bd95df5a4155ed7d62b.webp","hidden":false,"choices":[{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[{"zh":"[pre_ftl_country.GetName]：+[pre_ftl_country.TechProgressPercentage]%科技进步。","en":"[pre_ftl_country.GetName]: +[pre_ftl_country.TechProgressPercentage]% Technological Progression."}],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/first_contact_dlc_operations_events.txt","line":627},"names":{"pre_ftl_country.GetName":{"zh":"该帝国","en":"that empire"},"from.target.GetSpeciesAdj":{"zh":"该族","en":"the species'"},"from.target.capital_scope.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"preftl_operation.1049","kind":"event","title":{"zh":"[from.target.GetName]：好事多磨","en":"[from.target.GetName]: A Setback"},"texts":[{"zh":"我们启迪[from.target.capital_scope.GetName]居民的行动取得了部分成功。尽管遇到了一些挫折，我们还是促进了一些基础的科技进步，确信[from.target.GetSpeciesAdj]社会终会腾飞。不过他们的文明也许不会如我们此前希望的那样迅速或顺利地发展到星际层次。","en":"We have partially succeeded in enlightening the residents of [from.target.capital_scope.GetName]. Despite some setbacks, we have nevertheless encouraged some basic technological progress and are confident that [from.target.GetSpeciesAdj] society will eventually flourish. However, their civilization may not reach the stars quite as quickly or as smoothly as we had initially hoped."}],"sections":[],"image":"art/89fd21a3e94a2fd9b867.webp","hidden":false,"choices":[{"key":"OK","label":{"zh":"确认","en":"OK"},"responses":[],"tooltips":[{"zh":"[pre_ftl_country.GetName]：+[pre_ftl_country.TechProgressPercentage]%科技进步。","en":"[pre_ftl_country.GetName]: +[pre_ftl_country.TechProgressPercentage]% Technological Progression."}],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/first_contact_dlc_operations_events.txt","line":717},"names":{"pre_ftl_country.GetName":{"zh":"该帝国","en":"that empire"},"from.target.GetSpeciesAdj":{"zh":"该族","en":"the species'"},"from.target.capital_scope.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"preftl_operation.1048","kind":"event","title":{"zh":"[from.target.GetName]：稳步推进","en":"[from.target.GetName]: Solid Progress"},"texts":[{"zh":"我们的特工报告说，启迪[from.target.capital_scope.GetName]居民的行动圆满成功。我们传播给[from.target.GetSpeciesAdj]社会的科技和知识已经生根发芽，推动他们的文明在通往星海的道路上更进一步。","en":"Our operatives report a successful conclusion in our efforts to enlighten the residents of [from.target.capital_scope.GetName]. The technology and knowledge we introduced to [from.target.GetSpeciesAdj] society have taken root, bringing their civilization a little closer towards reaching the stars."}],"sections":[],"image":"art/6bd95df5a4155ed7d62b.webp","hidden":false,"choices":[{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[{"zh":"[pre_ftl_country.GetName]：+[pre_ftl_country.TechProgressPercentage]%科技进步。","en":"[pre_ftl_country.GetName]: +[pre_ftl_country.TechProgressPercentage]% Technological Progression."}],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/first_contact_dlc_operations_events.txt","line":672},"names":{"pre_ftl_country.GetName":{"zh":"该帝国","en":"that empire"},"from.target.GetSpeciesAdj":{"zh":"该族","en":"the species'"},"from.target.capital_scope.GetName":{"zh":"这颗星球","en":"this planet"}}}]}