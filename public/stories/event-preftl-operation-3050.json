actic_community_member","arg":"yes","scope":"owner","value":true}]],[[{"type":"other","key":"is_active_resolution","arg":"resolution_pre_ftl_stances_equal_standing","scope":"","value":true}]],[[{"type":"other","key":"current_awareness_level","arg":"full","scope":"target","value":true}]]],"kind":"option","source":"common/scripted_effects/first_contact_dlc_effects.txt:44"},"children":[]}}}},"chapters":[{"id":"preftl_operation.3050","kind":"event","title":{"zh":"[from.spynetwork.leader.GetName]暴露","en":"[from.spynetwork.leader.GetName] Exposed"},"texts":[{"zh":"发生了严重违规行为！间谍首脑 [from.spynetwork.leader.GetName]在一次秘访[from.target.capital_scope.GetName]地表时不慎暴露了踪迹。目前事故的细节仍在调查中，但[from.spynetwork.leader.GetHeShe]与当地的[from.target.GetSpeciesName]发生了短暂但直接的接触，他们一瞬间便落荒而逃。我们的特工尽力抓捕目击者，但目前仍一无所获。\n\n[from.GetName]行动仍在进展当中，但我们将采取特殊措施来遏制这场事故。","en":"A drastic breach has occurred! Spymaster [from.spynetwork.leader.GetName] has been compromised during a clandestine visit to the surface of [from.target.capital_scope.GetName]. Some details remain unclear for now, but [from.spynetwork.leader.GetHeShe] came into brief and direct contact with a native [from.target.GetSpeciesName], who promptly fled the scene. Our operatives moved to try and apprehend this witness, but their efforts have so far failed.\n\nOperation [from.GetName] remains in progress for now, but we have activated special measures until this breach can be contained."}],"sections":[],"image":"art/47bc22d36983ea03d770.webp","hidden":false,"choices":[{"key":"preftl_operation.3050.a","label":{"zh":"好，保持联系。","en":"Good. Keep us posted."},"responses":[],"tooltips":[],"conditional":true,"next":[{"target":"preftl_operation.3055","kind":"option","conditional":false,"delayed":true,"sourceKind":"option","delay":[{"days":"14"}],"source":"events/first_contact_dlc_operations_events.txt:2732","story":"event-preftl-operation-3050"}],"terminal":false,"when":[[{"type":"other","key":"has_policy_flag","arg":"interference_aggressive","scope":"from.owner","value":false}]],"labels":[{"label":{"zh":"好，保持联系。","en":"Good. Keep us posted."},"when":[[{"type":"other","key":"is_gestalt","arg":"no","scope":"from.owner","value":false}]]},{"label":{"zh":"继续监视。","en":"Continue monitoring."},"when":[[{"type":"other","key":"is_gestalt","arg":"yes","scope":"from.owner","value":true}]]}]},{"key":"preftl_operation.3050.b","label":{"zh":"逮住这个[from.target.GetSpeciesName]，让它从这世界上消失。","en":"Hunt this [from.target.GetSpeciesName] down and eliminate them."},"responses":[],"tooltips":[],"conditional":true,"next":[{"target":"preftl_operation.3051","kind":"option","conditional":false,"delayed":true,"sourceKind":"option","chance":0.8,"group":"r8870","delay":[{"days":"5"}],"source":"events/first_contact_dlc_operations_events.txt:2772","story":"event-preftl-operation-3050"},{"target":"preftl_operation.3055","kind":"option","conditional":true,"delayed":true,"sourceKind":"option","chance":0.2,"group":"r8870","delay":[{"days":"5"}],"modified":true,"source":"events/first_contact_dlc_operations_events.txt:2790","story":"event-preftl-operation-3050"}],"terminal":false,"when":[[{"type":"other","key":"has_policy_flag","arg":"interference_aggressive","scope":"from.owner","value":true}]],"allow":[[{"type":"other","key":"has_available_spy_power","arg":"5","scope":"from/spynetwork","value":true}]]},{"key":"preftl_operation.3050.c","label":{"zh":"太放肆了！我们必须中止行动。","en":"Outrageous! We must abort."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false},{"key":"preftl_operation.3050.d","label":{"zh":"我们应该告知[global_event_country.GetGalCommunityOrGalImperium]。","en":"We should notify the [global_event_country.GetGalCommunityOrGalImperium]."},"responses":[],"tooltips":[],"conditional":true,"next":[{"target":"preftl.10155","kind":"option","conditional":true,"delayed":true,"sourceKind":"option","group":"c8871","delay":[{"days":"3"}],"when":[[[{"type":"other","key":"is_galactic_community_formed","arg":"yes","scope":"owner","value":true},{"type":"other","key":"is_galactic_community_member","arg":"yes","scope":"owner","value":true}]],[[{"type":"other","key":"is_active_resolution","arg":"resolution_pre_ftl_stances_non_interference","scope":"","value":true}]]],"source":"common/scripted_effects/first_contact_dlc_effects.txt:18","story":"event-preftl-operation-3050"},{"target":"preftl.10055","kind":"option","conditional":true,"delayed":true,"sourceKind":"option","group":"c8871","delay":[{"days":"3"}],"when":[[[{"type":"other","key":"is_galactic_community_formed","arg":"yes","scope":"owner","value":true},{"type":"other","key":"is_galactic_community_member","arg":"yes","scope":"owner","value":true}]],[[{"type":"other","key":"is_active_resolution","arg":"resolution_pre_ftl_stances_equal_standing","scope":"","value":true},{"type":"other","key":"is_active_resolution","arg":"resolution_pre_ftl_stances_non_interference","scope":"","value":false}]]],"source":"common/scripted_effects/first_contact_dlc_effects.txt:34","story":"event-preftl-operation-3050"}],"terminal":false,"when":[[{"type":"other","key":"is_galactic_community_formed","arg":"yes","scope":"from.owner","value":true},{"type":"other","key":"is_galactic_community_member","arg":"yes","scope":"from.owner","value":true},{"type":"other","key":"is_active_resolution","arg":"resolution_pre_ftl_stances_non_interference","scope":"from.owner","value":true}],[{"type":"other","key":"is_galactic_community_formed","arg":"yes","scope":"from.owner","value":true},{"type":"other","key":"is_galactic_community_member","arg":"yes","scope":"from.owner","value":true},{"type":"other","key":"is_active_resolution","arg":"resolution_pre_ftl_stances_equal_standing","scope":"from.owner","value":true}]]}],"next":[],"source":{"file":"events/first_contact_dlc_operations_events.txt","line":2683},"names":{"from.spynetwork.leader.GetName":{"zh":"这位领袖","en":"the leader"},"from.target.capital_scope.GetName":{"zh":"这颗星球","en":"this planet"},"from.target.GetSpeciesName":{"zh":"该物种","en":"the species"},"from.spynetwork.leader.GetHeShe":{"zh":"此人","en":"they"}}},{"id":"preftl_operation.3055","kind":"event","title":{"zh":"敲诈勒索","en":"Blackmail"},"texts":[{"zh":"那个目睹我们最近入侵[from.target.GetName]的[from.target.GetSpeciesName]不仅仍然在逃遁，甚至还向我们发出了粗暴的最后通牒。这个目击者威胁要揭露我们的间谍首脑——除此之外还有[from.owner.GetName]——我们是如何对[from.target.GetSpeciesAdj]的事务进行插足干涉的。\n\n这个厚颜无耻的家伙通过待在人口稠密的地区来阻挠我们，在那里我们不能在没有暴露风险的情况下对它采取什么措施。我们或许干脆就同意此人的要求算了。","en":"The [from.target.GetSpeciesName] who witnessed our recent breach in the [from.target.GetName] is not only still at large, but has delivered us a crude ultimatum. The witness threatens to expose our Spymaster - and by extension, the [from.owner.GetName] - for our interference in [from.target.GetSpeciesAdj] affairs.\n\nThis brazen individual keeps us at bay by remaining in heavily-populated areas, where we cannot act against them without fear of further exposure. We may instead wish to simply meet their demands."}],"sections":[],"image":"art/47bc22d36983ea03d770.webp","hidden":false,"choices":[{"key":"preftl_operation.3055.a","label":{"zh":"不可接受。中止行动，立即撤退。","en":"Unacceptable. Abort, and retreat."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false},{"key":"preftl_operation.3055.b","label":{"zh":"我们绝不进行谈判。消灭目击者。","en":"We will not negotiate. Eliminate the witness."},"responses":[],"tooltips":[],"conditional":true,"next":[{"target":"preftl.10150","kind":"option","conditional":true,"delayed":true,"sourceKind":"option","group":"c8875","delay":[{"days":"3"}],"when":[[[{"type":"other","key":"is_galactic_community_formed","arg":"yes","scope":"owner","value":true},{"type":"other","key":"is_galactic_community_member","arg":"yes","scope":"owner","value":true}]],[[{"type":"other","key":"is_active_resolution","arg":"resolution_pre_ftl_stances_non_interference","scope":"","value":true}]],[[{"type":"other","key":"current_awareness_level","arg":"full","scope":"target","value":true}]]],"source":"common/scripted_effects/first_contact_dlc_effects.txt:22","story":"event-preftl-operation-3050"},{"target":"preftl.10050","kind":"option","conditional":true,"delayed":true,"sourceKind":"option","group":"c8875","delay":[{"days":"3"}],"when":[[[{"type":"other","key":"is_galactic_community_formed","arg":"yes","scope":"owner","value":true},{"type":"other","key":"is_galactic_community_member","arg":"yes","scope":"owner","value":true}]],[[{"type":"other","key":"is_active_resolution","arg":"resolution_pre_ftl_stances_equal_standing","scope":"","value":true}]],[[{"type":"other","key":"current_awareness_level","arg":"full","scope":"target","value":true}]]],"source":"common/scripted_effects/first_contact_dlc_effects.txt:44","story":"event-preftl-operation-3050"}],"terminal":false,"when":[[{"type":"other","key":"has_espionage_operation_flag","arg":"blackmail_attempted_assassination","scope":"from","value":false}]],"allow":[[{"type":"other","key":"has_policy_flag","arg":"interference_not_allowed","scope":"from/owner","value":false},{"type":"other","key":"has_available_spy_power","arg":"5","scope":"from/spynetwork","value":true}]]},{"key":"preftl_operation.3055.c","label":{"zh":"大出血的价格，但是我们会出这个钱。","en":"A steep price, but we will pay."},"responses":[],"tooltips":[{"zh":"我们将指派特工对此人进行全时监控，确保整个过程的隐秘性。\n这会对我们的渗透速度产生负面效应。","en":"Operatives will be assigned to monitor this individual at all times, ensuring complete secrecy.\nThis will negatively impact our Infiltration Speed."}],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/first_contact_dlc_operations_events.txt","line":2877},"names":{"from.target.GetSpeciesAdj":{"zh":"该族","en":"the species'"},"from.target.GetSpeciesName":{"zh":"该物种","en":"the species"},"from.owner.GetName":{"zh":"该帝国","en":"that empire"}}},{"id":"preftl.10150","kind":"event","title":{"zh":"违反不予干涉法案","en":"Breach of Non-Interference Act"},"texts":[{"zh":"[global_event_country.GetGalCommunityOrGalImperium]的官员收到消息称我们干涉[pre_ftl_country.GetName]自然发展。他们告知我们这毫无疑问违反了不予干涉法案，无论我们的本意如何。\n\n[Root.GetName]在接下来的十年内将会被视为违反星系法。此外，我们还应缴纳巨额罚金。","en":"Officials from the [global_event_country.GetGalCommunityOrGalImperium] have received word of our interference in the natural development of the [pre_ftl_country.GetName]. They have informed us that this is a clear violation of the Non-Interference Act, regardless of our intentions.\n\nThe [Root.GetName] will be considered in Breach of Galactic Law for the next ten years. In addition, we have been issued with a hefty fine."}],"sections":[],"image":"art/bbeb0b25427a11373bc7.webp","hidden":false,"choices":[{"key":"CURSES","label":{"zh":"可恶！","en":"Curses!"},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/first_contact_dlc_situation_events.txt","line":7921},"names":{"Root.GetName":{"zh":"我们的帝国","en":"our empire"},"pre_ftl_country.GetName":{"zh":"该帝国","en":"that empire"}},"alsoIn":["event-preftl-operation-1000","event-preftl-operation-1060","event-preftl-operation-3060"]},{"id":"preftl.10050","kind":"event","title":{"zh":"违反平等相待法案","en":"Breach of Equal Standing Act"},"texts":[{"zh":"[global_event_country.GetGalCommunityOrGalImperium]的官员们裁定，无论我们的用意为何，我们与[pre_ftl_country.GetName]的协议已经违反了平等相待法案。\n\n[Root.GetName]在接下来的十年内将会被视为违反星系法。此外，我们还应缴纳巨额罚金。","en":"Officials from the [global_event_country.GetGalCommunityOrGalImperium] have determined that our treatment of the [pre_ftl_country.GetName] is in violation of the Equal Standing Act, regardless of our intentions.\n\nThe [Root.GetName] will be considered in Breach of Galactic Law for the next ten years. In addition, we have been issued with a hefty fine."}],"sections":[],"image":"art/bbeb0b25427a11373bc7.webp","hidden":false,"choices":[{"key":"CURSES","label":{"zh":"可恶！","en":"Curses!"},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/first_contact_dlc_situation_events.txt","line":7755},"names":{"Root.GetName":{"zh":"我们的帝国","en":"our empire"},"pre_ftl_country.GetName":{"zh":"该帝国","en":"that empire"}},"alsoIn":["event-preftl-operation-1000","event-preftl-operation-1060","event-preftl-operation-3060"]},{"id":"preftl_operation.3051","kind":"event","title":{"zh":"消灭目击者","en":"Witness Eliminated"},"texts":[{"zh":"我们的特工报告，他们成功地消灭了目标：我们最近在[from.target.GetName]入侵的唯一目击者。我们追踪这个人到达某个大型[from.target.GetSpeciesAdj]定居点郊区的一处偏远住所。这位目击者似乎处于极度震惊的状态，没有迹象表明此人与其他[from.target.GetSpeciesNamePlural]进行了接触。我们确信该事件已经得到了控制。","en":"Our operatives report the successful elimination of their target: the sole witness to our recent breach in the [from.target.GetName]. This individual was tracked to a remote dwelling on the outskirts of a major [from.target.GetSpeciesAdj] settlement. The witness appeared to be in an extreme state of shock, and there are no signs they came into contact with other [from.target.GetSpeciesNamePlural]. We are confident that this matter has been contained."}],"sections":[],"image":"art/7cb944903de6eb59be69.webp","hidden":false,"choices":[{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/first_contact_dlc_operations_events.txt","line":2854},"names":{"from.target.GetSpeciesAdj":{"zh":"该族","en":"the species'"},"from.target.GetSpeciesNamePlural":{"zh":"该物种","en":"the species"}}},{"id":"preftl.10155","kind":"event","title":{"zh":"违反不予干涉法案","en":"Breach of Non-Interference Act"},"texts":[{"zh":"我们在[pre_ftl_country.GetName]违反不予干涉法案一事发生后，已经向[global_event_country.GetGalCommunityOrGalImperium]的官员递交了完整报告。希望这种坦白的行为能让检察官对我们有好感，他们或许会对我们的案子从宽处理。","en":"We have submitted a full report to officials at the [global_event_country.GetGalCommunityOrGalImperium], following our violation of the Non-Interference Act in the [pre_ftl_country.GetName]. Hopefully this confessional act of disclosure will endear us to prosecutors, who may in turn consider our case more leniently."}],"sections":[],"image":"art/bbeb0b25427a11373bc7.webp","hidden":false,"choices":[{"key":"UNDERSTOOD","label":{"zh":"明白了。","en":"Understood."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/first_contact_dlc_situation_events.txt","line":7997},"names":{"pre_ftl_country.GetName":{"zh":"该帝国","en":"that empire"}},"alsoIn":["event-preftl-operation-3060"]},{"id":"preftl.10055","kind":"event","title":{"zh":"违反平等相待法案","en":"Breach of Equal Standing Act"},"texts":[{"zh":"由于与[pre_ftl_country.GetName]的协议违反了平等相待法案，我们在此后向[global_event_country.GetGalCommunityOrGalImperium]的官员们递交了必要的文书。希望通过承认我们的行动他们可能网开一面。\n\n[Root.GetName]在接下来的五年内将会被视为违反星系法。此外，我们还应缴纳巨额罚金。","en":"Following our violation of the Equal Standing Act due to our treatment of the [pre_ftl_country.GetName], we have submitted the requisite paperwork to the officials of the [global_event_country.GetGalCommunityOrGalImperium]. Hopefully, by admitting our actions they will be more tolerant.\n\nThe [Root.GetName] will be considered in Breach of Galactic Law for the next five years. In addition, we have been issued with a hefty fine."}],"sections":[],"image":"art/bbeb0b25427a11373bc7.webp","hidden":false,"choices":[{"key":"UNDERSTOOD","label":{"zh":"明白了。","en":"Understood."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/first_contact_dlc_situation_events.txt","line":7798},"names":{"Root.GetName":{"zh":"我们的帝国","en":"our empire"},"pre_ftl_country.GetName":{"zh":"该帝国","en":"that empire"}},"alsoIn":["event-preftl-operation-3060"]}]}