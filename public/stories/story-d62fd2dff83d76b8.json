{"story":{"id":"story-d62fd2dff83d76b8","title":{"zh":"银河之星","en":"The Galatron"},"category":"stories","image":"art/b7ef4b47c87fbcb9cdc6.webp","start":"cara.970","chapters":1,"nodes":1,"visible":true,"excerpt":{"zh":"生活与其说是一场竞赛，不如说是碰运气。","en":"Life is more of a lottery than a competition."},"navigation":{"order":["cara.970"],"tree":[{"id":"cara.970","parent":null,"depth":0,"kind":"reading","label":{"zh":"","en":""}}],"links":[]}},"chapters":[{"id":"cara.970","title":{"zh":"银河之星","en":"The Galatron"},"texts":[{"zh":"生活与其说是一场竞赛，不如说是碰运气。","en":"Life is more of a lottery than a competition."},{"zh":"塞翁失马，焉知非福。","en":"Sometimes buckets weigh more than they have to."},{"zh":"彼之砒霜，他之蜜糖","en":"One sapient's garbage is another sapient's treasure."},{"zh":"不良能量币信贷总是会出现。","en":"A bad energy credit always turns up."},{"zh":"闪光的未必都是暗物质。","en":"All that glitters is not dark matter."},{"zh":"乞丐可不应该挑肥拣瘦。","en":"Beggars can't be choosers."},{"zh":"不要苛求别人送来的泽珞是否纯净。","en":"Never look a gift Zarkaluvian in the buccal cavity."},{"zh":"等价交换绝非强夺。","en":"Fair exchange is no robbery."},{"zh":"为溅出的泽珞哭泣是没有用的。","en":"It's no use crying over spilt Zro."},{"zh":"让惩罚与罪行相称。","en":"Let the punishment fit the crime."},{"zh":"种瓜得瓜，种豆得豆。","en":"You reap what you sow."}],"variants":true,"sections":[],"image":"art/b7ef4b47c87fbcb9cdc6.webp","hidden":false,"choices":[{"label":{"zh":"真是太诡异了。","en":"Most peculiar."},"conditional":false,"next":[]}],"next":[],"readings":[{"label":{"zh":"读法 1","en":"Reading 1"},"textIndices":[0],"choiceIndices":[0]},{"label":{"zh":"读法 2","en":"Reading 2"},"textIndices":[1],"choiceIndices":[0]},{"label":{"zh":"读法 3","en":"Reading 3"},"textIndices":[2],"choiceIndices":[0]},{"label":{"zh":"读法 4","en":"Reading 4"},"textIndices":[3],"choiceIndices":[0]},{"label":{"zh":"读法 5","en":"Reading 5"},"textIndices":[4],"choiceIndices":[0]},{"label":{"zh":"读法 6","en":"Reading 6"},"textIndices":[5],"choiceIndices":[0]},{"label":{"zh":"读法 7","en":"Reading 7"},"textIndices":[6],"choiceIndices"