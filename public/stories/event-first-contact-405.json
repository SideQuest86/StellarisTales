 our mettle in their view, and convinced them that we are worthy partners on the galactic stage."}],"sections":[],"image":"art/b61641c89734c5beff64.webp","hidden":false,"choices":[{"key":"first_contact.406.A","label":{"zh":"一段美好友谊的开始。","en":"The beginnings of a beautiful friendship..."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"galactic_features.387","kind":"option","conditional":true,"delayed":false,"sourceKind":"option","group":"c12782","when":[[[{"type":"other","key":"is_country_type","arg":"default","scope":"contact_country","value":false}],[{"type":"other","key":"has_first_contact_flag","arg":"hostile_first_contact_attempted","scope":"","value":true}]],[[{"type":"flag","scope":"country","name":"tiyanki_graveyard_survey","path":"","value":true}]]],"source":"common/scripted_effects/first_contact_effects.txt:178","story":"event-galactic-features-387"},{"target":"cara.1020","kind":"option","conditional":true,"delayed":false,"sourceKind":"option","group":"c12782","when":[[[{"type":"other","key":"is_country_type","arg":"default","scope":"contact_country","value":false}],[{"type":"other","key":"has_first_contact_flag","arg":"hostile_first_contact_attempted","scope":"","value":true}]],[[{"type":"other","key":"any_country","arg":"{…}","scope":"","value":true}]],[[{"type":"other","key":"exists","arg":"event_target:caravaneer_fleet1_country","scope":"","value":true},{"type":"other","key":"is_same_value","arg":"event_target:caravaneer_fleet1_country","scope":"","value":true}]]],"source":"common/scripted_effects/first_contact_effects.txt:437","story":"event-cara-1020"},{"target":"cara.2020","kind":"option","conditional":true,"delayed":false,"sourceKind":"option","group":"c12782","when":[[[{"type":"other","key":"is_country_type","arg":"default","scope":"contact_country","value":false}],[{"type":"other","key":"has_first_contact_flag","arg":"hostile_first_contact_attempted","scope":"","value":true}]],[[{"type":"other","key":"any_country","arg":"{…}","