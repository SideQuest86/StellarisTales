onditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29573","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:37","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"federations2.701","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29573","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:51","hooks":["on_roll_failed"],"story":"event-federations2-701"},{"target":"ancrel.4078","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0018,"group":"r29573","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:64","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.13030","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29573","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:71","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4006","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29573","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:90","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4021","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29573","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:104","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"story.5","kind":"delay","conditional":false,"delayed":true,"sourceKind":"delay","delay":[{"days":"30"}],"source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt:336","story":"origin_fear_of_the_dark"}],"source":{"file":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","line":315}},{"id":"ancrel.6200","kind":"event","title":{"zh":"享乐之宫","en":"Pleasure Palace"},"texts":[{"zh":"空间站内部黑暗无光、了无生命的现状几乎成功掩盖了它曾经被设计为某种奢华的享乐宫殿的事实。这里有看起来数不清的一列列生锈的老虎机，数百间破旧不堪的酒馆和餐厅，其中到处横陈着共计数千具尸体。\n\n这些随处可见的部分木乃伊化的外星人尸体属于至少十几个不同的物种，但大部分尸体都聚集在几个空的逃生舱停放港附近。","en":"The present dark and lifeless interior of the space station almost succeeds in hiding the fact that it must have been designed as some kind of luxurious pleasure palace. There are seemingly endless rows of rusty slot machines, hundreds of decrepit bars and restaurants, and amidst it all, thousands of bodies.\n\nDead, partially mummified aliens of at least a dozen different species can be found everywhere, but most of the bodies are clustered around the empty escape pod bays."}],"sections":[],"image":"art/b7fd0fe9e7cc889bebb5.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.6205","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-star-petal"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1497}},{"id":"ancrel.6205","kind":"event","title":{"zh":"星辰花瓣","en":"The Star Petal"},"texts":[{"zh":"在将近一千年以前，这个废弃的空间站曾经被称作“星辰花瓣”并似乎是闻名于星系一角的奢华度假胜地。每年都会有一小队拖船将此空间站牵引到未曾去过的异国他乡，而[From.Planet.GetName]看起来是其最后停留的位置。\n\n由于尚不清楚的原因，这个空间站被拖进了这个气态巨行星的大气层并在此遭受了严重损坏。","en":"This derelict station was once known as the \"Star Petal\" and it was apparently a celebrated luxury resort in this corner of the galaxy nearly a thousand years ago. A small fleet of tugs would drag the station to a new exotic location each year, but [From.Planet.GetName] appears to have been its last.\n\nFor unclear reasons, the station was pulled into the gas giant's atmosphere where it suffered critical damage."}],"sections":[],"image":"art/872246aedc238ff28ba5.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.6210","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-star-petal"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1523},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"ancrel.6210","kind":"event","title":{"zh":"最后时日","en":"The Final Days"},"texts":[{"zh":"在“星辰花瓣”工作的考古学家收集到了足够的线索和证据，可以为这个空间站的最后时日描述出一副相当清晰的图景。一颗离群小行星撞上了这个空间站，使其航线偏离，很快就会沉入[From.Planet.GetName]的大气层。\n\n空间站的轨道控制推进器无法使其回归正确航线，指挥人员立即下令进行疏散。不幸的是，空间站上的逃生舱仅够很小一部分乘员撤离，由此引发了集体恐慌。那些没有被踩踏至死者在空间站坠入气态巨行星深处时由于环境维持系统失效而丧生。","en":"The archaeologists working on the Star Petal have gathered sufficient clues and evidence to paint a reasonably clear picture of the station's final days. A stray asteroid impacted the station, knocking it into an orbit that would soon plunge it into [From.Planet.GetName]'s atmosphere.\n\nStation-keeping thrusters could not compensate, and the command staff soon issued an evacuation order. Unfortunately, the station only had enough escape pods to evacuate a fraction of its passengers and mass panic soon erupted. Those who were not trampled to death perished when the station's environmental systems failed as it drifted deeper into the gas giant."}],"sections":[],"image":"art/b7fd0fe9e7cc889bebb5.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.6215","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-site-star-petal"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1549},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"ancrel.6215","kind":"event","title":{"zh":"脉动之心","en":"The Heart of the Pulsar"},"texts":[{"zh":"在“星辰花瓣”最富有的主顾们存储其个人物品的设有安保的咖啡厅里搜索时，我们找到了一座装有奇异文物和珠宝的宝库。在找到的物品中最值得注意的或许是“脉动之心”——一串独一无二的钻石项链，在当年极为有名，至少被五个国家的首脑戴过。","en":"Rummaging through the secure safes where the Star Petal's wealthiest clientèle stored their personal belongings has revealed a treasure trove of strange artifacts and jewelry. Perhaps the most noteworthy among the found items is the \"Heart of the Pulsar\" - a unique diamond necklace quite famous in its day for having been worn by five different heads of state."}],"sections":[],"image":"art/7455fb245eff77f8b3dd.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":1575}}]}