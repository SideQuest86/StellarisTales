,"arg":"tech_lasers_1","scope":"","value":false,"label":{"zh":"红激光发射器","en":"Red Lasers"}}],[{"type":"other","key":"has_technology","arg":"tech_lasers_2","scope":"","value":false,"label":{"zh":"蓝激光发射器","en":"Blue Lasers"}}],[{"type":"other","key":"has_technology","arg":"tech_lasers_3","scope":"","value":false,"label":{"zh":"紫外激光发射器","en":"UV Lasers"}}],[{"type":"other","key":"has_technology","arg":"tech_lasers_4","scope":"","value":false,"label":{"zh":"X射线发射器","en":"X-Ray Lasers"}}],[{"type":"other","key":"has_technology","arg":"tech_lasers_5","scope":"","value":false,"label":{"zh":"伽马激光","en":"Gamma Lasers"}}]]},{"pieces":[{"text":1}],"when":[[{"type":"other","key":"has_technology","arg":"tech_ship_armor_1","scope":"","value":true,"label":{"zh":"纳米复合材料","en":"Nanocomposite Materials"}},{"type":"other","key":"has_technology","arg":"tech_ship_armor_2","scope":"","value":true,"label":{"zh":"瓷金复合材料","en":"Ceramo-Metal Materials"}},{"type":"other","key":"has_technology","arg":"tech_ship_armor_3","scope":"","value":true,"label":{"zh":"塑钢材料","en":"Plasteel Materials"}},{"type":"other","key":"has_technology","arg":"tech_ship_armor_4","scope":"","value":true,"label":{"zh":"耐钢材料","en":"Durasteel Materials"}},{"type":"other","key":"has_technology","arg":"tech_ship_armor_5","scope":"","value":true,"label":{"zh":"零素材料","en":"Neutronium Materials"}},{"type":"other","key":"has_technology","arg":"tech_lasers_1","scope":"","value":true,"label":{"zh":"红激光发射器","en":"Red Lasers"}},{"type":"other","key":"has_technology","arg":"tech_lasers_2","scope":"","value":true,"label":{"zh":"蓝激光发射器","en":"Blue Lasers"}},{"type":"other","key":"has_technology","arg":"tech_lasers_3","scope":"","value":true,"label":{"zh":"紫外激光发射器","en":"UV Lasers"}},{"type":"other","key":"has_technology","arg":"tech_lasers_4","scope":"","value":true,"label":{"zh":"X射线发射器","en":"X-Ray Lasers"}},{"type":"other","key":"has_technology","arg":"tech_lasers_5","scope":"","value":true,"label":{"zh":"伽马激光","en":"Gamma Lasers"}}]]}],"names":{"science_leader.GetName":{"zh":"这位领袖","en":"the leader"}}},{"id":"distar.2015","kind":"event","title":{"zh":"原始之汤","en":"Primordial Soup"},"texts":[{"zh":"在[From.GetName]的表面上存在着许多单纯有机物质的浆团，我们的科学家认为这可能是生物自生的温床——无机物质天然形成有机物的过程，因[From.GetName]异常浓密的大气层而成为可能。\n\n尽管星球提供了一个研究可能是生命早期起源的独特机会，但我们最好还是不要太过期待，因为如果生命真的会在[From.GetName]上自然出现的话，至少还需要好几百万年。","en":"Nestled in sheltered pockets across [From.GetName]'s surface is a rich sludge of simple organic compounds that our researchers believe could be a hotbed for abiogenesis - the spontaneous formation of organic life from lifeless matter. [From.GetName] has an unusually thick atmosphere for a barren world, which could make it hospitable for simple lifeforms.\n\nAlthough this presents a unique opportunity to study what could be the early stages of the origin of life, it would be best to set our expectations low, as it may still be millions of years before life evolves naturally on [From.GetName], if at all."},{"zh":"在[From.GetName]表面的隐蔽区域内发现了富含小分子有机化合物的淤泥，我们的研究人员认为，这些淤泥可能是生命诞生的温床，可使无生命物质自发形成有机生命。毕竟[From.GetName]的大气对一个荒芜星球而言显得过于厚重了，这可能导致它成为简单生命体的乐园。\n\n当然，这是我们不能容忍的。在生命自发产生之前，我们必须把这富含有机物的粪汤毁掉——即使生命诞生可能尚需数百万年！","en":"Nestled in sheltered pockets across [From.GetName]'s surface is a rich sludge of simple organic compounds that our research drones believe could be a hotbed for abiogenesis - the spontaneous formation of organic life from lifeless matter. [From.GetName] has an unusually thick atmosphere for a barren world, which could make it hospitable for simple lifeforms.\n\nNaturally, this is intolerable to us. We must snuff this cesspool of organic matter out before life has a chance to develop - even if that may lie millions of years in the future!"}],"sections":[],"image":"art/06a548b312f847f58286.webp","hidden":false,"choices":[{"key":"FASCINATING","label":{"zh":"很迷人。","en":"Fascinating."},"responses":[],"tooltips":[],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"civic_machine_terminator","value":false,"label":{"zh":"铁心灭绝者","en":"Determined Exterminator"}},{"type":"identity","key":"origin_evolutionary_predators","value":false,"label":{"zh":"演化猎手","en":"Evolutionary Predators"}}]]},{"key":"distar.2015.A.machine","label":{"zh":"烧了它！","en":"Burn it with fire!"},"responses":[],"tooltips":[],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"auth_machine_intelligence","value":true,"label":{"zh":"机械智能","en":"Machine Intelligence"}},{"type":"identity","key":"civic_machine_servitor","value":false,"label":{"zh":"失控机仆","en":"Rogue Servitor"}}]]},{"key":"distar.2015.b.evopred","label":{"zh":"[owner.GetHomeWorldName]也是这么形成的吗？","en":"Is this how [owner.GetHomeWorldName] formed?"},"responses":[],"tooltips":[],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"origin_evolutionary_predators","value":true,"label":{"zh":"演化猎手","en":"Evolutionary Predators"}}]]}],"next":[],"source":{"file":"events/distant_stars_events_2.txt","line":3588},"body":[{"pieces":[{"text":0}],"when":[[{"type":"identity","key":"civic_machine_terminator","value":false,"label":{"zh":"铁心灭绝者","en":"Determined Exterminator"}}]]},{"pieces":[{"text":1}],"when":[[{"type":"identity","key":"civic_machine_terminator","value":true,"label":{"zh":"铁心灭绝者","en":"Determined Exterminator"}}]]}],"names":{"From.GetName":{"zh":"这颗星球","en":"this planet"},"owner.GetHomeWorldName":{"zh":"母星","en":"the homeworld"}}}]}