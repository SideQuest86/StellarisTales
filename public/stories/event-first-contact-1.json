:"event_target:caravaneer_fleet3_country","scope":"","value":true},{"type":"other","key":"is_same_value","arg":"event_target:caravaneer_fleet3_country","scope":"","value":true},{"type":"other","key":"is_same_value","arg":"event_target:caravaneer_fleet1_country","scope":"","value":false},{"type":"other","key":"is_same_value","arg":"event_target:caravaneer_fleet2_country","scope":"","value":false}]]],"source":"common/scripted_effects/first_contact_effects.txt:128","story":"event-cara-3020"}],"terminal":false}],"next":[],"source":{"file":"events/first_contact_events.txt","line":11193},"body":[{"pieces":[{"text":0}],"when":[[{"type":"identity","key":"ethic_gestalt_consciousness","value":false,"label":{"zh":"格式塔意识","en":"Gestalt Consciousness"}}]]},{"pieces":[{"text":1}],"when":[[{"type":"identity","key":"auth_hive_mind","value":true,"label":{"zh":"蜂巢思维","en":"Hive Mind"}}]]},{"pieces":[{"text":2}],"when":[[{"type":"identity","key":"auth_machine_intelligence","value":true,"label":{"zh":"机械智能","en":"Machine Intelligence"}}]]}],"names":{"needed_name.GetSheHe":{"zh":"此人","en":"they"},"This.Owner.Species.GetName":{"zh":"该物种","en":"the species"}}},{"id":"first_contact.3000","kind":"event","title":{"zh":"来客","en":"The Guest"},"texts":[{"zh":"如楼房大小、长着许多触手的怪物突然出现在[This.Owner.Capital.GetName]让首都失去了秩序。这个生物对于它自己的突然出现似乎和我们一样困惑，毫无抵抗地就被我们捕获拘束了起来。\n\n我们怀疑该生物应该来自外太空，但无法排除是一种本就在我们星球上的未知物种的可能性。无论如何，轨道上确实没有发现任何外星舰船。这个代号来客的生物的凭空出现，似乎也不是借助的科技手段。\n\n令人困惑（同时它自己也充满困惑）的客人目前被收容在一座研究设施中。","en":"The appearance of a building-sized, tentacled monstrosity in the midst of [This.Owner.Capital.GetName] has thrown the capital into disarray. The creature seems as perplexed as we are by its sudden appearance, and has allowed itself to be restrained without resistance.\n\nWe suspect the creature to be of alien nature, but we can't discount the possibility of it being an unknown species native to our world. After all, no alien ship has been detected in orbit. The creature - codenamed The Guest - materialized out of nowhere, seemingly unassisted by technology.\n\nOur confusing (and confused) visitor is currently being held in one of our research facilities."},{"zh":"如楼房大小、长着许多触手的怪物突然出现在[This.Owner.Capital.GetName]让首都陷入了一片混乱。这只生物似乎和我们一样困惑于它自己的突然出现，毫无抵抗地就被我们捕获拘束了起来。\n\n许多[owner.GetScientistPlural]宣称，代号来客的这个生物是来自外太空，而其他人则认为这是一种此前尚未发现的物种直至今日才得以为人所知。无论如何，轨道上确实没有发现任何外星舰船。这个生物的凭空出现，似乎也不是借助的科技手段。\n\n令人困惑（同时它自己也充满困惑）的客人目前被收容在一座研究设施中。","en":"The appearance of a building-sized, tentacled monstrosity in the midst of [This.Owner.Capital.GetName] has thrown the capital into chaos. The creature seems as confused as we are by its sudden appearance, and has allowed itself to be restrained without resistance.\n\nWhile many [owner.GetScientistPlural] already claim the creature, codenamed The Guest, to be of alien nature, others have suggested it could be a previously unknown species which had until now gone undiscovered. After all, no alien ship has been detected in orbit. The creature materialized out of nowhere, seemingly unassisted by technology.\n\nOur confusing (and confused) visitor is currently being held in one of our research facilities."}],"sections":[],"image":"art/1d32ec9e4fd15a0cdff0.webp","hidden":false,"choices":[{"key":"first_contact.3000.a.friendly","label":{"zh":"我们必须与该生物交流！","en":"We must talk to this creature!"},"responses":[],"tooltips":[],"conditional":true,"next":[{"target":"leviathans.98","kind":"option","conditional":true,"delayed":true,"sourceKind":"option","group":"c13643","delay":[{"days":"720","random":"360"}],"when":[[[{"type":"other","key":"is_country_type","arg":"default","scope":"contact_country","value":false}],[{"type":"other","key":"has_origin","arg":"origin_slavers","scope":"contact_country","value":false,"label":{"zh":"通天之梯","en":"Your Ladder To The Sky"}},{"type":"other","key":"is_country_type","arg":"default","scope":"contact_country","value":false}],[{"type":"other","key":"has_slave_origin","arg":"yes","scope":"root.owner","value":false},{"type":"ot