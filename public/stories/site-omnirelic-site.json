","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29525","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:26","hooks":["on_roll_failed"],"story":"event-ancrel-8065"},{"target":"ancrel.8070","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29525","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:29","hooks":["on_roll_failed"],"story":"event-ancrel-8070"},{"target":"ancrel.8075","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0007,"group":"r29525","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:35","hooks":["on_roll_failed"],"story":"event-ancrel-8075"},{"target":"ancrel.8080","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29525","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:36","hooks":["on_roll_failed"],"story":"event-ancrel-8080"},{"target":"ancrel.8110","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29525","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:37","hooks":["on_roll_failed"],"story":"event-ancrel-8110"},{"target":"federations2.701","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29525","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:51","hooks":["on_roll_failed"],"story":"event-federations2-701"},{"target":"ancrel.4078","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0018,"group":"r29525","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:64","hooks":["on_roll_failed"],"story":"event-ancrel-4078"},{"target":"ancrel.13030","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29525","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:71","hooks":["on_roll_failed"],"story":"event-ancrel-13030"},{"target":"ancrel.4006","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29525","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:90","hooks":["on_roll_failed"],"story":"event-ancrel-4006"},{"target":"ancrel.4021","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29525","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:104","hooks":["on_roll_failed"],"story":"event-ancrel-4021"},{"target":"story.5","kind":"delay","conditional":false,"delayed":true,"sourceKind":"delay","delay":[{"days":"30"}],"source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt:21","story":"origin_fear_of_the_dark"}],"source":{"file":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","line":8}},{"id":"ancrel.21","kind":"event","title":{"zh":"废弃星球","en":"Ruined World"},"texts":[{"zh":"大量年久失修的建筑结构覆盖在整颗星球的表面。想必这里一度人口数以亿计，但现在却空无一人。不论谁在这里生活过，他们都一定留下了发生事情的线索，但要找到这些线索需要对行星表面进行仔细检查。","en":"Massive, dilapidated structures cover the entire surface of this world. At one time, this city-planet must have been home to billions - but now it is empty. Whoever lived here must have left clues about what happened to them, but finding them will require a detailed examination of the surface."}],"sections":[],"image":"art/cf07b456d476deb5e6a0.webp","hidden":false,"choices":[{"key":"ancrel.4000.a","label":{"zh":"有趣，开始发掘！","en":"Intriguing. Start digging!"},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.22","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-omnirelic-site"}],"source":{"file":"events/ancient_relics_arcsite_events_1.txt","line":583}},{"id":"ancrel.22","kind":"event","title":{"zh":"废弃星球","en":"Ruined World"},"texts":[{"zh":"对废墟的搜索绝大多数毫无成效，好在尚有一些线索指出了我们要搜寻的正确方向：我们发现了一处似乎是某种行星级数据处理和存储中心的地方。如果我们可以找到一种获取其中档案的方法，将会对解读这颗行星神秘过往起到不可估量的巨大作用。","en":"After much fruitless sifting through the ruins, a number of clues directed our search towards remains of a kind of planetary data processing- and storage center. If we can find a way to gain access to whatever records remain, they will be invaluable for unraveling this planet's mysterious past."}],"sections":[],"image":"art/cf07b456d476deb5e6a0.webp","hidden":false,"choices":[{"key":"ancrel.9.a","label":{"zh":"继续搜索","en":"Continue searching."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.23","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-omnirelic-site"}],"source":{"file":"events/ancient_relics_arcsite_events_1.txt","line":601}},{"id":"ancrel.23","kind":"event","title":{"zh":"废弃星球","en":"Ruined World"},"texts":[{"zh":"在找到数据中心的入口并打通穿越废墟的道路后，重新激活和接入计算机系统出人意料的容易。自修复电路和学习算法很快上线以恢复受限的功能并开始与我们的计算机进行通讯。\n\n事情的原因很快变得明了，[From.Planet.GetName]曾一度是一个被称为“有机全典”的机械帝国的首都。因其致力的目的而得名，此帝国由机器人和义体人混合组成，曾试图获取星系中一切有机生命的样本，以便防止这些生命在未知的星系级灾难中灭绝。\n\n从现存记录中，我们搜集到的信息表明这一目的在他们年代的其他星系势力中并不受欢迎，他们最终被多个势力的联合攻击打败和毁灭。\n\n然而，在该帝国覆灭前，他们已经取样了许多种族，并投入了大量精力研发出一台可以在有需要时重新创造出这些种族的装置进行。这一装置，即有机全典本身，被保存在附近某处。","en":"Once we found an entrance to the data center and forced passage through the wreckage, it was a surprisingly easy task to reactivate- and interface with the computer systems. Self-repairing circuits and learning algorithms quickly came online to restore limited functionality, and communicate with our own computers.\n\nThe cause for this burst of activity quickly became clear: [From.Planet.GetName] was once the capital of a machine empire known as \"The Omnicodex.\" Named for their driving purpose, the Omni were a hybrid of robots and cyborgs who had attempted to assimilate samples of all biological life in the galaxy, in order to prevent their extinction in the face of unknown galactic calamity.\n\nFrom the records which survive, we gather that this course of action was not popular amongst the other galactic powers of their era; the Omni were eventually defeated in a joint campaign conducted by several of these empires.\n\nBefore their downfall, the Omni managed to sample a great deal of races, and much work was put into developing a device capable of re-creating them if the need should ever arise. This device - The Omnicodex proper - is apparently stored somewhere nearby."}],"sections":[],"image":"art/6129284c73583be006a9.webp","hidden":false,"choices":[{"key":"ancrel.9.a","label":{"zh":"继续搜索","en":"Continue searching."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.24","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"site-omnirelic-site"}],"source":{"file":"events/ancient_relics_arcsite_events_1.txt","line":638},"names":{"From.Planet.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"ancrel.24","kind":"event","title":{"zh":"废弃星球","en":"Ruined World"},"texts":[{"zh":"我们已经找到了有机全典。这件独特的装置内含建造其的机械帝国曾取样的每个物种的基因序列，并可以以基本元素作为原料重新创造出他们。不幸的是，看起来此机械帝国在覆灭前并没有足够的时间来完善这台装置，所以我们无法选择在激活该装置时要创造哪一个被取样的种族。","en":"The Omnicodex has been unearthed. This unique device contains the genetic sequence of every race that the Omni were able to sample, and can re-create them using only basic elements as raw materials. Unfortunately, it seems the Omni did not have time to perfect it before meeting their annihilation, so there is no means of selecting which of the many sampled races would be created in any given activation of the device."}],"sections":[],"image":"art/da16f4709ed6d556eed9.webp","hidden":false,"choices":[{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_1.txt","line":656}}]}