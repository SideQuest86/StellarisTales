{"story":{"id":"site-omnirelic-site","title":{"zh":"废弃星球","en":"Ruined World"},"category":"precursors","kind":"site","image":"art/cf07b456d476deb5e6a0.webp","start":"archaeological_site_types:omnirelic_site","chapters":5,"visible":true,"excerpt":{"zh":"整个行星都被巨大的建筑物所覆盖着，这个遗落的大都会星肯定有秘密等待发掘。","en":"An entire planet covered in vast structures, this fallen megalopolis surely has secrets to be unearthed."},"tree":{"root":"n0","nodes":{"n0":{"doc":null,"children":["n1"]},"n1":{"doc":"archaeological_site_types:omnirelic_site","parent":"n0","via":{"kind":"entry","triggers":[{"zh":"星系生成","en":"Galaxy generation"}]},"children":["n2"]},"n2":{"doc":"ancrel.21","parent":"n1","via":{"hooks":["stage:","stage_event"],"kind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt:27"},"children":["n3"]},"n3":{"doc":"ancrel.22","parent":"n2","via":{"kind":"stage","hooks":["stage"],"source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt"},"children":["n4"]},"n4":{"doc":"ancrel.23","parent":"n3","via":{"kind":"stage","hooks":["stage"],"source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt"},"children":["n5"]},"n5":{"doc":"ancrel.24","parent":"n4","via":{"kind":"stage","hooks":["stage"],"source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt"},"children":[]}}}},"chapters":[{"id":"archaeological_site_types:omnirelic_site","kind":"site","title":{"zh":"废弃星球","en":"Ruined World"},"texts":[{"zh":"整个行星都被巨大的建筑物所覆盖着，这个遗落的大都会星肯定有秘密等待发掘。","en":"An entire planet covered in vast structures, this fallen megalopolis surely has secrets to be unearthed."}],"sections":[{"zh":"整个行星都被巨大的建筑物所覆盖着，这个遗落的大都会星肯定有秘密等待发掘。","en":"An entire planet covered in vast structures, this fallen megalopolis surely has secrets to be unearthed."}],"image":"art/cf07b456d476deb5e6a0.webp","hidden":false,"choices":[],"next":[{"target":"ancrel.21","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeologic