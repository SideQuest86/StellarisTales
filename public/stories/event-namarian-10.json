ural]."},"when":[[{"type":"identity","key":"ethic_egalitarian","value":true,"label":{"zh":"平等主义","en":"Egalitarian"}}]]},{"label":{"zh":"这次会面真的是上天的赐福。","en":"This meeting is surely a blessing."},"when":[[{"type":"identity","key":"ethic_spiritualist","value":true,"label":{"zh":"唯心主义","en":"Spiritualist"}},{"type":"other","key":"is_machine_empire","arg":"no","scope":"event_target:contact_empire","value":false}]]},{"label":{"zh":"合作共赢对我们都有益处。","en":"Co-operation will surely benefit us all."},"when":[[{"type":"identity","key":"ethic_materialist","value":true,"label":{"zh":"唯物主义","en":"Materialist"}}]]},{"label":{"zh":"爱是友谊产生的旋律，[contact_speaker.GetSpeciesNamePlural]！","en":"Love is friendship set to music, [contact_speaker.GetSpeciesNamePlural]!"},"when":[[{"type":"identity","key":"ethic_xenophile","value":true,"label":{"zh":"亲外主义","en":"Xenophile"}}]]},{"label":{"zh":"我们可以相互学习共同进步，[contact_speaker.GetSpeciesNamePlural]。","en":"We could learn much from each other, [contact_speaker.GetSpeciesNamePlural]."},"when":[[{"type":"identity","key":"ethic_xenophile","value":true,"label":{"zh":"亲外主义","en":"Xenophile"}},{"type":"identity","key":"ethic_egalitarian","value":true,"label":{"zh":"平等主义","en":"Egalitarian"}}]]},{"label":{"zh":"如果同心协力我们便可成就伟业，[contact_speaker.GetSpeciesNamePlural]！","en":"Together we can achieve greatness, [contact_speaker.GetSpeciesNamePlural]!"},"when":[[{"type":"identity","key":"ethic_xenophile","value":true,"label":{"zh":"亲外主义","en":"Xenophile"}},{"type":"identity","key":"ethic_authoritarian","value":true,"label":{"zh":"威权主义","en":"Authoritarian"}}]]},{"label":{"zh":"作为一起探索宇宙的伙伴，我们向你们表示致敬。","en":"As fellow star explorers, we salute you."},"when":[[{"type":"identity","key":"ethic_xenophile","value":true,"label":{"zh":"亲外主义","en":"Xenophile"}}],[{"type":"identity","key":"ethic_militarist","value":true,"label":{"zh":"军国主义","en":"Militarist"}}]]},{"label":{"zh":"向同为星际旅者朋友的你们表示问候。","en":"We greet you as equals and friends, star travelers."},"when":[[{"type"