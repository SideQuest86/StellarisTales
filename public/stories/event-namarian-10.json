_devouring_swarm","value":false,"label":{"zh":"噬杀蜂群","en":"Devouring Swarm"}}]]},{"label":{"zh":"启动问候协议。","en":"Initiate friendly greeting protocol."},"when":[[{"type":"identity","key":"auth_machine_intelligence","value":true,"label":{"zh":"机械智能","en":"Machine Intelligence"}},{"type":"identity","key":"civic_machine_terminator","value":false,"label":{"zh":"铁心灭绝者","en":"Determined Exterminator"}}]]},{"label":{"zh":"目标判定为非有机体。停止行动。","en":"Target identified as non-organic. Standing down."},"when":[[{"type":"identity","key":"civic_machine_terminator","value":true,"label":{"zh":"铁心灭绝者","en":"Determined Exterminator"}},{"type":"other","key":"is_machine_empire","arg":"yes","scope":"event_target:contact_empire","value":true}]]},{"label":{"zh":"上天赐福此次会谈！","en":"Praise the divine for this meeting!"},"when":[[{"type":"identity","key":"ethic_spiritualist","value":true,"label":{"zh":"唯心主义","en":"Spiritualist"}},{"type":"other","key":"is_machine_empire","arg":"no","scope":"event_target:contact_empire","value":false}]]},{"label":{"zh":"我方全体公民向你们问好。","en":"Our citizens greet you in peace."},"when":[[{"type":"identity","key":"ethic_pacifist","value":true,"label":{"zh":"和平主义","en":"Pacifist"}}]]},{"label":{"zh":"欢迎你，以及你奇异的亲族。","en":"Greetings to you, and your odd kin."},"when":[[{"type":"identity","key":"ethic_xenophobe","value":true,"label":{"zh":"排外主义","en":"Xenophobe"}}]]}]},{"key":"action.1.ac","label":{"zh":"别指望得到我们的善待！","en":"We do not take kindly to your sort!"},"responses":[],"tooltips":[{"zh":"[contact_empire.GetName]对我们的外交策略毫不关心。","en":"The [contact_empire.GetName] care little for our diplomatic maneuvering."},{"zh":"我们要设法与[contact_empire.GetName]保持距离，他们在我们这的间谍网增长-33%。","en":"We shall seek to distance ourselves from the [contact_empire.GetName], giving them -33% Spy Network growth on us."}],"conditional":false,"next":[],"terminal":false,"labels":[{"label":{"zh":"别指望得到我们的善待！","en":"We do not take kindly to your sort!"},"when":[[{"type":"identity","key":"ethic_xenophobe","valu