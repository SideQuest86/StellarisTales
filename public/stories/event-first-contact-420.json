5"},{"target":"first_contact.1110","kind":"option","conditional":true,"delayed":true,"sourceKind":"option","group":"c12899","delay":[{"days":"30","random":"5"}],"when":[[[{"type":"other","key":"exists","arg":"reverse_first_contact","scope":"","value":true}]],[[{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_crew","scope":"","value":true},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_no_crew","scope":"","value":false},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_vivisection","scope":"","value":false}],[{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_crew_easy","scope":"","value":true},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_no_crew","scope":"","value":false},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_vivisection","scope":"","value":false}],[{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_crew_hard","scope":"","value":true},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_no_crew","scope":"","value":false},{"type":"other","key":"is_current_first_contact_stage","arg":"default_end_stage_hostile_with_vivisection","scope":"","value":false}]]],"source":"common/scripted_effects/first_contact_effects.txt:45","story":"event-first-contact-1110"}],"terminal":false}],"next":[],"source":{"file":"events/first_contact_events.txt","line":7480},"names":{"This.ContactCountry.GetRealName":{"zh":"这位领袖","en":"the leader"},"This.ContactCountry.GetName":{"zh":"该帝国","en":"that empire"}}},{"id":"special_projects:UNIVERSAL_TRANSLATOR_PROJECT","kind":"project","title":{"zh":"万能翻译器","en":"The Universal Translator"},"texts":[{"zh":"我们的研究人员承诺将利用近来与[contacted_hummers.GetSpeciesNamePlural]的遭遇经历，将作为一个万能的、可即刻将任何给定的语言翻译成我们自己的语言的翻译系统的起点。即使他们最终未能成功，我们也希望他们能够对我们的通讯系统进行显著改进。","en":"Our researchers promise that our recent encounter with the [contacted_hummers.GetSpeciesNamePlural] has given them the beginnings of a translation system able to translate any given language into our own instantly. Even if they fall short of this, it is our hope that they will be able to upgrade our communication systems considerably."}],"sections":[],"image":"art/b9c89635229802fe5b98.webp","hidden":false,"choices":[],"next":[{"target":"first_contact.422","kind":"project","conditional":false,"delayed":false,"sourceKind":"project","source":"common/special_projects/00_projects_nemesis.txt:74","hooks":["on_success"],"story":"event-first-contact-420"}],"source":{"file":"common/special_projects/00_projects_nemesis.txt","line":63},"names":{"contacted_hummers.GetSpeciesNamePlural":{"zh":"该物种","en":"the species"}}},{"id":"first_contact.422","kind":"event","title":{"zh":"万能翻译器","en":"The Universal Translator"},"texts":[{"zh":"所谓“万能翻译器”的原型机已经成功制成。虽然其效果相较于[This.Owner.GetResearchers]所设想的那种能够即时对任何未知语言进行翻译的设备打了折扣，但仍不失为对现有翻译系统的巨大改进。光明的前景，即解除与包括[contacted_hummers.GetName]在内的任何接触到的外星人的交流障碍，已摆在眼前。","en":"Prototyping of the so-called \"universal translator\" has finished in success. Although the results fall short of the boldest promises of our [This.Owner.GetResearchers] of a device capable of instantly translating even unknown languages, it is a massive improvement over existing translation systems. Already, there are promises of vast boons as barriers to communication with the [contacted_hummers.GetName] and other alien acquaintances are lifted."}],"sections":[],"image":"art/9ff9150221c27e4aaa09.webp","hidden":false,"choices":[{"key":"first_contact.422.A","label":{"zh":"迟早会派上用场的。","en":"This will come in useful."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/first_contact_events.txt","line":7516}}]}