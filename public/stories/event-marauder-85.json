amePlural":{"zh":"该物种","en":"the species"},"marauder_mercenary_country.GetSpeciesName":{"zh":"该物种","en":"the species"}}},{"id":"observer.25","kind":"event","title":{"zh":"[marauder_mercenary_country.GetSpeciesName]雇佣兵","en":"[marauder_mercenary_country.GetSpeciesName] Mercenaries"},"texts":[{"zh":"[marauder_mercenary_country.GetSpeciesName]现在有雇佣兵可供雇佣。","en":"[marauder_mercenary_country.GetSpeciesName] mercenaries are now available for hire."}],"sections":[],"image":"art/459a906190885dc05d26.webp","hidden":false,"choices":[{"key":"OK","label":{"zh":"确认","en":"OK"},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/observer_events.txt","line":478},"names":{"marauder_mercenary_country.GetSpeciesName":{"zh":"该物种","en":"the species"}}},{"id":"marauder.87","kind":"event","title":{"zh":"[encountered_marauder.GetName]","en":"[encountered_marauder.GetName]"},"texts":[{"zh":"嗨咿咿嘢嘢嘢！！！听好了，泥蛮们！\n\n我们的战士们由于闲的实在无聊，已经开始内斗了，死伤无数！不过我们有办法解决……我们决定派我们最厉害的战士们去为泥蛮效命，当然你们必须支付能源！如果你们想要宇宙中最强的佣兵部队支援你们，就赶快行动吧！","en":"HYEEEIIIEEEEEE!!!! Attention, dwamaks!\n\nOur warriors grow bored and cause much trouble! Much fighting with each other, many dead! But we have solution... we send our craziest warriors to fight for dwamaks, in exchange for credits! If you want best mercenaries in galaxy, hurry now before too late!"}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"marauder.86.a","label":{"zh":"谢谢告知。","en":"Good to know."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/marauder_events.txt","line":4226}},{"id":"observer.26","kind":"event","title":{"zh":"[marauder_mercenary_country.GetSpeciesName]雇佣兵","en":"[marauder_mercenary_country.GetSpeciesName] Mercenaries"},"texts":[{"zh":"[marauder_mercenary_country.GetSpeciesName]现在有雇佣兵可供雇佣。","en":"[marauder_mercenary_country.GetSpeciesName] mercenaries are now available for hire."}],"sections":[],"image":"art/459a906190885dc05d26.webp","hidden":false,"choices":[{"key":"OK","label":{"zh":"确认","en":"OK"},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/observer_events.txt","line":493},"names":{"marauder_mercenary_country.GetSpeciesName":{"zh":"该物种","en":"the species"}}},{"id":"marauder.88","kind":"event","title":{"zh":"[encountered_marauder.GetName]","en":"[encountered_marauder.GetName]"},"texts":[{"zh":"全知全能的虚空之母有一条消息给你：\n\n虚空之母已然知晓你所渴望之物，你现在可以雇佣一些我们的佣兵舰队。我们的船员皆为训练有素之士，若能够提供足够的报酬，他们皆会服从于你的命令。\n\n这是一份难以置信的礼物，请不要浪费她的一番好意。","en":"She of the Void has a message for you:\n\nIf you so desire, you may now hire some of our fleets as mercenaries. Our crews are disciplined and will obey your instructions, as long as you can meet our prices.\n\nThis is an incredible gift that She has bestowed upon you. Do not squander it."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"marauder.86.a","label":{"zh":"谢谢告知。","en":"Good to know."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/marauder_events.txt","line":4256}}]}