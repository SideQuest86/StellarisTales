,"choices":[{"key":"country.53.a","label":{"zh":"我们会收集到这些样本的。","en":"We will gather these specimens."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"event_chains:specimen_procurement_chain","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/country_events_1.txt:1660","story":"event-country-53"},{"target":"special_projects:TARBLAC_PROCUREMENT","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/country_events_1.txt:1687","story":"event-country-53"},{"target":"special_projects:TASSARGOID_PROCUREMENT","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/country_events_1.txt:1714","story":"event-country-53"},{"target":"special_projects:ORINTHI_PROCUREMENT","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/country_events_1.txt:1741","story":"event-country-53"},{"target":"special_projects:SNIRAN_PROCUREMENT","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/country_events_1.txt:1768","story":"event-country-53"},{"target":"special_projects:GOOLANTHA_PROCUREMENT","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/country_events_1.txt:1795","story":"event-country-53"},{"target":"special_projects:UDDLORAN_PROCUREMENT","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/country_events_1.txt:1822","story":"event-country-53"},{"target":"special_projects:ZULCOR_PROCUREMENT","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/country_events_1.txt:1849","story":"event-country-53"}],"terminal":false},{"key":"country.53.b","label":{"zh":"不，我们没有可调用的资源。","en":"No, we don't have the resources to spare."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"event_chains:specimen_procurement_chain","kind":"sequence","conditional":false,"delayed":false,"sourceKind":"sequence","source":"events/country_events_1.txt:1651","hooks":["immediate"],"story":"event-country-53"}],"source":{"file":"events/country_events_1.txt","line":1478},"names":{"Root.Capital.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"event_chains:specimen_procurement_chain","kind":"chain","title":{"zh":"外星生物收集","en":"Alien Organism Procurement"},"texts":[{"zh":"[Root.Capital.GetName]的外太空生物博物馆发来请求，他们想请求帮助收集在各颗星球上鉴别出的一些稀有外星生命体。","en":"The Museum of Exobiology on [Root.Capital.GetName] has asked for help in the collection of several rare alien life forms that have been identified on various different worlds."}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[],"next":[],"source":{"file":"common/event_chains/00_event_chains.txt","line":146},"names":{"Root.Capital.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"special_projects:TARBLAC_PROCUREMENT","kind":"project","title":{"zh":"幻影般的塔布拉克","en":"The Elusive Tarblac"},"texts":[{"zh":"在海洋星球[This.GetName]的海面下发现了塔布拉克。","en":"Tarblacs are found deep beneath the waves on the ocean world [This.GetName]."}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[],"next":[{"target":"country.54","kind":"project","conditional":false,"delayed":false,"sourceKind":"project","source":"common/special_projects/00_projects_1.txt:2530","hooks":["on_success"],"story":"event-country-53"}],"source":{"file":"common/special_projects/00_projects_1.txt","line":2513}},{"id":"country.54","kind":"event","title":{"zh":"已捕获塔布拉克","en":"Tarblac Secured"},"texts":[{"zh":"在使用一支微型潜艇舰队对[From.From.GetName]海底进行大规模搜查之后，[Root.GetName]的船员终于把神出鬼没的搜查对象逼到了角落里——一个活着的塔布拉克。\n\n塔布拉克通过辐射出微弱的灵能信号来保护自己，这种异能信号可以让大多有机生物感到恐惧。这个发光的生物被装在一个用来模拟它生存环境的特殊水箱当中，并被运到了科学飞船上。直接接触过它的[Root.GetName]船员需要接受长期的治疗，但至少任务已经成功了。","en":"After an extensive search of the seabed on [From.From.GetName] using a small fleet of mini-submarines, the crew of the [Root.GetName] finally managed to corner the elusive target of their search - a live tarblac.\n\nThe shimmering creature, which defends itself by emitting faint psionic signals that produce a sense of dread in most organics, was brought aboard the Science Ship in a special water tank simulating its natural environment. The crew members on the [Root.GetName] that came into direct contact with the tarblac will require extensive therapy, but the mission has been a success."}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"country.61","kind":"option","conditional":true,"delayed":false,"sourceKind":"option","group":"c5070","when":[[[{"type":"other","key":"event_chain","arg":"specimen_procurement_chain","scope":"has_completed_event_chain_counter","value":true},{"type":"other","key":"counter","arg":"specimens_collected","scope":"has_completed_event_chain_counter","value":true},{"type":"flag","scope":"country","name":"specimens_secured","path":"","value":false}]]],"source":"events/country_events_1.txt:1902","story":"event-country-53"}],"terminal":false}],"next":[],"source":{"file":"events/country_events_1.txt","line":1866},"names":{"Root.GetName":{"zh":"这艘舰船","en":"the ship"},"From.From.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"country.61","kind":"event","title":{"zh":"已获取样本","en":"Specimens Secured"},"texts":[{"zh":"外星生物博物馆所要求的全部样本均已获取。博物馆已经扩张为庞然大物，里面的人工重力生成器和大气处理器可以模拟十多个不同世界的环境。\n\n参观者从[Root.GetName]各个地方慕名而来。","en":"All of the specimens asked for by the Museum of Exobiology have been secured. The museum has grown to a massive facility, where artificial gravity generators and atmospheric processors are used to simulate the environments of over a dozen worlds.\n\nVisitors are journeying from all across the [Root.GetName] to see its wonders!"}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/country_events_1.txt","line":2188},"sets":["specimens_secured"],"names":{"Root.GetName":{"zh":"我们的帝国","en":"our empire"}}},{"id":"special_projects:TASSARGOID_PROCUREMENT","kind":"project","title":{"zh":"强大的塔萨古德","en":"The Mighty Tassargoid"},"texts":[{"zh":"[This.GetName]潮湿的丛林中出现过塔萨古德的身影。","en":"Tassargoids have been sighted in the humid jungles of [This.GetName]."}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[],"next":[{"target":"country.55","kind":"project","conditional":false,"delayed":false,"sourceKind":"project","source":"common/special_projects/00_projects_1.txt:2555","hooks":["on_success"],"story":"event-country-53"}],"source":{"file":"common/special_projects/00_projects_1.txt","line":2538}},{"id":"country.55","kind":"event","title":{"zh":"已捕获塔萨古德","en":"Tassargoid Secured"},"texts":[{"zh":"塔萨古德是一种十分致命的捕食者。每当夜晚降临，他们便蛰伏在[From.From.GetName]的密林之中，用电击来麻痹他们的猎物，接着便用吸管一样的嘴部吸食猎物的大脑。\n\n不幸的是，三个[Root.GetName]船员连一个塔萨古德的样本都没有捕获到就被它们给消灭了。为了表彰这些勇敢的船员，[Root.Owner.Capital.GetName]的外星生物博物馆会用他们的名字来重新命名建筑的一翼。","en":"The tassargoid is an extremely lethal predator that stalks the dense jungles of [From.From.GetName] at night, paralyzing its prey with electric shocks before sucking their brains out with its tube-like mouth.\n\nUnfortunately, three of the crew members from the [Root.GetName] were lost to these creatures before a specimen could be secured. The Museum of Exobiology on [Root.Owner.Capital.GetName] will rename one of its wings after these brave officers to honor their sacrifice."}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"country.61","kind":"option","conditional":true,"delayed":false,"sourceKind":"option","group":"c5071","when":[[[{"type":"other","key":"event_chain","arg":"specimen_procurement_chain","scope":"has_completed_event_chain_counter","value":true},{"type":"other","key":"counter","arg":"specimens_collected","scope":"has_completed_event_chain_counter","value":true},{"type":"flag","scope":"country","name":"specimens_secured","path":"","value":false}]]],"source":"events/country_events_1.txt:1944","story":"event-country-53"}],"terminal":false}],"next":[],"source":{"file":"events/country_events_1.txt","line":1910},"names":{"Root.Owner.Capital.GetName":{"zh":"这颗星球","en":"this planet"},"Root.GetName":{"zh":"这艘舰船","en":"the ship"},"From.From.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"special_projects:ORINTHI_PROCUREMENT","kind":"project","title":{"zh":"卑鄙的欧林提","en":"The Vile Orinthi"},"texts":[{"zh":"欧林提在[This.GetName]各地大规模存在。","en":"Orinthi have been reported in large numbers across most of [This.GetName]."}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[],"next":[{"target":"country.56","kind":"project","conditional":false,"delayed":false,"sourceKind":"project","source":"common/special_projects/00_projects_1.txt:2580","hooks":["on_success"],"story":"event-country-53"}],"source":{"file":"common/special_projects/00_projects_1.txt","line":2563}},{"id":"country.56","kind":"event","title":{"zh":"已捕获欧林提","en":"Orinthi Secured"},"texts":[{"zh":"欧林提是一种[From.From.GetName]当地的小型啮齿类生物，他们的居住站已经蔓延到[From.From.GetPlanetMoon]大部分的地区。他们以惊人的速率繁殖后代，而且它们似乎有啃食电缆的癖好。\n\n收集欧琳提的样本并不麻烦。事实上，在完成首批收集之后，更多的欧琳提通过搭乘科学飞船的轨道穿梭机偷渡到了[Root.GetName]。至于为何宇宙生物博物馆会要欧琳提这种样本，其原因还是个谜。","en":"The small, rodent-like creatures known as orinthi are native to [From.From.GetName], where their habitat extends across most of the [From.From.GetPlanetMoon]'s diverse climatic regions. They breed at an extremely rapid rate, and seem to have a particular fondness for chewing on electric cables.\n\nProcuring specimens was not a problem - in fact, after the initial creatures were collected, more of them made their way onto the [Root.GetName] by hitching rides on the Science Ship's orbital shuttles. Exactly why the Museum of Exobiology requested orinthi specimens remains a mystery."}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"country.61","kind":"option","conditional":true,"delayed":false,"sourceKind":"option","group":"c5072","when":[[[{"type":"other","key":"event_chain","arg":"specimen_procurement_chain","scope":"has_completed_event_chain_counter","value":true},{"type":"other","key":"counter","arg":"specimens_collected","scope":"has_completed_event_chain_counter","value":true},{"type":"flag","scope":"country","name":"specimens_secured","path":"","value":false}]]],"source":"events/country_events_1.txt:1986","story":"event-country-53"}],"terminal":false}],"next":[],"source":{"file":"events/country_events_1.txt","line":1952},"names":{"Root.GetName":{"zh":"这艘舰船","en":"the ship"},"From.From.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"special_projects:SNIRAN_PROCUREMENT","kind":"project","title":{"zh":"阴险的萨尼兰","en":"The Insidious Sniran"},"texts":[{"zh":"萨尼兰只存在于[This.GetName]的沙海中。","en":"Snirans are unique to the great dune seas of [This.GetName]."}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[],"next":[{"target":"country.57","kind":"project","conditional":false,"delayed":false,"sourceKind":"project","source":"common/special_projects/00_projects_1.txt:2605","hooks":["on_success"],"story":"event-country-53"}],"source":{"file":"common/special_projects/00_projects_1.txt","line":2588}},{"id":"country.57","kind":"event","title":{"zh":"已捕获萨尼兰","en":"Sniran Secured"},"texts":[{"zh":"萨尼兰是大型穴居类动物，它们生活在[From.From.GetName]赤道沙漠中的沙丘底下。当这些捕食者觉察到有东西在它们上方的沙子上移动时，它们立马会竖起背部的几十个钉刺来刺穿它们的猎物。\n\n起初，找一个萨尼兰的样本很困难。后来几百架可以远程控制的追踪型无人机被派遣到了沙漠里的各个位置，总算发现并收集到了一个背上长了超过一百根钉刺的巨大标本。","en":"Snirans are large, burrowing creatures that live beneath the dunes of the vast equatorial deserts on [From.From.GetName]. When these predators sense movement in the sand above, they immediately raise dozens of tall spikes from their backs in the hope of impaling something edible.\n\nFinding a suitable specimen proved difficult at first, until hundreds of tracked remote-controlled drones were dispatched across the desert in random directions. This led to the discovery and procurement of an unusually large specimen that had grown more than a hundred spikes on its back."}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"country.61","kind":"option","conditional":true,"delayed":false,"sourceKind":"option","group":"c5073","when":[[[{"type":"other","key":"event_chain","arg":"specimen_procurement_chain","scope":"has_completed_event_chain_counter","value":true},{"type":"other","key":"counter","arg":"specimens_collected","scope":"has_completed_event_chain_counter","value":true},{"type":"flag","scope":"country","name":"specimens_secured","path":"","value":false}]]],"source":"events/country_events_1.txt:2038","story":"event-country-53"}],"terminal":false}],"next":[],"source":{"file":"events/country_events_1.txt","line":2002},"names":{"From.From.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"special_projects:GOOLANTHA_PROCUREMENT","kind":"project","title":{"zh":"坚韧的古兰萨","en":"The Malleable Goolantha"},"texts":[{"zh":"古兰萨兽群可能只存在于[This.GetName]的开阔草原上。","en":"Goolantha herds may only be found on the open steppes of [This.GetName]."}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[],"next":[{"target":"country.58","kind":"project","conditional":false,"delayed":false,"sourceKind":"project","source":"common/special_projects/00_projects_1.txt:2630","hooks":["on_success"],"story":"event-country-53"}],"source":{"file":"common/special_projects/00_projects_1.txt","line":2613}},{"id":"country.58","kind":"event","title":{"zh":"已捕获古兰萨兽群","en":"Goolantha Herd Secured"},"texts":[{"zh":"古兰萨是一种巨大、扁平的食草动物，它们体内有气囊，这使得它们能悬浮在离地表几厘米的地方。它们总是成群结队地行动，在[From.From.GetName]多风的平原上吃苔藓和地衣。古兰萨正在被[From.From.GetPlanetMoon]的顶端捕食者无情地猎杀。我们[Root.GetName]上的生物学家预计，只有大约百来群的古兰萨还活着。这当中的一群——由九头古兰萨组成，已经被成功地收集并被带回了[Root.Owner.Capital.GetName]。","en":"Goolanthas are large, flat herbivores that have evolved internal gas pockets, enabling them to hover a few centimeters above the ground. They move about in herds consisting of a few dozen animals, grazing on the moss and lichen that can be found on the windswept plains of [From.From.GetName].\n\nThey are ruthlessly hunted by the [From.From.GetPlanetMoon]'s apex predators, and our biologists on the [Root.GetName] estimate that only a few hundred goolantha herds remain. One of these, consisting of nine animals, has been successfully collected and will be brought back to [Root.Owner.Capital.GetName]."}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"country.61","kind":"option","conditional":true,"delayed":false,"sourceKind":"option","group":"c5074","when":[[[{"type":"other","key":"event_chain","arg":"specimen_procurement_chain","scope":"has_completed_event_chain_counter","value":true},{"type":"other","key":"counter","arg":"specimens_collected","scope":"has_completed_event_chain_counter","value":true},{"type":"flag","scope":"country","name":"specimens_secured","path":"","value":false}]]],"source":"events/country_events_1.txt:2080","story":"event-country-53"}],"terminal":false}],"next":[],"source":{"file":"events/country_events_1.txt","line":2046},"names":{"Root.Owner.Capital.GetName":{"zh":"这颗星球","en":"this planet"},"Root.GetName":{"zh":"这艘舰船","en":"the ship"},"From.From.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"special_projects:UDDLORAN_PROCUREMENT","kind":"project","title":{"zh":"狡猾的乌杜兰","en":"The Wily Uddloran"},"texts":[{"zh":"乌杜兰的踪迹只出现在[This.GetName]被雪覆盖的荒地上。","en":"Uddlorans can be found racing through the snowy wastes of [This.GetName]."}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[],"next":[{"target":"country.59","kind":"project","conditional":false,"delayed":false,"sourceKind":"project","source":"common/special_projects/00_projects_1.txt:2655","hooks":["on_success"],"story":"event-country-53"}],"source":{"file":"common/special_projects/00_projects_1.txt","line":2638}},{"id":"country.59","kind":"event","title":{"zh":"已捕获乌杜兰","en":"Uddlorans Secured"},"texts":[{"zh":"[Root.GetName]的船员成功地在[From.From.GetName]的冰层上收集到了一小群的乌杜兰。这些毛茸茸的白色杂食动物把自己滚成一个球，以惊人的速度滚过[From.From.GetPlanetMoon]的雪原——经测量，其中一只的速度竟达到了80公里每小时。我们之所以能侦测到它们是因为它们所到之处都会扬起阵阵飞雪。","en":"The crew of the [Root.GetName] has managed to collect a small group of uddlorans from the icy surface of [From.From.GetName]. These white, furry omnivores wrap themselves into tight balls and roll across the [From.From.GetPlanetMoon]'s snow fields at astonishing speeds - one animal was clocked at over 80 kilometers per hour. This aided in their detection, since the passage of their rolling forms kicks up huge plumes of swirling snow."}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"country.61","kind":"option","conditional":true,"delayed":false,"sourceKind":"option","group":"c5075","when":[[[{"type":"other","key":"event_chain","arg":"specimen_procurement_chain","scope":"has_completed_event_chain_counter","value":true},{"type":"other","key":"counter","arg":"specimens_collected","scope":"has_completed_event_chain_counter","value":true},{"type":"flag","scope":"country","name":"specimens_secured","path":"","value":false}]]],"source":"events/country_events_1.txt:2122","story":"event-country-53"}],"terminal":false}],"next":[],"source":{"file":"events/country_events_1.txt","line":2088},"names":{"Root.GetName":{"zh":"这艘舰船","en":"the ship"},"From.From.GetName":{"zh":"这颗星球","en":"this planet"}}},{"id":"special_projects:ZULCOR_PROCUREMENT","kind":"project","title":{"zh":"贪婪的祖卡","en":"The Ravenous Zulcor"},"texts":[{"zh":"祖卡虫群是[This.GetName]干燥峡谷的原住民。","en":"Zulcor swarms are native to the dry canyons of [This.GetName]."}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[],"next":[{"target":"country.60","kind":"project","conditional":false,"delayed":false,"sourceKind":"project","source":"common/special_projects/00_projects_1.txt:2680","hooks":["on_success"],"story":"event-country-53"}],"source":{"file":"common/special_projects/00_projects_1.txt","line":2663}},{"id":"country.60","kind":"event","title":{"zh":"已捕获祖卡虫族","en":"Zulcor Swarm Secured"},"texts":[{"zh":"祖卡是群居的虫类生物，它们体型巨大，且以地里的岩石和矿物等无机物为食，这两个特点都足够让人瞠目结舌。一艘[Root.GetName]的穿梭机遭受重大损伤。当时该穿梭机只是不经意间经过了一群祖卡身边，却招致祖卡聚集而来蚕食舰体。\n\n在[Root.Owner.Capital.GetName]的外星生物博物馆已经开始建造关住这种生物的特制容器。","en":"The zulcor are swarming insect analogues, unusual both for their large size and the fact that they are lithovores, feeding off rocks and minerals in the ground. One of the shuttles belonging to the [Root.GetName] sustained serious damage when it inadvertently passed through a large swarm and several zulcors began to feed on its hull.\n\nThe construction of the special containment facilities required to hold these creatures has already begun at the Museum of Exobiology on [Root.Owner.Capital.GetName]."}],"sections":[],"image":"art/8d5475edf8f6f84b714c.webp","hidden":false,"choices":[{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"country.61","kind":"option","conditional":true,"delayed":false,"sourceKind":"option","group":"c5076","when":[[[{"type":"other","key":"event_chain","arg":"specimen_procurement_chain","scope":"has_completed_event_chain_counter","value":true},{"type":"other","key":"counter","arg":"specimens_collected","scope":"has_completed_event_chain_counter","value":true},{"type":"flag","scope":"country","name":"specimens_secured","path":"","value":false}]]],"source":"events/country_events_1.txt:2172","story":"event-country-53"}],"terminal":false}],"next":[],"source":{"file":"events/country_events_1.txt","line":2138},"names":{"Root.Owner.Capital.GetName":{"zh":"这颗星球","en":"this planet"},"Root.GetName":{"zh":"这艘舰船","en":"the ship"}}}]}