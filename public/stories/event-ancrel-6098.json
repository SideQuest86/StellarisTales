":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8040","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29549","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:16","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8045","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29549","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:17","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8050","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29549","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:18","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8055","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29549","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:19","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8060","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29549","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:20","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8065","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29549","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:26","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8070","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29549","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:29","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8075","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0007,"group":"r29549","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:35","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8080","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29549","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:36","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.8110","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29549","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:37","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"federations2.701","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29549","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:51","hooks":["on_roll_failed"],"story":"event-federations2-701"},{"target":"ancrel.4078","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0018,"group":"r29549","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:64","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.13030","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0035,"group":"r29549","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:71","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4006","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29549","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:90","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"ancrel.4021","kind":"failure","conditional":true,"delayed":false,"sourceKind":"failure","chance":0.0071,"group":"r29549","modified":true,"source":"common/scripted_effects/archaeology_event_effects.txt:104","hooks":["on_roll_failed"],"story":"archaeology-incidents"},{"target":"story.5","kind":"delay","conditional":false,"delayed":true,"sourceKind":"delay","delay":[{"days":"30"}],"source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt:180","story":"origin_fear_of_the_dark"}],"source":{"file":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","line":164}},{"id":"ancrel.6100","kind":"event","title":{"zh":"陵墓","en":"The Mausoleum"},"texts":[{"zh":"这座建筑看起来似乎是一座巨大的陵墓或者坟场，其建造时间可以追溯到几十万年前。这里没有曾遭劫掠的迹象，所以这座建筑或许在这处隐形场启动后就一直保持着原状。\n\n建筑的前厅是开放的，但一扇紧闭的大门阻挡了我们进一步的考古进程。在门上方的墙壁上以大字刻着尚未破译的外星符号。","en":"The structure appears to be a gigantic mausoleum or necropolis, dating back around a hundred thousand years. There are no signs of previous looters, so the structure may have been untouched since the chameleon field was erected.\n\nThe structure's First Chamber is accessible, but an impenetrable door blocks any further progress. Large alien glyphs, untranslated, have been carved into the wall above the door."}],"sections":[],"image":"art/579f16ac11828e9a5ab1.webp","hidden":false,"choices":[{"key":"FASCINATING","label":{"zh":"很迷人。","en":"Fascinating."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.6105","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"event-ancrel-6098"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":760}},{"id":"ancrel.6105","kind":"event","title":{"zh":"前厅","en":"The First Chamber"},"texts":[{"zh":"刻在大门上方的外星符号翻译如下：\n\n“我是扎克兰，MOZ-TARB的守护者，ZVA的大先知，塞塔娜的终结者。我放弃了一切来拯救这个充满怨恨和仇恨的星系。如果你们有这个资格，那就继续前进吧。”\n\n在细细梳理过前厅以搜寻有价值的东西后，考古学家们在墙壁上发现了一块被隐藏起来的微小嵌板。当按下嵌板时，那扇大门缓缓打开，次厅显露在我们眼前。","en":"The alien glyphs above the door have been translated as follows:\n\n\"I am ZARQLAN, the Guardian of MOZ-TARB, the Prophet of ZVA, he who felled CETANA. I gave up everything to save a galaxy awash with spite and hatred. Proceed, if ye be worthy.\"\n\nAfter combing through the First Chamber for anything of interest, archaeologists discovered a tiny concealed wall panel. When pressed, the ancient door rumbled open. The Second Chamber can now be accessed."}],"sections":[],"image":"art/579f16ac11828e9a5ab1.webp","hidden":false,"choices":[{"key":"INTRIGUING","label":{"zh":"有意思。","en":"Intriguing."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.6110","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"event-ancrel-6098"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":786},"sets":["zarqlan_language_translated"]},{"id":"ancrel.6110","kind":"event","title":{"zh":"进院","en":"The Second Chamber"},"texts":[{"zh":"次厅看上去十分普通，除了在又一扇紧闭的门上方刻着的符号，上面写着：\n\n“渺小的国王以我的名义宣布敕令；帝国为我的荣光发动战争；愚民们用歌唱表达对我的颂扬。而我为他们而牺牲。”\n\n这次我们没有找到什么秘密嵌板来打开通往中堂的通道。","en":"The Second Chamber is unremarkable, aside from another set of alien glyphs above a closed door. They read:\n\n\"Petty kings issued edicts in my name. Empires waged war in my honor. Fools sang my praises. And yet I died for them.\"\n\nNo secret wall panel to access the Third Chamber has yet been found."}],"sections":[],"image":"art/579f16ac11828e9a5ab1.webp","hidden":false,"choices":[{"key":"CURIOUS","label":{"zh":"令人好奇。","en":"Curious."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.6115","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"event-ancrel-6098"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":813}},{"id":"ancrel.6115","kind":"event","title":{"zh":"中堂","en":"The Third Chamber"},"texts":[{"zh":"经过长时间痛苦疲乏的勘察，我们发现了一根藏在地板下面的秘密控制杆，用于打开通往后室的通道。像之前一样，外星符号被刻在另一扇门的上方：\n\n“所有想要利用扎克兰的人必须先找到属于他们的道路。在每个墓室中都有一把隐藏的钥匙，只有找到钥匙才能继续前进。这些挑战的意义很快就会显现。”","en":"After a long and tiring search, a secret lever hidden under the floor was found, which provided access to the Fourth Chamber. As before, alien glyphs adorned the wall above yet another door:\n\n\"Those who wish to parlay with ZARQLAN must first find their way. Each chamber has a hidden key that only the deserving could find. The purpose of these challenges will soon be revealed.\""}],"sections":[],"image":"art/579f16ac11828e9a5ab1.webp","hidden":false,"choices":[{"key":"REMARKABLE","label":{"zh":"干得漂亮。","en":"Remarkable."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.6120","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"event-ancrel-6098"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":839}},{"id":"ancrel.6120","kind":"event","title":{"zh":"后室","en":"The Fourth Chamber"},"texts":[{"zh":"这一次，后室里的控制杆被藏在屋顶。而在下一个房间中有更多的外星符号：\n\n“这里没什么值得学习的。这些挑战也像这些语句一样毫无意义。这是我留下的教训。我是扎克兰，一个无名小卒，不情愿地被历史的潮流裹挟着前行。继续前进吧，你将获得一名忠实的听众，假如你依然认为值得的话。”\n\n看上去再下一个房间就是最后一个墓室了。","en":"This time, the lever was concealed in the roof. The Fifth Chamber has more alien writing:\n\n\"There is nothing to learn here. The challenges are as meaningless as these words. That is my lesson. I am ZARQLAN, the pawn. Swept along by the currents of history. Proceed, and an audience shall be yours, should one still be worthy.\"\n\nThe next chamber is likely to be the last."}],"sections":[],"image":"art/579f16ac11828e9a5ab1.webp","hidden":false,"choices":[{"key":"ASTOUNDING","label":{"zh":"令人震惊。","en":"Astounding."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[{"target":"ancrel.6125","kind":"stage","conditional":false,"delayed":false,"sourceKind":"stage","source":"common/archaeological_site_types/02_ancient_relics_arc_sites.txt","hooks":["stage"],"story":"event-ancrel-6098"}],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":865}},{"id":"ancrel.6125","kind":"event","title":{"zh":"尾室","en":"The Final Chamber"},"texts":[{"zh":"经过紧张的勘察，最后一把“钥匙”被发现是藏在外星符号表面上的一个微小按钮。在尾室中，一个巨大的王座支撑着一个弯曲而静止的人形物体。一阵刺鼻的气味飘来，告诉了我们这具尸体腐烂的状况。几个外星符号写在王座底部：“扎克兰，我们愿为您效劳”\n\n整具尸体由于过度腐烂而无法移动，但考虑到尸体放置于此的年月，其头部被保存的出奇得好。考古学家们不想空手而归，于是便用携带的激光切割器将头部切下带走。","en":"After a grueling search, the last \"key\" was discovered as a minuscule button hidden in one of the carved alien glyphs. In this final chamber, a gigantic throne holds a sizeable humanoid figure's slumped and motionless form. A strong odor hints at the decayed state of the being's body. Some glyphs at the bottom of the throne read: \"ZARQLAN, AT YOUR SERVICE\"\n\nThe body is too far gone to be moved, but the head is surprisingly well-preserved, given its age. Not wanting to leave empty-handed, some archaeologists use a laser cutter to remove the head."}],"sections":[],"image":"art/114a28677a447f6d61c7.webp","hidden":false,"choices":[{"key":"INTRIGUING","label":{"zh":"有意思。","en":"Intriguing."},"responses":[],"tooltips":[],"conditional":false,"next":[{"target":"ancrel.6130","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/ancient_relics_arcsite_events_2.txt:916","story":"event-ancrel-6098"}],"terminal":false},{"key":"ancrel.6125.desc.b.evopred","label":{"zh":"别管什么渎不渎神，我们就要它的基因！","en":"Sacrilege or not, we must have its DNA!"},"responses":[],"tooltips":[],"conditional":true,"next":[{"target":"ancrel.6130","kind":"option","conditional":false,"delayed":false,"sourceKind":"option","source":"events/ancient_relics_arcsite_events_2.txt:931","story":"event-ancrel-6098"}],"terminal":false,"when":[[{"type":"identity","key":"origin_evolutionary_predators","value":true,"label":{"zh":"演化猎手","en":"Evolutionary Predators"}}]]}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":891}},{"id":"ancrel.6130","kind":"event","title":{"zh":"信号传输接入","en":"Incoming Transmission"},"texts":[{"zh":"这……居然是真的。你们找到了传说中扎克兰的墓室。当预言官们告诉我这件事时，我并不相信他们，但现在证据已无可辩驳。我明白，你们已经拿到了大先知的头颅，对吗？\n\n那么，按照预言所说，伟大的扎克兰的选民终于揭晓。如扎克兰所愿，在我们领土附近的任何未定居的圣地都随你们处置。在[spiritualist_fallen_empire.Capital.GetName]上另有许多虔信的朝圣者，他们会因能在你的旗帜下作战而感到极大的荣耀。","en":"It... is true, then. You have found the legendary tomb of Zarqlan. When the Augurs told me, I did not believe them, but the evidence is irrefutable. I understand that you have the Prophet's head in your possession?\n\nThen, as was foretold, great Zarqlan's chosen has finally been revealed. As would have been Zarqlan's wish, any unsettled holy worlds near our space are yours to do with as you wish. There are also many devout pilgrims on [spiritualist_fallen_empire.Capital.GetName] who would be greatly honored to fight under your banner."},{"zh":"这的确是真的；区区一台机器发现了传说中的扎克兰之墓。当虚境灵使把这个消息刚刚传到时，我觉得很难相信。但现在我已经完全接受了你拥有先知头颅的事实。\n\n我们不会质疑伟大的扎克兰的意志。你们是这份庇佑的合法持有者。根据古代经文，在我们的领土附近所有未受侵染的圣地星球都由你们来管理。[spiritualist_fallen_empire.Capital.GetName]上许多虔诚的朝圣者都会乐意为这一神圣的事业而战并以此为荣。","en":"It is indeed true; a mere machine has discovered the legendary tomb of Zarqlan. When the Augurs first relayed this news, I found it hard to believe. But now I understand that you possess the Prophet's head.\n\nWe will not question the will of the great Zarqlan. Your kind is the rightful holder of this blessing. According to the ancient scriptures, any unsettled holy worlds near our territory are yours to manage as you see fit. Many devout pilgrims on [spiritualist_fallen_empire.Capital.GetName] would be greatly honored to fight for this sacred cause."}],"sections":[],"image":null,"hidden":false,"choices":[{"key":"ancrel.6130.a","label":{"zh":"通讯终止。","en":"End transmission."},"responses":[],"tooltips":[],"conditional":false,"next":[],"terminal":false}],"next":[],"source":{"file":"events/ancient_relics_arcsite_events_2.txt","line":938},"body":[{"pieces":[{"text":0}],"when":[[{"type":"identity","key":"is_individual_machine","value":false},{"type":"identity","key":"auth_machine_intelligence","value":false,"label":{"zh":"机械智能","en":"Machine Intelligence"}},{"type":"other","key":"is_synthetic_empire","arg":"yes","scope":"owner","value":false}]]},{"pieces":[{"text":1}],"when":[[{"type":"identity","key":"is_individual_machine","value":true}],[{"type":"identity","key":"auth_machine_intelligence","value":true,"label":{"zh":"机械智能","en":"Machine Intelligence"}}],[{"type":"other","key":"is_synthetic_empire","arg":"yes","scope":"owner","value":true}]]}],"names":{"spiritualist_fallen_empire.Capital.GetName":{"zh":"这颗星球","en":"this planet"}}}]}