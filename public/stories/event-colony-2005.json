":"events/colony_events_2.txt","line":1466},"sets":["colony_submerged_cruiser"]},{"id":"special_projects:ANCIENT_OCEAN_SHIP","kind":"project","title":{"zh":"被淹没的巡洋舰","en":"Submerged Cruiser"},"texts":[{"zh":"一艘外星人的巡洋舰躺在[Root.GetName]的海底。打捞她也许能得到宝贵的技术或资源。","en":"An alien battlecruiser lies beneath the waves of [Root.GetName]. Salvaging it could yield valuable technology or resources."}],"sections":[],"image":"art/756b9c98c33733a17249.webp","hidden":false,"choices":[],"next":[{"target":"colony.2006","kind":"random","conditional":false,"delayed":false,"sourceKind":"random","chance":0.5,"group":"r39903","source":"common/special_projects/00_projects_3.txt:550","hooks":["on_success"],"story":"event-colony-2005"},{"target":"colony.2007","kind":"random","conditional":false,"delayed":false,"sourceKind":"random","chance":0.3,"group":"r39903","source":"common/special_projects/00_projects_3.txt:553","hooks":["on_success"],"story":"event-colony-2005"},{"target":"colony.2008","kind":"random","conditional":true,"delayed":false,"sourceKind":"random","chance":0.2,"group":"r39903","modified":true,"source":"common/special_projects/00_projects_3.txt:560","hooks":["on_success"],"story":"event-colony-2005"}],"source":{"file":"common/special_projects/00_projects_3.txt","line":532}},{"id":"colony.2006","kind":"event","title":{"zh":"特殊项目完成","en":"Special Project Completed"},"texts":[{"zh":"[Root.GetName]的打捞任务顺利进行！沉在海底的远古巡洋舰重新浮出水面，并已修理完毕。真是蔚为大观，通过修理它，我们的工程师学到了其设计背后的秘密。","en":"The salvage mission on [Root.GetName] has succeeded! The ancient cruiser that lay on the bottom of the ocean has been resurfaced and repaired. It is a wondrous sight to behold, and from repairing it our engineers have learnt some of the secrets behind its design."}],"sections":[],"image":"art/4b999fbce293afccb85f.webp","hidden":false,"choices":[{"key":"colony.2006.a.material","label":{"zh":"我们的努力将引领我们向前！","en":"Our efforts pave the way forward!"},"responses":[],"tooltips":[{"zh":"你的帝国获得流水线算法的修正。\n\n获得一艘巡洋舰类型的飞船。","en":"Your Empire gains the Streamlining Algorithms modifier.\n\nGain a Cruiser-class ship."}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"ethic_materialist","value":true,"label":{"zh":"唯物主义","en":"Materialist"}}]]},{"key":"colony.2006.a.phile","label":{"zh":"具有历史意义的一天！","en":"A historic day!"},"responses":[],"tooltips":[{"zh":"你的帝国获得流水线算法的修正。\n\n获得一艘巡洋舰类型的飞船。","en":"Your Empire gains the Streamlining Algorithms modifier.\n\nGain a Cruiser-class ship."}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"ethic_xenophile","value":true,"label":{"zh":"亲外主义","en":"Xenophile"}}]]},{"key":"EXCELLENT","label":{"zh":"棒极了。","en":"Excellent."},"responses":[],"tooltips":[{"zh":"你的帝国获得流水线算法的修正。\n\n获得一艘巡洋舰类型的飞船。","en":"Your Empire gains the Streamlining Algorithms modifier.\n\nGain a Cruiser-class ship."}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"ethic_xenophile","value":false,"label":{"zh":"亲外主义","en":"Xenophile"}},{"type":"identity","key":"ethic_materialist","value":false,"label":{"zh":"唯物主义","en":"Materialist"}}]]}],"next":[],"source":{"file":"events/colony_events_2.txt","line":1680}},{"id":"colony.2007","kind":"event","title":{"zh":"特殊项目完成","en":"Special Project Completed"},"texts":[{"zh":"我们尝试从[Root.GetName]的深海打捞这艘巨型飞船，并对其舰体设计有了一定发现。该船的机动算法很容易改用到我们的硬件上，让我们的飞船更加灵活，更加节能。\n\n可惜的是，该船本身无法抢修了，但我们仍可以从其舰体上回收一些材料。","en":"The attempts to salvage the giant ship that was found in [Root.GetName]'s waters have yielded some insight into the ship's design. The ship's maneuvering algorithms are easily transferable to our own hardware, enabling our fleets to become swifter and more energy efficient.\n\nUnfortunately the ship itself is beyond saving, but its hull will supply us with enough materials to make up for that."}],"sections":[],"image":"art/24791c1b11c285d94402.webp","hidden":false,"choices":[{"key":"colony.2007.a.phobe","label":{"zh":"反正外星飞船是无法和我们的飞船比拟的！","en":"No alien ship would surpass ours anyway!"},"responses":[],"tooltips":[{"zh":"你的帝国获得流水线算法的修正。","en":"Your Empire gains the Streamlining Algorithms modifier."}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"ethic_xenophobe","value":true,"label":{"zh":"排外主义","en":"Xenophobe"}}]]},{"key":"colony.2007.a.phile","label":{"zh":"宇宙中任何种群留下的馈赠都是有价值的！","en":"Any gift from cosmos' children is valuable!"},"responses":[],"tooltips":[{"zh":"你的帝国获得流水线算法的修正。","en":"Your Empire gains the Streamlining Algorithms modifier."}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"ethic_xenophile","value":true,"label":{"zh":"亲外主义","en":"Xenophile"}}],[{"type":"identity","key":"ethic_spiritualist","value":true,"label":{"zh":"唯心主义","en":"Spiritualist"}}]]},{"key":"GOOD","label":{"zh":"好。","en":"Good."},"responses":[],"tooltips":[{"zh":"你的帝国获得流水线算法的修正。","en":"Your Empire gains the Streamlining Algorithms modifier."}],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"ethic_xenophobe","value":false,"label":{"zh":"排外主义","en":"Xenophobe"}},{"type":"identity","key":"ethic_xenophile","value":false,"label":{"zh":"亲外主义","en":"Xenophile"}},{"type":"identity","key":"ethic_spiritualist","value":false,"label":{"zh":"唯心主义","en":"Spiritualist"}}]]}],"next":[],"source":{"file":"events/colony_events_2.txt","line":1834}},{"id":"colony.2008","kind":"event","title":{"zh":"特殊项目失败","en":"Special Project Failed"},"texts":[{"zh":"爆炸声从数里之外都听得清清楚楚，打捞沉船的行动以灾难性失败告终。[Root.GetName]的居民没有受到伤害，但一部分建筑遭到了破坏。\n\n沉船被炸得粉碎，已经无法修理。所幸，我们回收到了许多残片。","en":"The explosion can be heard for miles, as the salvage operation of the submerged cruiser ends in disaster. The people of [Root.GetName] are without harm, yet parts of the settlement are destroyed.\n\nThe ship itself is far beyond repair, ripped apart by the explosion. Luckily, many of the scattered pieces of the hull can be salvaged."}],"sections":[],"image":"art/da6185de228a0b33dc80.webp","hidden":false,"choices":[{"key":"GODDAMNIT","label":{"zh":"该死的神玩意！","en":"The divine be damned!"},"responses":[],"tooltips":[],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"ethic_spiritualist","value":true,"label":{"zh":"唯心主义","en":"Spiritualist"}}]]},{"key":"CURSES","label":{"zh":"可恶！","en":"Curses!"},"responses":[],"tooltips":[],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"ethic_materialist","value":true,"label":{"zh":"唯物主义","en":"Materialist"}}]]},{"key":"UNFORTUNATE","label":{"zh":"真不幸。","en":"Unfortunate."},"responses":[],"tooltips":[],"conditional":true,"next":[],"terminal":false,"when":[[{"type":"identity","key":"ethic_materialist","value":false,"label":{"zh":"唯物主义","en":"Materialist"}},{"type":"identity","key":"ethic_spiritualist","value":false,"label":{"zh":"唯心主义","en":"Spiritualist"}}]]}],"next":[],"source":{"file":"events/colony_events_2.txt","line":1928}}]}